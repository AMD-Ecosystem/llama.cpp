func.def inline @ggml_hrx_mmidw_mma_step(%w_stage: buffer, %x_stage: buffer, %w_local: index, %w_pair: index, %wv0_low: vector<8xf16>, %wv0_high: vector<8xf16>, %wv1_low: vector<8xf16>, %wv1_high: vector<8xf16>, %x_col: index, %x_k_local: index, %x_f16: vector<8xf16>, %frag_col0: index, %frag_row0: index, %cols_live: index, %a0: vector<8xf32>, %a1: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %w_view = buffer.view %w_stage[%c0_offset] : buffer -> view<128x72xf16>
  %x_view = buffer.view %x_stage[%c0_offset] : buffer -> view<32x72xf16>
  %w_k_local0 = index.mul %w_pair, %c16 : index
  %w_k_local0_high = index.add %w_k_local0, %c32 : index
  %w_k_local1 = index.add %w_k_local0, %c8 : index
  %w_k_local1_high = index.add %w_k_local1, %c32 : index
  vector.store %wv0_low, %w_view[%w_local, %w_k_local0] : vector<8xf16>, view<128x72xf16>
  vector.store %wv0_high, %w_view[%w_local, %w_k_local0_high] : vector<8xf16>, view<128x72xf16>
  vector.store %wv1_low, %w_view[%w_local, %w_k_local1] : vector<8xf16>, view<128x72xf16>
  vector.store %wv1_high, %w_view[%w_local, %w_k_local1_high] : vector<8xf16>, view<128x72xf16>
  vector.store %x_f16, %x_view[%x_col, %x_k_local] : vector<8xf16>, view<32x72xf16>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // A subgroup whose 16 columns are all past the listed pairs skips its matrix ops.
  %live = index.cmp ult, %frag_col0, %cols_live : index
  %n0, %n1 = scf.if %live -> (vector<8xf32>, vector<8xf32>) {
    %l0, %l1 = template.apply<@ggml.mma.k64_1x2>(%x_stage, %w_stage, %frag_col0, %frag_row0, %a0, %a1) : (buffer, buffer, index, index, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>)
    scf.yield %l0, %l1 : vector<8xf32>, vector<8xf32>
  } else {
    scf.yield %a0, %a1 : vector<8xf32>, vector<8xf32>
  }
  // The next K step overwrites the stages.
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  func.return %n0, %n1 : vector<8xf32>, vector<8xf32>
}

