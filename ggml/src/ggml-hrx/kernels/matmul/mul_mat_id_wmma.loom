  %n0, %n1 = func.call @ggml_hrx_mmidw_mma_step(%w_stage, %x_stage, %w_local, %w_pair, %wv0_low, %wv0_high, %wv1_low, %wv1_high, %x_col, %x_k_local, %x_f16, %frag_col0, %frag_row0, %cols_live, %a0, %a1) : (buffer, buffer, index, index, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, index, index, vector<8xf16>, index, index, index, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>)
  func.return %n0, %n1 : vector<8xf32>, vector<8xf32>
}

// Q8_0 form of @ggml_hrx_mmidw_k_kq with steps of 4 blocks. K must be a multiple of 128.
func.def inline @ggml_hrx_mmidw_k_q8_0(%weight: buffer, %w_span: index, %w_base: index, %k_size: index, %w_local: index, %w_pair: index, %input: buffer, %x_span: index, %x_col_base: i32, %x_col: index, %x_k_local: index, %w_stage: buffer, %x_stage: buffer, %frag_col0: index, %frag_row0: index, %cols_live: index) -> (vector<8xf32>, vector<8xf32>) {
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %m = index.constant 16 : index
  %init = template.apply<@ggml.mma.zero_acc>() : () -> (vector<8xf32>)
  %r0_first, %r1_first, %r2_first, %r3_first, %r4_first, %r5_first, %r6_first, %r7_first = template.apply<@ggml.q8_0.block128>(%weight, %w_span, %w_base, %c0, %w_pair) : (buffer, index, index, index, index) -> (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>)
  %acc0, %acc1, %r0_last, %r1_last, %r2_last, %r3_last, %r4_last, %r5_last, %r6_last, %r7_last = scf.for %kb = [%c0 to %k_size step %c128](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %r0 = %r0_first : vector<8xi16>, %r1 = %r1_first : vector<8xi16>, %r2 = %r2_first : vector<8xi16>, %r3 = %r3_first : vector<8xi16>, %r4 = %r4_first : vector<8xi16>, %r5 = %r5_first : vector<8xi16>, %r6 = %r6_first : vector<8xi16>, %r7 = %r7_first : vector<8xi16>) -> (vector<8xf32>, vector<8xf32>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>) {
    // Memory waits drain in issue order. The fence keeps the activation loads before the next step loads.
    %xk0 = index.add %kb, %x_k_local : index
    %xk1 = index.add %xk0, %c64 : index
    %x0 = func.call @ggml_hrx_mmidw_load_input(%input, %x_span, %x_col_base, %xk0) : (buffer, index, i32, index) -> (vector<8xf32>)
    %x1 = func.call @ggml_hrx_mmidw_load_input(%input, %x_span, %x_col_base, %xk1) : (buffer, index, i32, index) -> (vector<8xf32>)
    scf.schedule.fence
    %kb_next = index.add %kb, %c128 : index
    %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7 = template.apply<@ggml.q8_0.block128>(%weight, %w_span, %w_base, %kb_next, %w_pair) : (buffer, index, index, index, index) -> (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>)
    %s0a, %s0b = func.call @ggml_hrx_mmidw_q8_0_sub_step(%r0, %r1, %r2, %r3, %x0, %w_stage, %x_stage, %w_local, %w_pair, %x_col, %x_k_local, %frag_col0, %frag_row0, %cols_live, %a0, %a1) : (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xf32>, buffer, buffer, index, index, index, index, index, index, index, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>)
    %s1a, %s1b = func.call @ggml_hrx_mmidw_q8_0_sub_step(%r4, %r5, %r6, %r7, %x1, %w_stage, %x_stage, %w_local, %w_pair, %x_col, %x_k_local, %frag_col0, %frag_row0, %cols_live, %s0a, %s0b) : (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xf32>, buffer, buffer, index, index, index, index, index, index, index, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>)
    scf.yield %s1a, %s1b, %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7 : vector<8xf32>, vector<8xf32>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>
  }
  func.return %acc0, %acc1 : vector<8xf32>, vector<8xf32>
}

func.def inline @ggml_hrx_mmidw_row_groups(%n_rows: index) -> (index, index, index) {
  %c1 = index.constant 1 : index
  %max_groups = config.get @ggml.mul_mat_id.row_groups : index
  %max_groups_m1 = index.sub %max_groups, %c1 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %rows_round = index.add %n_rows, %c127 : index
  %row_tiles = index.div %rows_round, %c128 : index
  %groups = index.min %row_tiles, %max_groups : index
  %tiles_round = index.add %row_tiles, %max_groups_m1 : index
  %tiles_per_group = index.div %tiles_round, %max_groups : index
  func.return %row_tiles, %groups, %tiles_per_group : index, index, index
}

// Each workgroup routes one time for its row group. This keeps the routing cost small when K is short.
// 128 rows for each tile keep the activation reads near the weight reads.
kernel.def target(@ggml_wave32) export("ggml_mul_mat_id_wmma") @ggml_mul_mat_id_wmma(%n_rows: index, %n_expert: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 256 : index
  %row_tiles, %groups, %tiles_per_group = func.call pure @ggml_hrx_mmidw_row_groups(%n_rows) : (index) -> (index, index, index)
  %slots = config.get @ggml.mul_mat_id.chunk_slots : index
  kernel.launch.config workgroups(%groups, %n_expert, %slots) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_expert_in: index, %n_used_in: index, %n_tokens_in: index, %x_ne1_in: index, %w_s1_in: index, %w_s2_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_span_in: index, %ids_s0_in: index, %ids_s1_in: index, %ids_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %ids: buffer, %dst: buffer) {
  // supports_mul_mat_id checks these ranges.
  %k_size = index.assume %k_size_in [range(%k_size_in, 1, 2147483647)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_expert = index.assume %n_expert_in [range(%n_expert_in, 1, 2147483647)] : index
  %n_used = index.assume %n_used_in [range(%n_used_in, 1, 2147483647)] : index
  %n_tokens = index.assume %n_tokens_in [range(%n_tokens_in, 1, 2147483647)] : index
  %x_ne1 = index.assume %x_ne1_in [range(%x_ne1_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_span = index.assume %w_span_in [range(%w_span_in, 1, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %ids_s0 = index.assume %ids_s0_in [range(%ids_s0_in, 0, 2147483647)] : index
  %ids_s1 = index.assume %ids_s1_in [range(%ids_s1_in, 0, 2147483647)] : index
  %ids_span = index.assume %ids_span_in [range(%ids_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat_id.weight_type : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c8 = index.constant 8 : index
  %c10 = index.constant 10 : index
  %c12 = index.constant 12 : index
  %c14 = index.constant 14 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c4096 = index.constant 4096 : index
  %c6 = index.constant 6 : index
  %c0_offset = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %w_stage_bytes = index.constant 18432 : offset
  %x_stage_bytes = index.constant 4608 : offset
  %list_bytes = index.constant 8192 : offset
  %bases_bytes = index.constant 128 : offset
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %s0 = kernel.subgroup.id : index
  %s = index.assume %s0 [range(%s0, 0, 7)] : index
  %lane0 = kernel.subgroup.lane.id : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %row_group = kernel.workgroup.id<x> : index
  %expert = kernel.workgroup.id<y> : index
  %expert_i32 = index.cast %expert : index to i32
  %expert_in = index.cmp ult, %expert, %n_expert : index
  %slot0 = kernel.workgroup.id<z> : index
  %slot = index.assume %slot0 [range(%slot0, 0, 7)] : index
  %chunk_slots = config.get @ggml.mul_mat_id.chunk_slots : index
  %chunk_first = index.mul %slot, %c32 : index
  %chunk_stride = index.mul %chunk_slots, %c32 : index
  %expert0 = index.cmp eq, %expert, %c0 : index
  %slot_first = index.cmp eq, %slot, %c0 : index
  %zeroes_skipped = scalar.andi %expert0, %slot_first : i1
  %weight_noalias, %input_noalias, %ids_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %ids, %dst : buffer, buffer, buffer, buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %x_stage = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer
  %list_stage = buffer.alloca<workgroup> align(16) %list_bytes : buffer
  %x_bases = buffer.alloca<workgroup> align(16) %bases_bytes : buffer
  %d_bases = buffer.alloca<workgroup> align(16) %bases_bytes : buffer
  %list_view = buffer.view %list_stage[%c0_offset] : buffer -> view<4096xi16>
  %x_base_view = buffer.view %x_bases[%c0_offset] : buffer -> view<32xi32>
  %d_base_view = buffer.view %d_bases[%c0_offset] : buffer -> view<32xi32>
  %n_pairs = index.mul %n_used, %n_tokens : index
  %row_tiles, %groups, %tiles_per_group = func.call pure @ggml_hrx_mmidw_row_groups(%n_rows) : (index) -> (index, index, index)
  %tile_begin = index.mul %row_group, %tiles_per_group : index
  %tile_next = index.add %tile_begin, %tiles_per_group : index
  %tile_end = index.min %tile_next, %row_tiles : index
  %group_row_begin = index.mul %tile_begin, %c128 : index
  %group_row_end = index.mul %tile_end, %c128 : index

  %w_local = index.div %t, %c2 : index
  %w_pair = index.rem %t, %c2 : index
  %w_expert = index.mul %expert, %w_s2 : index
  %is_q4k = index.cmp eq, %wtype, %c2 : index
  %is_q5k = index.cmp eq, %wtype, %c5 : index
  %is_kq = scalar.ori %is_q4k, %is_q5k : i1
  %is_q6k = index.cmp eq, %wtype, %c6 : index
  %is_q8_0 = index.cmp eq, %wtype, %c4 : index
  %k_rem128 = index.rem %k_size, %c128 : index
  %k_steps128 = index.cmp eq, %k_rem128, %c0 : index
  %q8_0_steps = scalar.andi %is_q8_0, %k_steps128 : i1

  %x_col = index.div %t, %c8 : index
  %x_part = index.rem %t, %c8 : index
  %x_k_local = index.mul %x_part, %c8 : index

  %frag_row_group = index.rem %s, %c4 : index
  %frag_col_group = index.div %s, %c4 : index
  %frag_row0 = index.mul %frag_row_group, %c32 : index
  %frag_col0 = index.mul %frag_col_group, %c16 : index
  %lane_row = index.rem %lane, %c16 : index
  %lane_col = index.div %lane, %c16 : index
  %out_row_local0 = index.add %frag_row0, %lane_row : index
  %out_col = index.add %frag_col0, %lane_col : index
  %is_base_writer = index.cmp ult, %t, %c32 : index

  %ids_unit = index.cmp eq, %ids_s0, %c1 : index
  %ids_rows = index.cmp eq, %ids_s1, %n_used : index
  %ids_contiguous = scalar.andi %ids_unit, %ids_rows : i1
  %c4_rows = index.constant 4 : index
  %used_rem4 = index.rem %n_used, %c4_rows : index
  %used_rows4 = index.cmp eq, %used_rem4, %c0 : index
  %true_flag = scalar.constant true : i1
  %ids_strided = scalar.xori %ids_contiguous, %true_flag : i1
  %ids_rows4_0 = scalar.andi %ids_unit, %used_rows4 : i1
  %ids_rows4 = scalar.andi %ids_rows4_0, %ids_strided : i1

  scf.if %expert_in {
    scf.for %window = [%c0 to %n_pairs step %c4096] {
      %pair_first_offset = index.mul %t, %c16 : index
      %pair_first = index.add %window, %pair_first_offset : index
      %ids_fast0, %ids16_0 = func.call @ggml_hrx_mmidw_load_ids16(%ids_noalias, %ids_span, %pair_first, %n_pairs, %ids_contiguous) : (buffer, index, index, index, i1) -> (i1, vector<16xi32>)
      %rows_fast, %rows16 = func.call @ggml_hrx_mmidw_load_ids16_rows(%ids_noalias, %ids_span, %pair_first, %n_pairs, %n_used, %ids_s1, %ids_rows4) : (buffer, index, index, index, index, index, i1) -> (i1, vector<16xi32>)
      %ids_fast = scalar.ori %ids_fast0, %rows_fast : i1
      %ids16 = scf.select %ids_contiguous, %ids16_0, %rows16 : vector<16xi32>
      %match_count, %match_mask, %skip_mask = scf.if %ids_fast -> (i32, i32, i32) {
        // The unrolled loop keeps each id extract static.
        %fast_count, %fast_mask, %fast_skip = scf.for %j = [%c0 to %c16 step %c1](%count_acc = %c0_i32 : i32, %mask_acc = %c0_i32 : i32, %skip_acc = %c0_i32 : i32) -> (i32, i32, i32) unroll {
          %fast_id = vector.extract %ids16[%j] : vector<16xi32> -> i32
          %fast_matches = scalar.cmpi eq, %fast_id, %expert_i32 : i32
          %fast_skipped = scalar.cmpi slt, %fast_id, %c0_i32 : i32
          %count_next, %mask_next, %skip_next = func.call @ggml_hrx_mmidw_count(%j, %fast_matches, %fast_skipped, %count_acc, %mask_acc, %skip_acc) : (index, i1, i1, i32, i32, i32) -> (i32, i32, i32)
          scf.yield %count_next, %mask_next, %skip_next : i32, i32, i32
        }
        scf.yield %fast_count, %fast_mask, %fast_skip : i32, i32, i32
      } else {
        %slow_count, %slow_mask, %slow_skip = scf.for %j = [%c0 to %c16 step %c1](%count_acc = %c0_i32 : i32, %mask_acc = %c0_i32 : i32, %skip_acc = %c0_i32 : i32) -> (i32, i32, i32) {
          %pair = index.add %pair_first, %j : index
          %slow_matches, %slow_skipped = func.call @ggml_hrx_mmidw_route(%pair, %n_pairs, %n_used, %ids_s0, %ids_s1, %ids_span, %ids_noalias, %expert_i32) : (index, index, index, index, index, index, buffer, i32) -> (i1, i1)
          %count_next, %mask_next, %skip_next = func.call @ggml_hrx_mmidw_count(%j, %slow_matches, %slow_skipped, %count_acc, %mask_acc, %skip_acc) : (index, i1, i1, i32, i32, i32) -> (i32, i32, i32)
          scf.yield %count_next, %mask_next, %skip_next : i32, i32, i32
        }
        scf.yield %slow_count, %slow_mask, %slow_skip : i32, i32, i32
      }
      // The expert 0 workgroups also write the zero columns of skipped pairs.
      scf.if %zeroes_skipped {
        scf.for %zj = [%c0 to %c16 step %c1] {
          %zj_i32 = index.cast %zj : index to i32
          %skip_shifted = scalar.shrui %skip_mask, %zj_i32 : i32
          %skip_bit = scalar.andi %skip_shifted, %c1_i32 : i32
          %writes_zero = scalar.cmpi ne, %skip_bit, %c0_i32 : i32
          scf.if %writes_zero {
            %zero_pair = index.add %pair_first, %zj : index
            func.call @ggml_hrx_mmidw_zero_column(%dst_noalias, %d_span, %zero_pair, %n_used, %d_s1, %d_s2, %group_row_begin, %group_row_end, %n_rows) : (buffer, index, index, index, index, index, index, index, index)
          }
        }
      }
      %list_begin = kernel.workgroup.scan<addi> %match_count {direction = forward, mode = exclusive} : i32
      %route_total = kernel.workgroup.reduce<addi> %match_count : i32
      %route_count = index.cast %route_total : i32 to index
      %list_end = scf.for %lj = [%c0 to %c16 step %c1](%list_pos = %list_begin : i32) -> (i32) {
        %lj_i32 = index.cast %lj : index to i32
        %mask_shifted = scalar.shrui %match_mask, %lj_i32 : i32
        %mask_bit = scalar.andi %mask_shifted, %c1_i32 : i32
        %listed = scalar.cmpi ne, %mask_bit, %c0_i32 : i32
        scf.if %listed {
      // The list holds pairs relative to the window start (below 4096).
          %list_local = index.add %pair_first_offset, %lj : index
          %local_i32 = index.cast %list_local : index to i32
          %local_i16 = scalar.trunci %local_i32 : i32 to i16
          %list_index = index.cast %list_pos : i32 to index
          %list_off = index.assume %list_index [range(%list_index, 0, 2147483646)] : index
          %list_ok = index.cmp ult, %list_off, %c4096 : index
          scf.if %list_ok {
            view.store %local_i16, %list_view[%list_off] : i16, view<4096xi16>
          }
        }
        %list_next = scalar.addi %list_pos, %mask_bit : i32
        scf.yield %list_next : i32
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

      // The barrier prover keeps the reduced count uniform only in an i32 compare. Thus the chunk loop is a while loop.
      %chunk_end = scf.while(%chunk_arg = %chunk_first : index) -> (index) {
        %chunk_i32 = index.cast %chunk_arg : index to i32
        %more = scalar.cmpi slt, %chunk_i32, %route_total : i32
        scf.condition %more, %chunk_arg : i1, index
      } do(%chunk_in: index) {
        // A window lists at most 4096 pairs.
        %chunk = index.assume %chunk_in [range(%chunk_in, 0, 4064)] : index
        scf.if %is_base_writer {
          %list_i = index.add %chunk, %t : index
          %x_base, %d_base = func.call @ggml_hrx_mmidw_pair_bases(%list_stage, %list_i, %route_count, %window, %n_used, %x_ne1, %x_s1, %x_s2, %d_s1, %d_s2) : (buffer, index, index, index, index, index, index, index, index, index) -> (i32, i32)
          view.store %x_base, %x_base_view[%t] : i32, view<32xi32>
          view.store %d_base, %d_base_view[%t] : i32, view<32xi32>
        }
        kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
        %x_col_base = view.load %x_base_view[%x_col] : view<32xi32> -> i32
        %cols_live = index.sub %route_count, %chunk : index
        scf.for %row_tile = [%tile_begin to %tile_end step %c1] {
          %tile_row0 = index.mul %row_tile, %c128 : index
          %w_row = index.add %tile_row0, %w_local : index
          %w_valid = index.cmp ult, %w_row, %n_rows : index
          %w_offset = index.mul %w_row, %w_s1 : index
          %w_base = index.add %w_expert, %w_offset : index
          %out_row_low = index.add %tile_row0, %out_row_local0 : index
          %out_row_high = index.add %out_row_low, %c16 : index
          %acc0, %acc1 = scf.if %is_kq -> (vector<8xf32>, vector<8xf32>) {
            %kq0, %kq1 = func.call @ggml_hrx_mmidw_k_kq(%is_q5k, %weight_noalias, %w_span, %w_base, %k_size, %w_local, %w_pair, %input_noalias, %x_span, %x_col_base, %x_col, %x_k_local, %w_stage, %x_stage, %frag_col0, %frag_row0, %cols_live) : (i1, buffer, index, index, index, index, index, buffer, index, i32, index, index, buffer, buffer, index, index, index) -> (vector<8xf32>, vector<8xf32>)
