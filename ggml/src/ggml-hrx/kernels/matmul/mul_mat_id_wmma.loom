    %x0, %x1, %x2, %x3 = func.call @ggml_hrx_mmidw_load_input4(%input, %x_span, %x_col_base, %kb, %x_k_local) : (buffer, index, i32, index, index) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
