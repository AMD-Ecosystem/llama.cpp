// Weights and activations are rounded to f16. The sums are in f32.
// The caller makes sure that K is a multiple of 32 and that the input is contiguous along K.
// A negative id zeroes its dst column, like the CPU backend.

config.decl @ggml.mul_mat_id.weight_type : %value: index where [range(%value, 0, 6)]

// Several workgroups share the chunks of one expert and row group.
config.decl @ggml.mul_mat_id.chunk_slots : %value: index where [range(%value, 1, 8)]

// Workgroups that share the row tiles of one expert.
config.decl @ggml.mul_mat_id.row_groups : %value: index where [range(%value, 1, 64)]

target.decl @ggml_wave32

template.decl @ggml.mma.k64_1x2(%x_stage: buffer, %w_stage: buffer, %frag_col0: index, %frag_row0: index, %a0: vector<8xf32>, %a1: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>)

template.decl @ggml.mma.zero_acc() -> (vector<8xf32>)

template.decl @ggml.kq.block(%is_q5k: i1, %weight: buffer, %w_span: index, %row_base: index, %k: index, %h: index) -> (vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>)

template.decl @ggml.kq.decode32_f16(%is_q5k: i1, %header: vector<4xi32>, %high_bits: vector<4xi32>, %codes: vector<4xi32>, %k: index) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)

template.decl @ggml.q6_k.block(%weight: buffer, %w_span: index, %row_base: index, %k: index, %p: index) -> (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>)

template.decl @ggml.q6_k.decode32_f16(%ql_first: vector<8xi16>, %ql_second: vector<8xi16>, %qh: vector<8xi16>, %scales: vector<8xi16>, %tail: vector<8xi16>, %c: index, %p: index) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)

template.decl @ggml.weight.wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>)

template.decl @ggml.q8_0.block128(%weight: buffer, %w_span: index, %row_base: index, %k: index, %p: index) -> (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>)

template.decl @ggml.q8_0.decode32_heads(%codes_low: vector<8xi16>, %head_low: vector<8xi16>, %codes_high: vector<8xi16>, %head_high: vector<8xi16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)

func.decl @ggml_hrx_mm_store(%dst: buffer, %d_span: index, %index: index, %value: f32)

func.def inline @ggml_hrx_mmidw_load_id(%ids: buffer, %ids_span: index, %slot: index, %token: index, %ids_s0: index, %ids_s1: index) -> (i32) {
  %c0_offset = index.constant 0 : offset
  %minus_one = scalar.constant -1 : i32
  %ids_view = buffer.view %ids[%c0_offset] : buffer -> view<[%ids_span]xi32>
  %offset0 = index.mul %slot, %ids_s0 : index
  %offset1 = index.mul %token, %ids_s1 : index
  %index = index.add %offset0, %offset1 : index
  %off = index.assume %index [range(%index, 0, 2147483646)] : index
  %ok = index.cmp ult, %off, %ids_span : index
  %id = scf.if %ok -> (i32) {
    %loaded = view.load %ids_view[%off] : view<[%ids_span]xi32> -> i32
    scf.yield %loaded : i32
  } else {
    scf.yield %minus_one : i32
  }
  func.return %id : i32
}

// The fast path needs contiguous ids and 16 pairs in range. Otherwise the caller reads each id.
func.def inline @ggml_hrx_mmidw_load_ids16(%ids: buffer, %ids_span: index, %pair: index, %n_pairs: index, %contiguous: i1) -> (i1, vector<16xi32>) {
  %c15 = index.constant 15 : index
  %c0_offset = index.constant 0 : offset
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %none = vector.splati -1 : vector<16xi32>
  %ids_view = buffer.view %ids[%c0_offset] : buffer -> view<[%ids_span]xi32>
  %first = index.assume %pair [range(%pair, 0, 2147483630)] : index
  %last0 = index.add %first, %c15 : index
  %last = index.assume %last0 [range(%last0, 0, 2147483646)] : index
  %fast, %values = scf.if %contiguous -> (i1, vector<16xi32>) {
    %in_pairs = index.cmp ult, %last, %n_pairs : index
    %pairs_fast, %pairs_values = scf.if %in_pairs -> (i1, vector<16xi32>) {
      %in_span = index.cmp ult, %last, %ids_span : index
      %span_fast, %span_values = scf.if %in_span -> (i1, vector<16xi32>) {
        %loaded = vector.load %ids_view[%first] : view<[%ids_span]xi32> -> vector<16xi32>
        scf.yield %true, %loaded : i1, vector<16xi32>
      } else {
        scf.yield %false, %none : i1, vector<16xi32>
      }
      scf.yield %span_fast, %span_values : i1, vector<16xi32>
    } else {
      scf.yield %false, %none : i1, vector<16xi32>
    }
    scf.yield %pairs_fast, %pairs_values : i1, vector<16xi32>
  } else {
    scf.yield %false, %none : i1, vector<16xi32>
  }
  func.return %fast, %values : i1, vector<16xi32>
}

// n_used is a multiple of 4. Thus the 4 pairs of one packet have the same token.
func.def inline @ggml_hrx_mmidw_ids_row4_index(%pair: index, %q: index, %n_used: index, %ids_s1: index) -> (index) {
  %n_used_b = index.assume %n_used [range(%n_used, 1, 2147483647)] : index
  %c4 = index.constant 4 : index
  %q4 = index.mul %q, %c4 : index
  %p = index.add %pair, %q4 : index
  %p_b = index.assume %p [range(%p, 0, 2147483646)] : index
  %token = index.div %p_b, %n_used_b : index
  %slot = index.rem %p_b, %n_used_b : index
  %row = index.mul %token, %ids_s1 : index
  %index0 = index.add %row, %slot : index
  %index = index.assume %index0 [range(%index0, 0, 2147483600)] : index
  func.return %index : index
}

// Fast path for strided ids rows, for example a view of a wider argsort result.
// It needs ids_s0 = 1, n_used a multiple of 4 and 16 pairs in range.
func.def inline @ggml_hrx_mmidw_load_ids16_rows(%ids: buffer, %ids_span: index, %pair: index, %n_pairs: index, %n_used: index, %ids_s1: index, %rows: i1) -> (i1, vector<16xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c15 = index.constant 15 : index
  %c0_offset = index.constant 0 : offset
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %none = vector.splati -1 : vector<16xi32>
  %ids_view = buffer.view %ids[%c0_offset] : buffer -> view<[%ids_span]xi32>
  %first = index.assume %pair [range(%pair, 0, 2147483630)] : index
  %last_pair0 = index.add %first, %c15 : index
  %last_pair = index.assume %last_pair0 [range(%last_pair0, 0, 2147483646)] : index
  %i0 = func.call @ggml_hrx_mmidw_ids_row4_index(%first, %c0, %n_used, %ids_s1) : (index, index, index, index) -> (index)
  %i1 = func.call @ggml_hrx_mmidw_ids_row4_index(%first, %c1, %n_used, %ids_s1) : (index, index, index, index) -> (index)
  %i2 = func.call @ggml_hrx_mmidw_ids_row4_index(%first, %c2, %n_used, %ids_s1) : (index, index, index, index) -> (index)
  %i3 = func.call @ggml_hrx_mmidw_ids_row4_index(%first, %c3, %n_used, %ids_s1) : (index, index, index, index) -> (index)
  %l0 = index.add %i0, %c3 : index
  %l1 = index.add %i1, %c3 : index
  %l2 = index.add %i2, %c3 : index
  %l3 = index.add %i3, %c3 : index
  %fast, %values = scf.if %rows -> (i1, vector<16xi32>) {
    %in_pairs = index.cmp ult, %last_pair, %n_pairs : index
    %r_fast, %r_values = scf.if %in_pairs -> (i1, vector<16xi32>) {
      %in0 = index.cmp ult, %l0, %ids_span : index
      %a_fast, %a_values = scf.if %in0 -> (i1, vector<16xi32>) {
        %in1 = index.cmp ult, %l1, %ids_span : index
        %b_fast, %b_values = scf.if %in1 -> (i1, vector<16xi32>) {
          %in2 = index.cmp ult, %l2, %ids_span : index
          %c_fast, %c_values = scf.if %in2 -> (i1, vector<16xi32>) {
            %in3 = index.cmp ult, %l3, %ids_span : index
            %d_fast, %d_values = scf.if %in3 -> (i1, vector<16xi32>) {
              %v0 = vector.load %ids_view[%i0] : view<[%ids_span]xi32> -> vector<4xi32>
              %v1 = vector.load %ids_view[%i1] : view<[%ids_span]xi32> -> vector<4xi32>
              %v2 = vector.load %ids_view[%i2] : view<[%ids_span]xi32> -> vector<4xi32>
              %v3 = vector.load %ids_view[%i3] : view<[%ids_span]xi32> -> vector<4xi32>
              %v01 = vector.concat<0> %v0, %v1 : vector<4xi32>, vector<4xi32> -> vector<8xi32>
              %v23 = vector.concat<0> %v2, %v3 : vector<4xi32>, vector<4xi32> -> vector<8xi32>
              %v = vector.concat<0> %v01, %v23 : vector<8xi32>, vector<8xi32> -> vector<16xi32>
              scf.yield %true, %v : i1, vector<16xi32>
            } else {
              scf.yield %false, %none : i1, vector<16xi32>
            }
            scf.yield %d_fast, %d_values : i1, vector<16xi32>
          } else {
            scf.yield %false, %none : i1, vector<16xi32>
          }
          scf.yield %c_fast, %c_values : i1, vector<16xi32>
        } else {
          scf.yield %false, %none : i1, vector<16xi32>
        }
        scf.yield %b_fast, %b_values : i1, vector<16xi32>
      } else {
        scf.yield %false, %none : i1, vector<16xi32>
      }
      scf.yield %a_fast, %a_values : i1, vector<16xi32>
    } else {
      scf.yield %false, %none : i1, vector<16xi32>
    }
    scf.yield %r_fast, %r_values : i1, vector<16xi32>
  } else {
    scf.yield %false, %none : i1, vector<16xi32>
  }
  func.return %fast, %values : i1, vector<16xi32>
}

func.def inline @ggml_hrx_mmidw_count(%j: index, %matches: i1, %skipped: i1, %count: i32, %mask: i32, %skip: i32) -> (i32, i32, i32) {
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %j_i32 = index.cast %j : index to i32
  %match_inc = scf.select %matches, %c1_i32, %c0_i32 : i32
  %skip_inc = scf.select %skipped, %c1_i32, %c0_i32 : i32
  %count_next = scalar.addi %count, %match_inc : i32
  %match_bit = scalar.shli %match_inc, %j_i32 : i32
  %skip_bit = scalar.shli %skip_inc, %j_i32 : i32
  %mask_next = scalar.ori %mask, %match_bit : i32
  %skip_next = scalar.ori %skip, %skip_bit : i32
  func.return %count_next, %mask_next, %skip_next : i32, i32, i32
}

func.def inline @ggml_hrx_mmidw_route(%pair: index, %n_pairs: index, %n_used: index, %ids_s0: index, %ids_s1: index, %ids_span: index, %ids: buffer, %expert: i32) -> (i1, i1) {
  %c0_i32 = scalar.constant 0 : i32
  %false = scalar.constant false : i1
  %in_range = index.cmp ult, %pair, %n_pairs : index
  %matches, %skipped = scf.if %in_range -> (i1, i1) {
    %token = index.div %pair, %n_used : index
    %slot = index.rem %pair, %n_used : index
    %id = func.call @ggml_hrx_mmidw_load_id(%ids, %ids_span, %slot, %token, %ids_s0, %ids_s1) : (buffer, index, index, index, index, index) -> (i32)
    %is_expert = scalar.cmpi eq, %id, %expert : i32
    %is_negative = scalar.cmpi slt, %id, %c0_i32 : i32
    scf.yield %is_expert, %is_negative : i1, i1
  } else {
    scf.yield %false, %false : i1, i1
  }
  func.return %matches, %skipped : i1, i1
}

func.def inline @ggml_hrx_mmidw_zero_column(%dst: buffer, %d_span: index, %pair: index, %n_used: index, %d_s1: index, %d_s2: index, %row_begin: index, %row_end: index, %n_rows: index) {
  %c1 = index.constant 1 : index
  %zero = scalar.constant 0.0 : f32
  %token = index.div %pair, %n_used : index
  %slot = index.rem %pair, %n_used : index
  %offset1 = index.mul %slot, %d_s1 : index
  %offset2 = index.mul %token, %d_s2 : index
  %col_base = index.add %offset1, %offset2 : index
  scf.for %row = [%row_begin to %row_end step %c1] {
    %row_in = index.cmp ult, %row, %n_rows : index
    scf.if %row_in {
      %index = index.add %col_base, %row : index
      func.call @ggml_hrx_mm_store(%dst, %d_span, %index, %zero) : (buffer, index, index, f32)
    }
  }
  func.return
}

// The list stores pair - window. The result is -1 past the route count.
func.def inline @ggml_hrx_mmidw_pair_bases(%list: buffer, %i: index, %count: index, %window: index, %n_used: index, %x_ne1: index, %x_s1: index, %x_s2: index, %d_s1: index, %d_s2: index) -> (i32, i32) {
  %c4096 = index.constant 4096 : index
  %c0_offset = index.constant 0 : offset
  %minus_one = scalar.constant -1 : i32
  %list_view = buffer.view %list[%c0_offset] : buffer -> view<4096xi16>
  %valid = index.cmp ult, %i, %count : index
  %x_base, %d_base = scf.if %valid -> (i32, i32) {
    %off = index.assume %i [range(%i, 0, 2147483646)] : index
    %ok = index.cmp ult, %off, %c4096 : index
    %bases_x, %bases_d = scf.if %ok -> (i32, i32) {
      %local_i16 = view.load %list_view[%off] : view<4096xi16> -> i16
      %local_i32 = scalar.extui %local_i16 : i16 to i32
      %local = index.cast %local_i32 : i32 to index
      %pair_raw = index.add %window, %local : index
      // Listed pairs are below n_pairs, and n_pairs is below 2^31.
      %pair = index.assume %pair_raw [range(%pair_raw, 0, 2147483646)] : index
      %token = index.div %pair, %n_used : index
      %slot = index.rem %pair, %n_used : index
      %x_slot = index.rem %slot, %x_ne1 : index
      %x_offset1 = index.mul %x_slot, %x_s1 : index
      %x_offset2 = index.mul %token, %x_s2 : index
      %x_index = index.add %x_offset1, %x_offset2 : index
      %d_offset1 = index.mul %slot, %d_s1 : index
      %d_offset2 = index.mul %token, %d_s2 : index
      %d_index = index.add %d_offset1, %d_offset2 : index
      %x_i32 = index.cast %x_index : index to i32
      %d_i32 = index.cast %d_index : index to i32
      scf.yield %x_i32, %d_i32 : i32, i32
    } else {
      scf.yield %minus_one, %minus_one : i32, i32
    }
    scf.yield %bases_x, %bases_d : i32, i32
  } else {
    scf.yield %minus_one, %minus_one : i32, i32
  }
  func.return %x_base, %d_base : i32, i32
}

func.def inline @ggml_hrx_mmidw_load_input_guarded(%input: buffer, %x_span: index, %x_base_i32: i32, %k: index, %k_size: index) -> (vector<8xf32>) {
  %c7 = index.constant 7 : index
  %c0_offset = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<[%x_span]xf32>
  %valid = scalar.cmpi sge, %x_base_i32, %c0_i32 : i32
  %values = scf.if %valid -> (vector<8xf32>) {
    %k_in = index.cmp ult, %k, %k_size : index
    %k_values = scf.if %k_in -> (vector<8xf32>) {
      %x_base = index.cast %x_base_i32 : i32 to index
      %index0 = index.add %x_base, %k : index
      %index = index.assume %index0 [range(%index0, 0, 2147483646)] : index
      %last0 = index.add %index, %c7 : index
      %last = index.assume %last0 [range(%last0, 0, 2147483646)] : index
      %in_span = index.cmp ult, %last, %x_span : index
      %loaded = scf.if %in_span -> (vector<8xf32>) {
        %v = vector.load %input_view[%index] : view<[%x_span]xf32> -> vector<8xf32>
        scf.yield %v : vector<8xf32>
      } else {
        scf.yield %zero8 : vector<8xf32>
      }
      scf.yield %loaded : vector<8xf32>
    } else {
      scf.yield %zero8 : vector<8xf32>
    }
    scf.yield %k_values : vector<8xf32>
  } else {
    scf.yield %zero8 : vector<8xf32>
  }
  func.return %values : vector<8xf32>
}

// The load has no guard. A guard merge waits for the data immediately, and this stops the prefetch.
// The clamp is safe because x_span >= K >= 32. Callers do not store values of an unlisted column or of k >= K.
func.def inline @ggml_hrx_mmidw_load_input(%input: buffer, %x_span: index, %x_base_i32: i32, %k: index) -> (vector<8xf32>) {
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c0_offset = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %x_base_clamped = scalar.maxsi %x_base_i32, %c0_i32 : i32
  %x_base = index.cast %x_base_clamped : i32 to index
  %index0 = index.add %x_base, %k : index
  %index1 = index.assume %index0 [range(%index0, 0, 2147483646)] : index
  %x_span_k = index.assume %x_span [range(%x_span, 32, 2147483647)] : index
  %span_last = index.sub %x_span_k, %c8 : index
  %limit0 = index.sub %x_span_k, %c7 : index
  %index2 = index.min %index1, %span_last : index
  %index, %limit = index.assume %index2, %limit0 [lt(%index2, %limit0)] : index, index
  %extent = index.add %limit, %c7 : index
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<[%extent]xf32>
  %values = vector.load %input_view[%index] : view<[%extent]xf32> -> vector<8xf32>
  func.return %values : vector<8xf32>
}

func.def inline @ggml_hrx_mmidw_store1(%dst: buffer, %d_span: index, %d_bases: buffer, %col: index, %row: index, %n_rows: index, %value: f32) {
  %c0_offset = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %d_base_view = buffer.view %d_bases[%c0_offset] : buffer -> view<32xi32>
  %d_base_i32 = view.load %d_base_view[%col] : view<32xi32> -> i32
  %valid = scalar.cmpi sge, %d_base_i32, %c0_i32 : i32
  scf.if %valid {
    %row_in = index.cmp ult, %row, %n_rows : index
    scf.if %row_in {
      %d_base = index.cast %d_base_i32 : i32 to index
      %index = index.add %d_base, %row : index
      func.call @ggml_hrx_mm_store(%dst, %d_span, %index, %value) : (buffer, index, index, f32)
    }
  }
  func.return
}

// The fragment layout is the gfx11 wave32 result layout.
func.def inline @ggml_hrx_mmidw_store_fragment(%dst: buffer, %d_span: index, %d_bases: buffer, %col: index, %row: index, %n_rows: index, %acc: vector<8xf32>) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c6 = index.constant 6 : index
  %c8 = index.constant 8 : index
  %c10 = index.constant 10 : index
  %c12 = index.constant 12 : index
  %c14 = index.constant 14 : index
  %col1 = index.add %col, %c2 : index
  %col2 = index.add %col, %c4 : index
  %col3 = index.add %col, %c6 : index
  %col4 = index.add %col, %c8 : index
  %col5 = index.add %col, %c10 : index
  %col6 = index.add %col, %c12 : index
  %col7 = index.add %col, %c14 : index
  %v0 = vector.extract %acc[0] : vector<8xf32> -> f32
  %v1 = vector.extract %acc[1] : vector<8xf32> -> f32
  %v2 = vector.extract %acc[2] : vector<8xf32> -> f32
  %v3 = vector.extract %acc[3] : vector<8xf32> -> f32
  %v4 = vector.extract %acc[4] : vector<8xf32> -> f32
  %v5 = vector.extract %acc[5] : vector<8xf32> -> f32
  %v6 = vector.extract %acc[6] : vector<8xf32> -> f32
  %v7 = vector.extract %acc[7] : vector<8xf32> -> f32
  func.call @ggml_hrx_mmidw_store1(%dst, %d_span, %d_bases, %col, %row, %n_rows, %v0) : (buffer, index, buffer, index, index, index, f32)
  func.call @ggml_hrx_mmidw_store1(%dst, %d_span, %d_bases, %col1, %row, %n_rows, %v1) : (buffer, index, buffer, index, index, index, f32)
  func.call @ggml_hrx_mmidw_store1(%dst, %d_span, %d_bases, %col2, %row, %n_rows, %v2) : (buffer, index, buffer, index, index, index, f32)
  func.call @ggml_hrx_mmidw_store1(%dst, %d_span, %d_bases, %col3, %row, %n_rows, %v3) : (buffer, index, buffer, index, index, index, f32)
  func.call @ggml_hrx_mmidw_store1(%dst, %d_span, %d_bases, %col4, %row, %n_rows, %v4) : (buffer, index, buffer, index, index, index, f32)
  func.call @ggml_hrx_mmidw_store1(%dst, %d_span, %d_bases, %col5, %row, %n_rows, %v5) : (buffer, index, buffer, index, index, index, f32)
