// A negative id zeroes its dst column, like the CPU backend.
// Weight strides and span are in weight units (see lib/mm_core.loom). Other strides are in elements.
// All kernels have the same launch arguments.

config.decl @ggml.mul_mat_id.weight_type : %value: index where [range(%value, 0, 6)]

// Only ggml_mul_mat_id_vec_kq uses this.
config.decl @ggml.mul_mat_id.kq_slots : %value: index where [range(%value, 1, 8)]

target.decl @ggml_wave64

template.decl @ggml.reduce.sum_f32(%value: f32, %lanes: index) -> (f32)

template.decl @ggml.weight.block(%wtype: index) -> (index, index)

template.decl @ggml.weight.block_dot(%wtype: index, %weight: buffer, %n_wb: index, %wb: index, %input: buffer, %n_xb: index, %xb: index, %p: index) -> (f32)

func.decl @ggml_hrx_mm_dot_partial(%wtype: index, %k_size: index, %w_row_base: index, %x_col_base: index, %x_s0: index, %w_span: index, %x_span: index, %weight: buffer, %input: buffer) -> (f32)

func.decl @ggml_hrx_mm_weight4(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index) -> (vector<4xf32>)

func.decl @ggml_hrx_mm_input_at(%input: buffer, %x_span: index, %x_col_base: index, %x_s0: index, %k: index, %k_size: index) -> (f32)

func.decl @ggml_hrx_mm_store(%dst: buffer, %d_span: index, %index: index, %value: f32)

func.decl @ggml_hrx_mm_store4(%dst: buffer, %d_span: index, %d_col_base: index, %row0: index, %n_rows: index, %col_valid: i1, %values: vector<4xf32>)

func.def inline @ggml_hrx_mmid_load_id(%ids: buffer, %ids_span: index, %slot: index, %token: index, %ids_s0: index, %ids_s1: index) -> (i32) {
  %c0_offset = index.constant 0 : offset
  %minus_one = scalar.constant -1 : i32
  %ids_view = buffer.view %ids[%c0_offset] : buffer -> view<[%ids_span]xi32>
  %offset0 = index.mul %slot, %ids_s0 : index
  %offset1 = index.mul %token, %ids_s1 : index
  %index = index.add %offset0, %offset1 : index
  %off = index.assume %index [range(%index, 0, 2147483646)] : index
  %ok = index.cmp ult, %off, %ids_span : index
  %id = scf.if %ok -> (i32) {
    %loaded = view.load %ids_view[%off] : view<[%ids_span]xi32> -> i32
    scf.yield %loaded : i32
  } else {
    scf.yield %minus_one : i32
  }
  func.return %id : i32
}

kernel.def target(@ggml_wave64) export("ggml_mul_mat_id_vec") @ggml_mul_mat_id_vec(%n_rows: index, %n_used: index, %n_tokens: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 64 : index
  kernel.launch.config workgroups(%n_rows, %n_used, %n_tokens) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_expert_in: index, %n_used_in: index, %n_tokens_in: index, %x_ne1_in: index, %w_s1_in: index, %w_s2_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_span_in: index, %ids_s0_in: index, %ids_s1_in: index, %ids_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %ids: buffer, %dst: buffer) {
  // supports_mul_mat_id checks these ranges.
  %k_size = index.assume %k_size_in [range(%k_size_in, 1, 2147483647)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_expert = index.assume %n_expert_in [range(%n_expert_in, 1, 2147483647)] : index
  %n_used = index.assume %n_used_in [range(%n_used_in, 1, 2147483647)] : index
  %n_tokens = index.assume %n_tokens_in [range(%n_tokens_in, 1, 2147483647)] : index
  %x_ne1 = index.assume %x_ne1_in [range(%x_ne1_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_span = index.assume %w_span_in [range(%w_span_in, 1, 2147483647)] : index
  %x_s0 = index.assume %x_s0_in [range(%x_s0_in, 0, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %ids_s0 = index.assume %ids_s0_in [range(%ids_s0_in, 0, 2147483647)] : index
  %ids_s1 = index.assume %ids_s1_in [range(%ids_s1_in, 0, 2147483647)] : index
  %ids_span = index.assume %ids_span_in [range(%ids_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat_id.weight_type : index
  %c0 = index.constant 0 : index
  %c0_i32 = scalar.constant 0 : i32
  %zero = scalar.constant 0.0 : f32
  %row = kernel.workgroup.id<x> : index
  %slot = kernel.workgroup.id<y> : index
  %token = kernel.workgroup.id<z> : index
  %lane = kernel.workitem.id<x> : index
  %is_lane0 = index.cmp eq, %lane, %c0 : index
  %weight_noalias, %input_noalias, %ids_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %ids, %dst : buffer, buffer, buffer, buffer
  %row_in = index.cmp ult, %row, %n_rows : index
  %slot_in = index.cmp ult, %slot, %n_used : index
  %token_in = index.cmp ult, %token, %n_tokens : index
  scf.if %row_in {
    scf.if %slot_in {
      scf.if %token_in {
        %expert_i32 = func.call @ggml_hrx_mmid_load_id(%ids_noalias, %ids_span, %slot, %token, %ids_s0, %ids_s1) : (buffer, index, index, index, index, index) -> (i32)
        %expert_nonnegative = scalar.cmpi sge, %expert_i32, %c0_i32 : i32
        %expert_raw = index.cast %expert_i32 : i32 to index
        %expert_below = index.cmp ult, %expert_raw, %n_expert : index
        %expert_valid = scalar.andi %expert_nonnegative, %expert_below : i1
        // expert_valid is the same in the whole workgroup. Thus the reduction stays in uniform control flow.
        %partial = scf.if %expert_valid -> (f32) {
          %x_slot = index.rem %slot, %x_ne1 : index
          %x_offset1 = index.mul %x_slot, %x_s1 : index
          %x_offset2 = index.mul %token, %x_s2 : index
          %x_col_base = index.add %x_offset1, %x_offset2 : index
          %w_offset2 = index.mul %expert_raw, %w_s2 : index
          %w_offset1 = index.mul %row, %w_s1 : index
          %w_row_base = index.add %w_offset2, %w_offset1 : index
          %dot = func.call @ggml_hrx_mm_dot_partial(%wtype, %k_size, %w_row_base, %x_col_base, %x_s0, %w_span, %x_span, %weight_noalias, %input_noalias) : (index, index, index, index, index, index, index, buffer, buffer) -> (f32)
          scf.yield %dot : f32
        } else {
          scf.yield %zero : f32
        }
        %sum = kernel.workgroup.reduce<addf> %partial : f32
        scf.if %is_lane0 {
          %d_offset1 = index.mul %slot, %d_s1 : index
          %d_offset2 = index.mul %token, %d_s2 : index
          %d_col_base = index.add %d_offset1, %d_offset2 : index
          %d_index = index.add %d_col_base, %row : index
          func.call @ggml_hrx_mm_store(%dst_noalias, %d_span, %d_index, %sum) : (buffer, index, index, f32)
        }
      }
    }
  }
  kernel.return
}

func.decl @ggml_hrx_mm_store_row(%dst: buffer, %d_span: index, %d_col_base: index, %row: index, %n_rows: index, %value: f32)

func.def inline @ggml_hrx_mmid_row_sum(%value: f32, %spr: index) -> (f32) {
  %c8 = index.constant 8 : index
  %lanes = index.mul %spr, %c8 : index
  %sum = template.apply<@ggml.reduce.sum_f32>(%value, %lanes) : (f32, index) -> (f32)
  func.return %sum : f32
}

// For few pairs with Q4_K, Q5_K or Q6_K weights.
// There is one bounds check for each 256-value block. Thus all loads of a packet are in flight together.
kernel.def target(@ggml_wave64) export("ggml_mul_mat_id_vec_kq") @ggml_mul_mat_id_vec_kq(%n_rows: index, %n_used: index, %n_tokens: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 64 : index
  %c8 = index.constant 8 : index
  %spr = config.get @ggml.mul_mat_id.kq_slots : index
  %rows_per_step = index.div %c8, %spr : index
  %rows_last = index.sub %rows_per_step, %one : index
  %rows_round = index.add %n_rows, %rows_last : index
  %tiles = index.div %rows_round, %rows_per_step : index
  kernel.launch.config workgroups(%tiles, %n_used, %n_tokens) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_expert_in: index, %n_used_in: index, %n_tokens_in: index, %x_ne1_in: index, %w_s1_in: index, %w_s2_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_span_in: index, %ids_s0_in: index, %ids_s1_in: index, %ids_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %ids: buffer, %dst: buffer) {
  // supports_mul_mat_id checks these ranges. The caller makes sure that K is a multiple of 256 * kq_slots and x_s0 is 1.
  // x_s1 and x_s2 are multiples of 256. w_s1 and w_s2 are multiples of the block size.
  %k_size = index.assume %k_size_in [range(%k_size_in, 1, 2147483647)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_expert = index.assume %n_expert_in [range(%n_expert_in, 1, 2147483647)] : index
  %n_used = index.assume %n_used_in [range(%n_used_in, 1, 2147483647)] : index
  %n_tokens = index.assume %n_tokens_in [range(%n_tokens_in, 1, 2147483647)] : index
  %x_ne1 = index.assume %x_ne1_in [range(%x_ne1_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_span = index.assume %w_span_in [range(%w_span_in, 1, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %ids_s0 = index.assume %ids_s0_in [range(%ids_s0_in, 0, 2147483647)] : index
  %ids_s1 = index.assume %ids_s1_in [range(%ids_s1_in, 0, 2147483647)] : index
  %ids_span = index.assume %ids_span_in [range(%ids_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat_id.weight_type : index
  %spr_in = config.get @ggml.mul_mat_id.kq_slots : index
  %spr = index.assume %spr_in [range(%spr_in, 1, 8)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c8 = index.constant 8 : index
  %c36 = index.constant 36 : index
  %c44 = index.constant 44 : index
  %c105 = index.constant 105 : index
  %c256 = index.constant 256 : index
  %c0_i32 = scalar.constant 0 : i32
  %zero = scalar.constant 0.0 : f32
  %block_values, %block_units = template.apply<@ggml.weight.block>(%wtype) : (index) -> (index, index)
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 63)] : index
  %p = index.rem %t, %c8 : index
  %s = index.div %t, %c8 : index
  %step_row = index.div %s, %spr : index
  %slot_block = index.rem %s, %spr : index
  %rows_per_step = index.div %c8, %spr : index
  %tile = kernel.workgroup.id<x> : index
  %slot = kernel.workgroup.id<y> : index
  %token = kernel.workgroup.id<z> : index
  %tile_row0 = index.mul %tile, %rows_per_step : index
  %row = index.add %tile_row0, %step_row : index
  %row_in = index.cmp ult, %row, %n_rows : index
  %row_read = scf.select %row_in, %row, %c0 : index
  %weight_noalias, %input_noalias, %ids_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %ids, %dst : buffer, buffer, buffer, buffer
  %slot_in = index.cmp ult, %slot, %n_used : index
  %token_in = index.cmp ult, %token, %n_tokens : index
  %n_blocks = index.div %k_size, %c256 : index
  %n_chunks = index.div %n_blocks, %spr : index
  %n_wb = index.div %w_span, %block_units : index
  %w_s1_blocks = index.div %w_s1, %block_units : index
  %w_s2_blocks = index.div %w_s2, %block_units : index
  %n_xb = index.div %x_span, %c256 : index
  scf.if %slot_in {
    scf.if %token_in {
      %x_slot = index.rem %slot, %x_ne1 : index
      %x_offset1 = index.mul %x_slot, %x_s1 : index
      %x_offset2 = index.mul %token, %x_s2 : index
      %x_col_base = index.add %x_offset1, %x_offset2 : index
      %xb_col = index.div %x_col_base, %c256 : index
      %expert_i32 = func.call @ggml_hrx_mmid_load_id(%ids_noalias, %ids_span, %slot, %token, %ids_s0, %ids_s1) : (buffer, index, index, index, index, index) -> (i32)
      %expert_nonnegative = scalar.cmpi sge, %expert_i32, %c0_i32 : i32
      %expert_raw = index.cast %expert_i32 : i32 to index
      %expert_below = index.cmp ult, %expert_raw, %n_expert : index
      %expert_valid = scalar.andi %expert_nonnegative, %expert_below : i1
      // An invalid id or row reads expert 0 or row 0. The result is dropped. This keeps the loads unconditional.
      %expert_read = scf.select %expert_valid, %expert_raw, %c0 : index
      %wb_expert = index.mul %expert_read, %w_s2_blocks : index
      %wb_row_offset = index.mul %row_read, %w_s1_blocks : index
      %wb_row = index.add %wb_expert, %wb_row_offset : index
      %acc = scf.for %chunk = [%c0 to %n_chunks step %c1](%sum_in = %zero : f32) -> (f32) {
        %chunk_block = index.mul %chunk, %spr : index
        %block = index.add %chunk_block, %slot_block : index
        %wb_raw = index.add %wb_row, %block : index
        %wb = index.assume %wb_raw [range(%wb_raw, 0, 2147483646)] : index
        %xb_raw = index.add %xb_col, %block : index
        %xb = index.assume %xb_raw [range(%xb_raw, 0, 2147483646)] : index
        %dot = template.apply<@ggml.weight.block_dot>(%wtype, %weight_noalias, %n_wb, %wb, %input_noalias, %n_xb, %xb, %p) : (index, buffer, index, index, buffer, index, index, index) -> (f32)
        %sum_next = scalar.addf %sum_in, %dot : f32
        scf.yield %sum_next : f32
      }
      %partial = scf.select %expert_valid, %acc, %zero : f32
      %sum = func.call @ggml_hrx_mmid_row_sum(%partial, %spr) : (f32, index) -> (f32)
      %lead_slot = index.cmp eq, %slot_block, %c0 : index
      %lead_packet = index.cmp eq, %p, %c0 : index
      %is_leader = scalar.andi %lead_slot, %lead_packet : i1
      scf.if %is_leader {
        %d_offset1 = index.mul %slot, %d_s1 : index
        %d_offset2 = index.mul %token, %d_s2 : index
        %d_col_base = index.add %d_offset1, %d_offset2 : index
        func.call @ggml_hrx_mm_store_row(%dst_noalias, %d_span, %d_col_base, %row, %n_rows, %sum) : (buffer, index, index, index, index, f32)
      }
    }
  }
  kernel.return
}

// Returns two flags: the pair uses the expert, and the id of the pair is negative.
func.def inline @ggml_hrx_mmid_route(%pair: index, %n_pairs: index, %n_used: index, %ids_s0: index, %ids_s1: index, %ids_span: index, %ids: buffer, %expert: i32) -> (i1, i1) {
  %c0_i32 = scalar.constant 0 : i32
  %false = scalar.constant false : i1
  %in_range = index.cmp ult, %pair, %n_pairs : index
  %matches, %skipped = scf.if %in_range -> (i1, i1) {
    %token = index.div %pair, %n_used : index
    %slot = index.rem %pair, %n_used : index
    %id = func.call @ggml_hrx_mmid_load_id(%ids, %ids_span, %slot, %token, %ids_s0, %ids_s1) : (buffer, index, index, index, index, index) -> (i32)
    %is_expert = scalar.cmpi eq, %id, %expert : i32
    %is_negative = scalar.cmpi slt, %id, %c0_i32 : i32
    scf.yield %is_expert, %is_negative : i1, i1
  } else {
    scf.yield %false, %false : i1, i1
  }
  func.return %matches, %skipped : i1, i1
}

func.def inline @ggml_hrx_mmid_zero_column(%dst: buffer, %d_span: index, %pair: index, %n_used: index, %d_s1: index, %d_s2: index, %tile_row0: index, %n_rows: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %zero = scalar.constant 0.0 : f32
  %token = index.div %pair, %n_used : index
  %slot = index.rem %pair, %n_used : index
  %offset1 = index.mul %slot, %d_s1 : index
  %offset2 = index.mul %token, %d_s2 : index
  %col_base = index.add %offset1, %offset2 : index
  scf.for %row_local = [%c0 to %c64 step %c1] {
    %row = index.add %tile_row0, %row_local : index
    %row_in = index.cmp ult, %row, %n_rows : index
    scf.if %row_in {
      %index = index.add %col_base, %row : index
      func.call @ggml_hrx_mm_store(%dst, %d_span, %index, %zero) : (buffer, index, index, f32)
    }
  }
  func.return
}

// Returns -1 past the route count.
func.def inline @ggml_hrx_mmid_pair_bases(%list: buffer, %i: index, %count: index, %n_used: index, %x_ne1: index, %x_s1: index, %x_s2: index, %d_s1: index, %d_s2: index) -> (i32, i32) {
  %c512 = index.constant 512 : index
  %c0_offset = index.constant 0 : offset
  %minus_one = scalar.constant -1 : i32
  %list_view = buffer.view %list[%c0_offset] : buffer -> view<512xi32>
  %valid = index.cmp ult, %i, %count : index
  %x_base, %d_base = scf.if %valid -> (i32, i32) {
    %off = index.assume %i [range(%i, 0, 2147483646)] : index
    %ok = index.cmp ult, %off, %c512 : index
    %bases_x, %bases_d = scf.if %ok -> (i32, i32) {
      %pair_i32 = view.load %list_view[%off] : view<512xi32> -> i32
      %pair_raw = index.cast %pair_i32 : i32 to index
      // Listed pairs are below n_pairs, and n_pairs is below 2^31.
      %pair = index.assume %pair_raw [range(%pair_raw, 0, 2147483646)] : index
      %token = index.div %pair, %n_used : index
      %slot = index.rem %pair, %n_used : index
      %x_slot = index.rem %slot, %x_ne1 : index
      %x_offset1 = index.mul %x_slot, %x_s1 : index
      %x_offset2 = index.mul %token, %x_s2 : index
      %x_index = index.add %x_offset1, %x_offset2 : index
      %d_offset1 = index.mul %slot, %d_s1 : index
      %d_offset2 = index.mul %token, %d_s2 : index
      %d_index = index.add %d_offset1, %d_offset2 : index
      %x_i32 = index.cast %x_index : index to i32
      %d_i32 = index.cast %d_index : index to i32
      scf.yield %x_i32, %d_i32 : i32, i32
    } else {
      scf.yield %minus_one, %minus_one : i32, i32
    }
    scf.yield %bases_x, %bases_d : i32, i32
  } else {
    scf.yield %minus_one, %minus_one : i32, i32
  }
  func.return %x_base, %d_base : i32, i32
}

// An x_base of -1 means no column.
func.def inline @ggml_hrx_mmid_stage_input(%input: buffer, %x_span: index, %x_base_i32: i32, %x_s0: index, %k: index, %k_size: index) -> (f32) {
  %c0_i32 = scalar.constant 0 : i32
  %zero = scalar.constant 0.0 : f32
  %valid = scalar.cmpi sge, %x_base_i32, %c0_i32 : i32
  %value = scf.if %valid -> (f32) {
    %x_base = index.cast %x_base_i32 : i32 to index
    %loaded = func.call @ggml_hrx_mm_input_at(%input, %x_span, %x_base, %x_s0, %k, %k_size) : (buffer, index, index, index, index, index) -> (f32)
    scf.yield %loaded : f32
  } else {
    scf.yield %zero : f32
  }
  func.return %value : f32
}

// One 64-wide subgroup runs this. Thus subgroup-scope barriers are sufficient.
func.def inline @ggml_hrx_mmid_tile(%wtype: index, %k_size: index, %w_base: index, %w_valid: i1, %x_s0: index, %w_span: index, %x_span: index, %weight: buffer, %input: buffer, %w_stage: buffer, %x_stage: buffer, %x_bases: buffer) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 63)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c0_offset = index.constant 0 : offset
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %w_view = buffer.view %w_stage[%c0_offset] : buffer -> view<32x64xf32>
  %x_view = buffer.view %x_stage[%c0_offset] : buffer -> view<16x33xf32>
  %x_base_view = buffer.view %x_bases[%c0_offset] : buffer -> view<16xi32>
  %x_k = index.rem %t, %c32 : index
  %x_col0 = index.div %t, %c32 : index
  %out_row_group = index.rem %t, %c16 : index
  %out_row = index.mul %out_row_group, %c4 : index
  %out_col0 = index.div %t, %c16 : index
  %out_col1 = index.add %out_col0, %c4 : index
  %out_col2 = index.add %out_col0, %c8 : index
  %out_col3 = index.add %out_col0, %c12 : index
  %acc0, %acc1, %acc2, %acc3 = scf.for %k0 = [%c0 to %k_size step %c32](%t_acc0 = %zero4 : vector<4xf32>, %t_acc1 = %zero4 : vector<4xf32>, %t_acc2 = %zero4 : vector<4xf32>, %t_acc3 = %zero4 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    scf.for %wi = [%c0 to %c8 step %c1] {
      %w_k0 = index.mul %wi, %c4 : index
      %w_k1 = index.add %w_k0, %c1 : index
      %w_k2 = index.add %w_k0, %c2 : index
      %w_k3 = index.add %w_k0, %c3 : index
      %w_k = index.add %k0, %w_k0 : index
      %w = func.call @ggml_hrx_mm_weight4(%wtype, %weight, %w_span, %w_base, %w_valid, %w_k, %k_size) : (index, buffer, index, index, i1, index, index) -> (vector<4xf32>)
      %w_0 = vector.extract %w[0] : vector<4xf32> -> f32
      %w_1 = vector.extract %w[1] : vector<4xf32> -> f32
      %w_2 = vector.extract %w[2] : vector<4xf32> -> f32
      %w_3 = vector.extract %w[3] : vector<4xf32> -> f32
      view.store %w_0, %w_view[%w_k0, %t] : f32, view<32x64xf32>
      view.store %w_1, %w_view[%w_k1, %t] : f32, view<32x64xf32>
      view.store %w_2, %w_view[%w_k2, %t] : f32, view<32x64xf32>
      view.store %w_3, %w_view[%w_k3, %t] : f32, view<32x64xf32>
    }
    %x_k_abs = index.add %k0, %x_k : index
    scf.for %xi = [%c0 to %c8 step %c1] {
      %x_col_offset = index.mul %xi, %c2 : index
      %x_col = index.add %x_col0, %x_col_offset : index
      %x_base = view.load %x_base_view[%x_col] : view<16xi32> -> i32
      %x = func.call @ggml_hrx_mmid_stage_input(%input, %x_span, %x_base, %x_s0, %x_k_abs, %k_size) : (buffer, index, i32, index, index, index) -> (f32)
      view.store %x, %x_view[%x_col, %x_k] : f32, view<16x33xf32>
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    %next0, %next1, %next2, %next3 = scf.for %kk = [%c0 to %c32 step %c1](%k_acc0 = %t_acc0 : vector<4xf32>, %k_acc1 = %t_acc1 : vector<4xf32>, %k_acc2 = %t_acc2 : vector<4xf32>, %k_acc3 = %t_acc3 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %wv = vector.load %w_view[%kk, %out_row] : view<32x64xf32> -> vector<4xf32>
      %a0 = view.load %x_view[%out_col0, %kk] : view<16x33xf32> -> f32
      %a1 = view.load %x_view[%out_col1, %kk] : view<16x33xf32> -> f32
      %a2 = view.load %x_view[%out_col2, %kk] : view<16x33xf32> -> f32
      %a3 = view.load %x_view[%out_col3, %kk] : view<16x33xf32> -> f32
      %a0_vector = vector.splat %a0 : vector<4xf32>
      %a1_vector = vector.splat %a1 : vector<4xf32>
      %a2_vector = vector.splat %a2 : vector<4xf32>
      %a3_vector = vector.splat %a3 : vector<4xf32>
      %k_next0 = vector.fmaf %wv, %a0_vector, %k_acc0 : vector<4xf32>
      %k_next1 = vector.fmaf %wv, %a1_vector, %k_acc1 : vector<4xf32>
      %k_next2 = vector.fmaf %wv, %a2_vector, %k_acc2 : vector<4xf32>
      %k_next3 = vector.fmaf %wv, %a3_vector, %k_acc3 : vector<4xf32>
      scf.yield %k_next0, %k_next1, %k_next2, %k_next3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    // The next K step overwrites the stages.
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    scf.yield %next0, %next1, %next2, %next3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }
  func.return %acc0, %acc1, %acc2, %acc3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
}

// A dst base of -1 means no column.
func.def inline @ggml_hrx_mmid_store_column(%dst: buffer, %d_span: index, %d_bases: buffer, %col: index, %row0: index, %n_rows: index, %values: vector<4xf32>) {
  %c0_offset = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %d_base_view = buffer.view %d_bases[%c0_offset] : buffer -> view<16xi32>
  %d_base_i32 = view.load %d_base_view[%col] : view<16xi32> -> i32
  %valid = scalar.cmpi sge, %d_base_i32, %c0_i32 : i32
  %d_base = index.cast %d_base_i32 : i32 to index
  func.call @ggml_hrx_mm_store4(%dst, %d_span, %d_base, %row0, %n_rows, %valid, %values) : (buffer, index, index, index, index, i1, vector<4xf32>)
  func.return
}

// For many pairs (prefill). The weight tile of the expert is used again for all of its pairs.
// MoE prefill has few pairs for each expert. Thus the tile has 64 rows and the chunks have 16 pairs.
kernel.def target(@ggml_wave64) export("ggml_mul_mat_id_tiled") @ggml_mul_mat_id_tiled(%n_rows: index, %n_expert: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 64 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %rows_round = index.add %n_rows, %c63 : index
  %row_tiles = index.div %rows_round, %c64 : index
  kernel.launch.config workgroups(%row_tiles, %n_expert, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_expert_in: index, %n_used_in: index, %n_tokens_in: index, %x_ne1_in: index, %w_s1_in: index, %w_s2_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_span_in: index, %ids_s0_in: index, %ids_s1_in: index, %ids_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %ids: buffer, %dst: buffer) {
  // supports_mul_mat_id checks these ranges.
  %k_size = index.assume %k_size_in [range(%k_size_in, 1, 2147483647)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_expert = index.assume %n_expert_in [range(%n_expert_in, 1, 2147483647)] : index
  %n_used = index.assume %n_used_in [range(%n_used_in, 1, 2147483647)] : index
  %n_tokens = index.assume %n_tokens_in [range(%n_tokens_in, 1, 2147483647)] : index
  %x_ne1 = index.assume %x_ne1_in [range(%x_ne1_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_span = index.assume %w_span_in [range(%w_span_in, 1, 2147483647)] : index
  %x_s0 = index.assume %x_s0_in [range(%x_s0_in, 0, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %ids_s0 = index.assume %ids_s0_in [range(%ids_s0_in, 0, 2147483647)] : index
  %ids_s1 = index.assume %ids_s1_in [range(%ids_s1_in, 0, 2147483647)] : index
  %ids_span = index.assume %ids_span_in [range(%ids_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat_id.weight_type : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c512 = index.constant 512 : index
  %c0_offset = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %w_stage_bytes = index.constant 8192 : offset
  %x_stage_bytes = index.constant 2112 : offset
  %list_bytes = index.constant 2048 : offset
  %bases_bytes = index.constant 64 : offset
  %count_bytes = index.constant 256 : offset
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 63)] : index
  %row_tile = kernel.workgroup.id<x> : index
  %expert = kernel.workgroup.id<y> : index
  %expert_i32 = index.cast %expert : index to i32
  %expert_in = index.cmp ult, %expert, %n_expert : index
  %zeroes_skipped = index.cmp eq, %expert, %c0 : index
  %weight_noalias, %input_noalias, %ids_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %ids, %dst : buffer, buffer, buffer, buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %x_stage = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer
  %list_stage = buffer.alloca<workgroup> align(16) %list_bytes : buffer
  %x_bases = buffer.alloca<workgroup> align(16) %bases_bytes : buffer
  %d_bases = buffer.alloca<workgroup> align(16) %bases_bytes : buffer
  %count_stage = buffer.alloca<workgroup> align(16) %count_bytes : buffer
  %count_view = buffer.view %count_stage[%c0_offset] : buffer -> view<64xi32>
  %list_view = buffer.view %list_stage[%c0_offset] : buffer -> view<512xi32>
  %x_base_view = buffer.view %x_bases[%c0_offset] : buffer -> view<16xi32>
  %d_base_view = buffer.view %d_bases[%c0_offset] : buffer -> view<16xi32>
  %n_pairs = index.mul %n_used, %n_tokens : index
  %tile_row0 = index.mul %row_tile, %c64 : index

  %w_row = index.add %tile_row0, %t : index
  %w_valid = index.cmp ult, %w_row, %n_rows : index
  %w_expert = index.mul %expert, %w_s2 : index
  %w_offset = index.mul %w_row, %w_s1 : index
  %w_base = index.add %w_expert, %w_offset : index

  %out_row_group = index.rem %t, %c16 : index
  %out_row_local = index.mul %out_row_group, %c4 : index
  %out_row = index.add %tile_row0, %out_row_local : index
  %out_col0 = index.div %t, %c16 : index
  %out_col1 = index.add %out_col0, %c4 : index
  %out_col2 = index.add %out_col0, %c8 : index
  %out_col3 = index.add %out_col0, %c12 : index
  %is_base_writer = index.cmp ult, %t, %c16 : index

  %pair_offset = index.mul %t, %c8 : index
  scf.if %expert_in {
    scf.for %window = [%c0 to %n_pairs step %c512] {
      %pair_begin = index.add %window, %pair_offset : index
      %match_count = scf.for %j = [%c0 to %c8 step %c1](%count_acc = %c0_i32 : i32) -> (i32) {
        %pair = index.add %pair_begin, %j : index
        %matches, %skipped = func.call @ggml_hrx_mmid_route(%pair, %n_pairs, %n_used, %ids_s0, %ids_s1, %ids_span, %ids_noalias, %expert_i32) : (index, index, index, index, index, index, buffer, i32) -> (i1, i1)
        // The expert 0 workgroups also write the zero columns of skipped pairs.
        %writes_zero = scalar.andi %skipped, %zeroes_skipped : i1
        scf.if %writes_zero {
          func.call @ggml_hrx_mmid_zero_column(%dst_noalias, %d_span, %pair, %n_used, %d_s1, %d_s2, %tile_row0, %n_rows) : (buffer, index, index, index, index, index, index, index)
        }
        %count_inc = scf.select %matches, %c1_i32, %c0_i32 : i32
        %count_next = scalar.addi %count_acc, %count_inc : i32
        scf.yield %count_next : i32
      }
      // The exclusive prefix sum keeps the pairs in order in the list.
      view.store %match_count, %count_view[%t] : i32, view<64xi32>
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %list_begin = scf.for %ci = [%c0 to %t step %c1](%prefix = %c0_i32 : i32) -> (i32) {
        %prefix_count = view.load %count_view[%ci] : view<64xi32> -> i32
        %prefix_next = scalar.addi %prefix, %prefix_count : i32
        scf.yield %prefix_next : i32
      }
      %route_total = scf.for %ti = [%c0 to %c64 step %c1](%total = %c0_i32 : i32) -> (i32) {
        %total_count = view.load %count_view[%ti] : view<64xi32> -> i32
        %total_next = scalar.addi %total, %total_count : i32
        scf.yield %total_next : i32
      }
      %route_count = index.cast %route_total : i32 to index
      %list_end = scf.for %list_j = [%c0 to %c8 step %c1](%list_pos = %list_begin : i32) -> (i32) {
        %list_pair = index.add %pair_begin, %list_j : index
        %list_matches, %list_skipped = func.call @ggml_hrx_mmid_route(%list_pair, %n_pairs, %n_used, %ids_s0, %ids_s1, %ids_span, %ids_noalias, %expert_i32) : (index, index, index, index, index, index, buffer, i32) -> (i1, i1)
        scf.if %list_matches {
          %pair_i32 = index.cast %list_pair : index to i32
          %list_index = index.cast %list_pos : i32 to index
          %list_off = index.assume %list_index [range(%list_index, 0, 2147483646)] : index
          %list_ok = index.cmp ult, %list_off, %c512 : index
          scf.if %list_ok {
            view.store %pair_i32, %list_view[%list_off] : i32, view<512xi32>
          }
        }
        %pos_inc = scf.select %list_matches, %c1_i32, %c0_i32 : i32
        %list_next = scalar.addi %list_pos, %pos_inc : i32
        scf.yield %list_next : i32
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

      // Barriers need provably uniform control flow. A loaded count is not provably uniform.
      // Thus the chunk loop runs to the window size, and a subgroup vote skips chunks past the route count.
      // The workgroup is one subgroup. Thus subgroup-scope barriers order all its workgroup memory accesses.
      %window_rest = index.sub %n_pairs, %window : index
      %window_pairs = index.min %window_rest, %c512 : index
      scf.for %chunk = [%c0 to %window_pairs step %c16] {
        %chunk_has_routes = index.cmp ult, %chunk, %route_count : index
        %chunk_active = kernel.subgroup.vote.any %chunk_has_routes : i1
        scf.if %chunk_active {
          scf.if %is_base_writer {
            %list_i = index.add %chunk, %t : index
            %x_base, %d_base = func.call @ggml_hrx_mmid_pair_bases(%list_stage, %list_i, %route_count, %n_used, %x_ne1, %x_s1, %x_s2, %d_s1, %d_s2) : (buffer, index, index, index, index, index, index, index, index) -> (i32, i32)
            view.store %x_base, %x_base_view[%t] : i32, view<16xi32>
            view.store %d_base, %d_base_view[%t] : i32, view<16xi32>
          }
          kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
          %acc0, %acc1, %acc2, %acc3 = func.call @ggml_hrx_mmid_tile(%wtype, %k_size, %w_base, %w_valid, %x_s0, %w_span, %x_span, %weight_noalias, %input_noalias, %w_stage, %x_stage, %x_bases) : (index, index, index, i1, index, index, index, buffer, buffer, buffer, buffer, buffer) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
          func.call @ggml_hrx_mmid_store_column(%dst_noalias, %d_span, %d_bases, %out_col0, %out_row, %n_rows, %acc0) : (buffer, index, buffer, index, index, index, vector<4xf32>)
          func.call @ggml_hrx_mmid_store_column(%dst_noalias, %d_span, %d_bases, %out_col1, %out_row, %n_rows, %acc1) : (buffer, index, buffer, index, index, index, vector<4xf32>)
          func.call @ggml_hrx_mmid_store_column(%dst_noalias, %d_span, %d_bases, %out_col2, %out_row, %n_rows, %acc2) : (buffer, index, buffer, index, index, index, vector<4xf32>)
          func.call @ggml_hrx_mmid_store_column(%dst_noalias, %d_span, %d_bases, %out_col3, %out_row, %n_rows, %acc3) : (buffer, index, buffer, index, index, index, vector<4xf32>)
          // The next chunk writes the column bases again.
          kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
        }
      }
      // The next window writes the counts and the list again.
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    }
  }
  kernel.return
}
