// Plain ggml block_q6_K layout. See dequantize_row_q6_K in ggml-quants.c.

template.decl @ggml.f16.bits_f32(%bits: i16) -> (f32)

template.decl @ggml.mem.half(%weight: buffer, %span: index, %index: index) -> (i16)

template.decl @ggml.mem.half_word(%weight: buffer, %span: index, %index: index) -> (vector<1xi32>)

template.decl @ggml.mem.halves8_clamped(%weight: buffer, %w_span: index, %index: index) -> (vector<8xi16>)

func.decl @ggml_kq_affine8(%q: vector<2xi32>, %d_scale: f32, %neg_min: f32) -> (vector<8xf16>)

func.decl @ggml_kq_affine_dot16(%codes: vector<4xi32>, %x: vector<16xf32>, %scale: f32, %bias: f32) -> (f32)

template.decl @ggml.u8.affine4(%word: i32, %scale: f32, %bias: f32) -> (vector<4xf32>)

template.decl @ggml.weight.block(%wtype: index) -> (index, index)

template.def<@ggml.weight.block> device @ggml_q6_k_block_shape(%wtype: index) -> (index, index) where [eq(%wtype, 6)] {
  %values = index.constant 256 : index
  %units = index.constant 105 : index
  template.return %values, %units : index, index
}

template.decl @ggml.weight.values4(%wtype: index, %weight: buffer, %w_span: index, %block_base: index, %j: index) -> (vector<4xf32>)

// j is a multiple of 4 and below 256.
template.def<@ggml.weight.values4> device @ggml_q6_k_values4(%wtype: index, %weight: buffer, %w_span: index, %block_base: index, %j: index) -> (vector<4xf32>) where [eq(%wtype, 6)] {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c104 = index.constant 104 : index
  %c128 = index.constant 128 : index
  %c4_i32 = scalar.constant 4 : i32
  %low_mask = vector.splati 252645135 : vector<1xi32>
  %high_mask = vector.splati 50529027 : vector<1xi32>
  %bias = vector.splatf 32.0 : vector<4xf32>
  %h = index.div %j, %c128 : index
  %r = index.rem %j, %c128 : index
  %q = index.div %r, %c32 : index
  %l = index.rem %r, %c32 : index
  %q_odd = index.rem %q, %c2 : index
  %q_high = index.div %q, %c2 : index
  %ql_h = index.mul %h, %c64 : index
  %ql_q = index.mul %q_odd, %c32 : index
  %ql_byte0 = index.add %ql_h, %ql_q : index
  %ql_byte = index.add %ql_byte0, %l : index
  %ql_half = index.div %ql_byte, %c2 : index
  %ql_index = index.add %block_base, %ql_half : index
  %ql_word = template.apply<@ggml.mem.half_word>(%weight, %w_span, %ql_index) : (buffer, index, index) -> (vector<1xi32>)
  %ql_shift_index = index.mul %q_high, %c4 : index
  %ql_shift_i32 = index.cast %ql_shift_index : index to i32
  %ql_shift = vector.splat %ql_shift_i32 : vector<1xi32>
  %ql_shifted = vector.shrui %ql_word, %ql_shift : vector<1xi32>
  %low_q = vector.andi %ql_shifted, %low_mask : vector<1xi32>
  %qh_h = index.mul %h, %c32 : index
  %qh_byte = index.add %qh_h, %l : index
  %qh_half0 = index.div %qh_byte, %c2 : index
  %qh_half = index.add %qh_half0, %c64 : index
  %qh_index = index.add %block_base, %qh_half : index
  %qh_word = template.apply<@ggml.mem.half_word>(%weight, %w_span, %qh_index) : (buffer, index, index) -> (vector<1xi32>)
  %qh_shift_index = index.mul %q, %c2 : index
  %qh_shift_i32 = index.cast %qh_shift_index : index to i32
  %qh_shift = vector.splat %qh_shift_i32 : vector<1xi32>
  %qh_shifted = vector.shrui %qh_word, %qh_shift : vector<1xi32>
  %qh_bits = vector.andi %qh_shifted, %high_mask : vector<1xi32>
  %four = vector.splat %c4_i32 : vector<1xi32>
  %high_q = vector.shli %qh_bits, %four : vector<1xi32>
  %q_word = vector.ori %low_q, %high_q : vector<1xi32>
  %q_i8 = vector.bitcast %q_word : vector<1xi32> to vector<4xi8>
  %q_f32 = vector.uitofp %q_i8 : vector<4xi8> to vector<4xf32>
  %q_centered = vector.subf %q_f32, %bias : vector<4xf32>
  %sc_h = index.mul %h, %c8 : index
  %sc_q = index.mul %q, %c2 : index
  %sc_l = index.div %l, %c16 : index
  %sc_byte0 = index.add %sc_h, %sc_q : index
  %sc_byte = index.add %sc_byte0, %sc_l : index
  %sc_half0 = index.div %sc_byte, %c2 : index
  %sc_half = index.add %sc_half0, %c96 : index
  %sc_index = index.add %block_base, %sc_half : index
  %sc_bits = template.apply<@ggml.mem.half>(%weight, %w_span, %sc_index) : (buffer, index, index) -> (i16)
  %sc_pair_vector = vector.from_elements %sc_bits : vector<1xi16>
  %sc_pair = vector.bitcast %sc_pair_vector : vector<1xi16> to vector<2xi8>
  %sc_even = vector.extract %sc_pair[0] : vector<2xi8> -> i8
  %sc_odd = vector.extract %sc_pair[1] : vector<2xi8> -> i8
  %sc_parity = index.rem %sc_byte, %c2 : index
  %sc_is_odd = index.cmp eq, %sc_parity, %c1 : index
  %sc_i8 = scf.select %sc_is_odd, %sc_odd, %sc_even : i8
  %sc = scalar.sitofp %sc_i8 : i8 to f32
  %d_index = index.add %block_base, %c104 : index
  %d_bits = template.apply<@ggml.mem.half>(%weight, %w_span, %d_index) : (buffer, index, index) -> (i16)
  %d = template.apply<@ggml.f16.bits_f32>(%d_bits) : (i16) -> (f32)
  %d_scale = scalar.mulf %d, %sc : f32
  %d_scale_vector = vector.splat %d_scale : vector<4xf32>
  %result = vector.mulf %q_centered, %d_scale_vector : vector<4xf32>
  template.return %result : vector<4xf32>
}

template.decl @ggml.weight.superblock(%wtype: index) -> (offset, offset, index)

template.def<@ggml.weight.superblock> device @ggml_q6_k_superblock(%wtype: index) -> (offset, offset, index) where [eq(%wtype, 6)] {
  %unit = index.constant 2 : offset
  %sb = index.constant 210 : offset
  %units = index.constant 105 : index
  template.return %unit, %sb, %units : offset, offset, index
}

func.def inline @ggml_q6_k_s8_at(%word: i32, %index: i32) -> (f32) {
  %c8_i32 = scalar.constant 8 : i32
  %c24_i32 = scalar.constant 24 : i32
  %bit = scalar.muli %index, %c8_i32 : i32
  %left = scalar.subi %c24_i32, %bit : i32
  %high = scalar.shli %word, %left : i32
  %value = scalar.shrsi %high, %c24_i32 : i32
  %result = scalar.sitofp %value : i32 to f32
  func.return %result : f32
}

template.decl @ggml.weight.part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)

template.def<@ggml.weight.part16> device @ggml_q6_k_part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index) where [eq(%wtype, 6)] {
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %b128 = index.constant 128 : offset
  %b192 = index.constant 192 : offset
  %b208 = index.constant 208 : offset
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c6_i32 = scalar.constant 6 : i32
  %nibbles = scalar.constant 252645135 : i32
  %pairs = scalar.constant 50529027 : i32
  %bias = scalar.constant -32.0 : f32
  %part_in = index.assume %part [range(%part, 0, 15)] : index
  %h = index.div %part_in, %c8 : index
  %v = index.rem %part_in, %c8 : index
  %ql_view = buffer.view %weight[%sb_byte] : buffer -> view<32xi32>
  %qh_byte = index.add %sb_byte, %b128 : offset
  %qh_view = buffer.view %weight[%qh_byte] : buffer -> view<16xi32>
  %sc_byte = index.add %sb_byte, %b192 : offset
  %sc_view = buffer.view %weight[%sc_byte] : buffer -> view<4xi32>
  %d_byte = index.add %sb_byte, %b208 : offset
  %d_view = buffer.view %weight[%d_byte] : buffer -> view<1xf16>
  %ql_index0a = index.mul %h, %c16 : index
  %ql_index0 = index.add %ql_index0a, %v : index
  %ql_index1 = index.add %ql_index0, %c8 : index
  %qh_index0 = index.mul %h, %c8 : index
  %qh_index = index.add %qh_index0, %v : index
  %sc_index = index.mul %h, %c2 : index
  %ql0 = view.load %ql_view[%ql_index0] : view<32xi32> -> i32
  %ql1 = view.load %ql_view[%ql_index1] : view<32xi32> -> i32
  %qh = view.load %qh_view[%qh_index] : view<16xi32> -> i32
  %sc = vector.load %sc_view[%sc_index] : view<4xi32> -> vector<2xi32>
  %d_half = view.load %d_view[%c0] : view<1xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %sc_word0 = vector.extract %sc[0] : vector<2xi32> -> i32
  %sc_word1 = vector.extract %sc[1] : vector<2xi32> -> i32
  %sub = index.div %v, %c4 : index
  %sub_i32 = index.cast %sub : index to i32
  %sub2_i32 = scalar.addi %sub_i32, %c2_i32 : i32
  %s0 = func.call @ggml_q6_k_s8_at(%sc_word0, %sub_i32) : (i32, i32) -> (f32)
  %s1 = func.call @ggml_q6_k_s8_at(%sc_word0, %sub2_i32) : (i32, i32) -> (f32)
  %s2 = func.call @ggml_q6_k_s8_at(%sc_word1, %sub_i32) : (i32, i32) -> (f32)
  %s3 = func.call @ggml_q6_k_s8_at(%sc_word1, %sub2_i32) : (i32, i32) -> (f32)
  %ds0 = scalar.mulf %d, %s0 : f32
  %ds1 = scalar.mulf %d, %s1 : f32
  %ds2 = scalar.mulf %d, %s2 : f32
  %ds3 = scalar.mulf %d, %s3 : f32
  %bias0 = scalar.mulf %ds0, %bias : f32
  %bias1 = scalar.mulf %ds1, %bias : f32
  %bias2 = scalar.mulf %ds2, %bias : f32
  %bias3 = scalar.mulf %ds3, %bias : f32
  %ql0_hi = scalar.shrui %ql0, %c4_i32 : i32
  %ql1_hi = scalar.shrui %ql1, %c4_i32 : i32
  %l0 = scalar.andi %ql0, %nibbles : i32
  %l1 = scalar.andi %ql1, %nibbles : i32
  %l2 = scalar.andi %ql0_hi, %nibbles : i32
  %l3 = scalar.andi %ql1_hi, %nibbles : i32
  %qh1 = scalar.shrui %qh, %c2_i32 : i32
  %qh2 = scalar.shrui %qh, %c4_i32 : i32
  %qh3 = scalar.shrui %qh, %c6_i32 : i32
  %u0a = scalar.andi %qh, %pairs : i32
  %u1a = scalar.andi %qh1, %pairs : i32
  %u2a = scalar.andi %qh2, %pairs : i32
  %u3a = scalar.andi %qh3, %pairs : i32
  %u0 = scalar.shli %u0a, %c4_i32 : i32
  %u1 = scalar.shli %u1a, %c4_i32 : i32
  %u2 = scalar.shli %u2a, %c4_i32 : i32
  %u3 = scalar.shli %u3a, %c4_i32 : i32
  %q0 = scalar.ori %l0, %u0 : i32
  %q1 = scalar.ori %l1, %u1 : i32
  %q2 = scalar.ori %l2, %u2 : i32
  %q3 = scalar.ori %l3, %u3 : i32
  %w0 = template.apply<@ggml.u8.affine4>(%q0, %ds0, %bias0) : (i32, f32, f32) -> (vector<4xf32>)
  %w1 = template.apply<@ggml.u8.affine4>(%q1, %ds1, %bias1) : (i32, f32, f32) -> (vector<4xf32>)
  %w2 = template.apply<@ggml.u8.affine4>(%q2, %ds2, %bias2) : (i32, f32, f32) -> (vector<4xf32>)
  %w3 = template.apply<@ggml.u8.affine4>(%q3, %ds3, %bias3) : (i32, f32, f32) -> (vector<4xf32>)
  %o_h = index.mul %h, %c128 : index
  %o_v = index.mul %v, %c4 : index
  %o0 = index.add %o_h, %o_v : index
  %o1 = index.add %o0, %c32 : index
  %o2 = index.add %o0, %c64 : index
  %o3 = index.add %o1, %c64 : index
  template.return %w0, %w1, %w2, %w3, %o0, %o1, %o2, %o3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index
}

template.decl @ggml.weight.offsets16(%wtype: index, %part: index) -> (index, index, index, index)

template.def<@ggml.weight.offsets16> device @ggml_q6_k_offsets16(%wtype: index, %part: index) -> (index, index, index, index) where [eq(%wtype, 6)] {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %part_in = index.assume %part [range(%part, 0, 15)] : index
  %h = index.div %part_in, %c8 : index
  %v = index.rem %part_in, %c8 : index
  %o_h = index.mul %h, %c128 : index
  %o_v = index.mul %v, %c4 : index
  %o0 = index.add %o_h, %o_v : index
  %o1 = index.add %o0, %c32 : index
  %o2 = index.add %o0, %c64 : index
  %o3 = index.add %o1, %c64 : index
  template.return %o0, %o1, %o2, %o3 : index, index, index, index
}

template.decl @ggml.weight.wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>)

template.def<@ggml.weight.wmma16> device @ggml_q6_k_wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>) where [eq(%wtype, 6)] {
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c104 = index.constant 104 : index
  %c105 = index.constant 105 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %c0_i16 = scalar.constant 0 : i16
  %minus_32 = scalar.constant -32.0 : f32
  %zero4 = vector.splati 0 : vector<4xi16>
  %zero2 = vector.splati 0 : vector<2xi16>
  %nibble_mask = vector.splati 252645135 : vector<2xi32>
  %pair_mask = vector.splati 50529027 : vector<2xi32>
  %four = vector.splati 4 : vector<2xi32>
  %halves = buffer.view %weight[%c0_offset] : buffer -> view<[%w_span]xi16>
  // k is below K, and K is below 2^31.
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %block = index.div %k_bounded, %c256 : index
  %j = index.rem %k_bounded, %c256 : index
  %h = index.div %j, %c128 : index
  %j_in_half = index.rem %j, %c128 : index
  %q0 = index.div %j_in_half, %c32 : index
  %block_offset = index.mul %block, %c105 : index
  %block_base0 = index.add %row_base, %block_offset : index
  %block_base = index.assume %block_base0 [range(%block_base0, 0, 2147483500)] : index
  %part_halves = index.mul %part, %c4 : index
  %ql_h = index.mul %h, %c32 : index
  %ql_local = index.add %ql_h, %part_halves : index
  %ql_low_index = index.add %block_base, %ql_local : index
  %ql_high_index = index.add %ql_low_index, %c16 : index
  %qh_h = index.mul %h, %c16 : index
  %qh_local0 = index.add %qh_h, %part_halves : index
  %qh_local = index.add %qh_local0, %c64 : index
  %qh_index = index.add %block_base, %qh_local : index
  %sc_h = index.mul %h, %c4 : index
  %sc_local0 = index.add %sc_h, %q0 : index
  %sc_local = index.add %sc_local0, %c96 : index
  %sc_index = index.add %block_base, %sc_local : index
  %d_index = index.add %block_base, %c104 : index
  %ql_low, %ql_high, %qh, %sc, %d_bits = scf.if %row_valid -> (vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<2xi16>, i16) {
    %in_span = index.cmp ult, %d_index, %w_span : index
    %l_low, %l_high, %l_qh, %l_sc, %l_d = scf.if %in_span -> (vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<2xi16>, i16) {
      %v_low = vector.load %halves[%ql_low_index] : view<[%w_span]xi16> -> vector<4xi16>
      %v_high = vector.load %halves[%ql_high_index] : view<[%w_span]xi16> -> vector<4xi16>
      %v_qh = vector.load %halves[%qh_index] : view<[%w_span]xi16> -> vector<4xi16>
      %v_sc = vector.load %halves[%sc_index] : view<[%w_span]xi16> -> vector<2xi16>
      %v_d = view.load %halves[%d_index] : view<[%w_span]xi16> -> i16
      scf.yield %v_low, %v_high, %v_qh, %v_sc, %v_d : vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<2xi16>, i16
    } else {
      scf.yield %zero4, %zero4, %zero4, %zero2, %c0_i16 : vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<2xi16>, i16
    }
    scf.yield %l_low, %l_high, %l_qh, %l_sc, %l_d : vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<2xi16>, i16
  } else {
    scf.yield %zero4, %zero4, %zero4, %zero2, %c0_i16 : vector<4xi16>, vector<4xi16>, vector<4xi16>, vector<2xi16>, i16
  }
  %ql_shift_index = index.mul %q0, %c2 : index
  %ql_shift_i32 = index.cast %ql_shift_index : index to i32
  %ql_shift = vector.splat %ql_shift_i32 : vector<2xi32>
  %qh_shift_low_i32 = index.cast %ql_shift_index : index to i32
  %qh_shift_high_index = index.add %ql_shift_index, %c2 : index
  %qh_shift_high_i32 = index.cast %qh_shift_high_index : index to i32
  %qh_shift_low = vector.splat %qh_shift_low_i32 : vector<2xi32>
  %qh_shift_high = vector.splat %qh_shift_high_i32 : vector<2xi32>
  %ql_low_words = vector.bitcast %ql_low : vector<4xi16> to vector<2xi32>
  %ql_high_words = vector.bitcast %ql_high : vector<4xi16> to vector<2xi32>
  %qh_words = vector.bitcast %qh : vector<4xi16> to vector<2xi32>
  %low_shifted = vector.shrui %ql_low_words, %ql_shift : vector<2xi32>
  %high_shifted = vector.shrui %ql_high_words, %ql_shift : vector<2xi32>
  %low_q4 = vector.andi %low_shifted, %nibble_mask : vector<2xi32>
  %high_q4 = vector.andi %high_shifted, %nibble_mask : vector<2xi32>
  %qh_low_shifted = vector.shrui %qh_words, %qh_shift_low : vector<2xi32>
  %qh_high_shifted = vector.shrui %qh_words, %qh_shift_high : vector<2xi32>
  %qh_low_bits = vector.andi %qh_low_shifted, %pair_mask : vector<2xi32>
  %qh_high_bits = vector.andi %qh_high_shifted, %pair_mask : vector<2xi32>
  %qh_low = vector.shli %qh_low_bits, %four : vector<2xi32>
  %qh_high = vector.shli %qh_high_bits, %four : vector<2xi32>
  %low_q = vector.ori %low_q4, %qh_low : vector<2xi32>
  %high_q = vector.ori %high_q4, %qh_high : vector<2xi32>
  %sc_bytes = vector.bitcast %sc : vector<2xi16> to vector<4xi8>
  %sc_low_even = vector.extract %sc_bytes[0] : vector<4xi8> -> i8
  %sc_low_odd = vector.extract %sc_bytes[1] : vector<4xi8> -> i8
  %sc_high_even = vector.extract %sc_bytes[2] : vector<4xi8> -> i8
  %sc_high_odd = vector.extract %sc_bytes[3] : vector<4xi8> -> i8
  %sc_parity = index.div %part, %c2 : index
  %sc_odd = index.cmp ne, %sc_parity, %c0 : index
  %sc_low_i8 = scf.select %sc_odd, %sc_low_odd, %sc_low_even : i8
  %sc_high_i8 = scf.select %sc_odd, %sc_high_odd, %sc_high_even : i8
  %sc_low_f32 = scalar.sitofp %sc_low_i8 : i8 to f32
  %sc_high_f32 = scalar.sitofp %sc_high_i8 : i8 to f32
  %d_vector = vector.from_elements %d_bits : vector<1xi16>
  %d_half_vector = vector.bitcast %d_vector : vector<1xi16> to vector<1xf16>
  %d_half = vector.extract %d_half_vector[0] : vector<1xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %ds_low = scalar.mulf %d, %sc_low_f32 : f32
  %ds_high = scalar.mulf %d, %sc_high_f32 : f32
  %bias_low = scalar.mulf %ds_low, %minus_32 : f32
  %bias_high = scalar.mulf %ds_high, %minus_32 : f32
  %low = func.call @ggml_kq_affine8(%low_q, %ds_low, %bias_low) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  %high = func.call @ggml_kq_affine8(%high_q, %ds_high, %bias_high) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  template.return %low, %high : vector<8xf16>, vector<8xf16>
}

func.def inline @ggml_q6_k_scale(%bits: i16, %odd: i1) -> (f32) {
  %pair_vector = vector.from_elements %bits : vector<1xi16>
  %pair = vector.bitcast %pair_vector : vector<1xi16> to vector<2xi8>
  %even_scale = vector.extract %pair[0] : vector<2xi8> -> i8
  %odd_scale = vector.extract %pair[1] : vector<2xi8> -> i8
  %selected = scf.select %odd, %odd_scale, %even_scale : i8
  %scale = scalar.sitofp %selected : i8 to f32
  func.return %scale : f32
}

template.decl @ggml.weight.block_dot(%wtype: index, %weight: buffer, %n_wb: index, %wb: index, %input: buffer, %n_xb: index, %xb: index, %p: index) -> (f32)

// Returns zero when a block is outside its span. All loads of the packet issue before the first use.
template.def<@ggml.weight.block_dot> device @ggml_q6_k_block_dot(%wtype: index, %weight: buffer, %n_wb: index, %wb: index, %input: buffer, %n_xb: index, %xb: index, %p: index) -> (f32) where [eq(%wtype, 6)] {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c104 = index.constant 104 : index
  %c128 = index.constant 128 : index
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c0_offset = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %minus_32 = scalar.constant -32.0 : f32
  %low_mask = vector.splati 252645135 : vector<4xi32>
  %high_mask = vector.splati 50529027 : vector<4xi32>
  %four = vector.splati 4 : vector<4xi32>
  %h = index.div %p, %c4 : index
  %p_in_h = index.rem %p, %c4 : index
  %r = index.div %p_in_h, %c2 : index
  %l_part = index.rem %p, %c2 : index
  %x_h = index.mul %h, %c128 : index
  %x_r = index.mul %r, %c32 : index
  %x_l = index.mul %l_part, %c16 : index
  %x_a0 = index.add %x_h, %x_r : index
  %x_a_raw = index.add %x_a0, %x_l : index
  %x_a_off = index.assume %x_a_raw [range(%x_a_raw, 0, 176)] : index
  %x_b_raw = index.add %x_a_off, %c64 : index
  %x_b_off = index.assume %x_b_raw [range(%x_b_raw, 64, 240)] : index
  %ql_h = index.mul %h, %c32 : index
  %ql_r = index.mul %r, %c16 : index
  %l_halves = index.mul %l_part, %c8 : index
  %ql_0 = index.add %ql_h, %ql_r : index
  %ql_raw = index.add %ql_0, %l_halves : index
  %ql_off = index.assume %ql_raw [range(%ql_raw, 0, 56)] : index
  %qh_h = index.mul %h, %c16 : index
  %qh_0 = index.add %qh_h, %l_halves : index
  %qh_raw = index.add %qh_0, %c64 : index
  %qh_off = index.assume %qh_raw [range(%qh_raw, 64, 88)] : index
  %s_h = index.mul %h, %c8 : index
  %s_r = index.mul %r, %c2 : index
  %s_a0 = index.add %s_h, %s_r : index
  %s_a = index.add %s_a0, %l_part : index
  %s_b = index.add %s_a, %c4 : index
  %sa_half = index.div %s_a, %c2 : index
  %sb_half = index.div %s_b, %c2 : index
  %sa_raw = index.add %sa_half, %c96 : index
  %sa_off = index.assume %sa_raw [range(%sa_raw, 96, 103)] : index
  %sb_raw = index.add %sb_half, %c96 : index
  %sb_off = index.assume %sb_raw [range(%sb_raw, 96, 103)] : index
  %odd = index.cmp eq, %l_part, %c1 : index
  %x_view = buffer.view %input[%c0_offset] : buffer -> view<[%n_xb]x256xf32>
  %xb_ok = index.cmp ult, %xb, %n_xb : index
  %wb_ok = index.cmp ult, %wb, %n_wb : index
  %dot = scf.if %wb_ok -> (f32) {
    %x_dot = scf.if %xb_ok -> (f32) {
      %w6 = buffer.view %weight[%c0_offset] : buffer -> view<[%n_wb]x105xi16>
      %ql_halves = vector.load %w6[%wb, %ql_off] : view<[%n_wb]x105xi16> -> vector<8xi16>
      %qh_halves = vector.load %w6[%wb, %qh_off] : view<[%n_wb]x105xi16> -> vector<8xi16>
      %sa_bits = view.load %w6[%wb, %sa_off] : view<[%n_wb]x105xi16> -> i16
      %sb_bits = view.load %w6[%wb, %sb_off] : view<[%n_wb]x105xi16> -> i16
      %d_bits = view.load %w6[%wb, %c104] : view<[%n_wb]x105xi16> -> i16
      %x_a = vector.load %x_view[%xb, %x_a_off] : view<[%n_xb]x256xf32> -> vector<16xf32>
      %x_b = vector.load %x_view[%xb, %x_b_off] : view<[%n_xb]x256xf32> -> vector<16xf32>
      %ql = vector.bitcast %ql_halves : vector<8xi16> to vector<4xi32>
      %qh = vector.bitcast %qh_halves : vector<8xi16> to vector<4xi32>
      %r_i32 = index.cast %r : index to i32
      %shift_a_i32 = scalar.muli %r_i32, %c2_i32 : i32
      %shift_b_i32 = scalar.addi %shift_a_i32, %c4_i32 : i32
      %shift_a = vector.splat %shift_a_i32 : vector<4xi32>
      %shift_b = vector.splat %shift_b_i32 : vector<4xi32>
      %ql_b_shifted = vector.shrui %ql, %four : vector<4xi32>
      %low_a = vector.andi %ql, %low_mask : vector<4xi32>
      %low_b = vector.andi %ql_b_shifted, %low_mask : vector<4xi32>
      %qh_a_shifted = vector.shrui %qh, %shift_a : vector<4xi32>
      %qh_b_shifted = vector.shrui %qh, %shift_b : vector<4xi32>
      %high_a_bits = vector.andi %qh_a_shifted, %high_mask : vector<4xi32>
      %high_b_bits = vector.andi %qh_b_shifted, %high_mask : vector<4xi32>
      %high_a = vector.shli %high_a_bits, %four : vector<4xi32>
      %high_b = vector.shli %high_b_bits, %four : vector<4xi32>
      %q_a = vector.ori %low_a, %high_a : vector<4xi32>
      %q_b = vector.ori %low_b, %high_b : vector<4xi32>
      %sc_a = func.call @ggml_q6_k_scale(%sa_bits, %odd) : (i16, i1) -> (f32)
      %sc_b = func.call @ggml_q6_k_scale(%sb_bits, %odd) : (i16, i1) -> (f32)
      %d = template.apply<@ggml.f16.bits_f32>(%d_bits) : (i16) -> (f32)
      %scale_a = scalar.mulf %d, %sc_a : f32
      %scale_b = scalar.mulf %d, %sc_b : f32
      %bias_a = scalar.mulf %scale_a, %minus_32 : f32
      %bias_b = scalar.mulf %scale_b, %minus_32 : f32
      %dot_a = func.call @ggml_kq_affine_dot16(%q_a, %x_a, %scale_a, %bias_a) : (vector<4xi32>, vector<16xf32>, f32, f32) -> (f32)
      %dot_b = func.call @ggml_kq_affine_dot16(%q_b, %x_b, %scale_b, %bias_b) : (vector<4xi32>, vector<16xf32>, f32, f32) -> (f32)
      %dot6 = scalar.addf %dot_a, %dot_b : f32
      scf.yield %dot6 : f32
    } else {
      scf.yield %zero : f32
    }
    scf.yield %x_dot : f32
  } else {
    scf.yield %zero : f32
  }
  template.return %dot : f32
}

template.decl @ggml.q6_k.block(%weight: buffer, %w_span: index, %row_base: index, %k: index, %p: index) -> (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>)

template.def<@ggml.q6_k.block> device @ggml_q6_k_block(%weight: buffer, %w_span: index, %row_base: index, %k: index, %p: index) -> (vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>) {
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c80 = index.constant 80 : index
  %c96 = index.constant 96 : index
  %c97 = index.constant 97 : index
  %c105 = index.constant 105 : index
  %c256 = index.constant 256 : index
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %block = index.div %k_bounded, %c256 : index
  %block_offset = index.mul %block, %c105 : index
  %block_base0 = index.add %row_base, %block_offset : index
  %block_base = index.assume %block_base0 [range(%block_base0, 0, 2147483500)] : index
  %p_halves = index.mul %p, %c8 : index
  %part_base = index.add %block_base, %p_halves : index
  %i1 = index.add %part_base, %c16 : index
  %i2 = index.add %part_base, %c32 : index
  %i3 = index.add %part_base, %c48 : index
  %i4 = index.add %part_base, %c64 : index
  %i5 = index.add %part_base, %c80 : index
  %i6 = index.add %block_base, %c96 : index
  %i7 = index.add %block_base, %c97 : index
  %r0 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %part_base) : (buffer, index, index) -> (vector<8xi16>)
  %r1 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %i1) : (buffer, index, index) -> (vector<8xi16>)
  %r2 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %i2) : (buffer, index, index) -> (vector<8xi16>)
  %r3 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %i3) : (buffer, index, index) -> (vector<8xi16>)
  %r4 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %i4) : (buffer, index, index) -> (vector<8xi16>)
  %r5 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %i5) : (buffer, index, index) -> (vector<8xi16>)
  %r6 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %i6) : (buffer, index, index) -> (vector<8xi16>)
  %r7 = template.apply<@ggml.mem.halves8_clamped>(%weight, %w_span, %i7) : (buffer, index, index) -> (vector<8xi16>)
  template.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 : vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>, vector<8xi16>
}

func.def inline @ggml_q6_k_decode16(%ql_low: vector<4xi16>, %ql_high: vector<4xi16>, %qh: vector<4xi16>, %q0: index, %ds_low: f32, %ds_high: f32) -> (vector<8xf16>, vector<8xf16>) {
  %c2 = index.constant 2 : index
  %minus_32 = scalar.constant -32.0 : f32
  %nibble_mask = vector.splati 252645135 : vector<2xi32>
  %pair_mask = vector.splati 50529027 : vector<2xi32>
  %four = vector.splati 4 : vector<2xi32>
  %ql_shift_index = index.mul %q0, %c2 : index
  %ql_shift_i32 = index.cast %ql_shift_index : index to i32
  %ql_shift = vector.splat %ql_shift_i32 : vector<2xi32>
  %qh_shift_high_index = index.add %ql_shift_index, %c2 : index
  %qh_shift_high_i32 = index.cast %qh_shift_high_index : index to i32
  %qh_shift_high = vector.splat %qh_shift_high_i32 : vector<2xi32>
  %ql_low_words = vector.bitcast %ql_low : vector<4xi16> to vector<2xi32>
  %ql_high_words = vector.bitcast %ql_high : vector<4xi16> to vector<2xi32>
  %qh_words = vector.bitcast %qh : vector<4xi16> to vector<2xi32>
  %low_shifted = vector.shrui %ql_low_words, %ql_shift : vector<2xi32>
  %high_shifted = vector.shrui %ql_high_words, %ql_shift : vector<2xi32>
  %low_q4 = vector.andi %low_shifted, %nibble_mask : vector<2xi32>
  %high_q4 = vector.andi %high_shifted, %nibble_mask : vector<2xi32>
  %qh_low_shifted = vector.shrui %qh_words, %ql_shift : vector<2xi32>
  %qh_high_shifted = vector.shrui %qh_words, %qh_shift_high : vector<2xi32>
  %qh_low_bits = vector.andi %qh_low_shifted, %pair_mask : vector<2xi32>
  %qh_high_bits = vector.andi %qh_high_shifted, %pair_mask : vector<2xi32>
  %qh_low = vector.shli %qh_low_bits, %four : vector<2xi32>
  %qh_high = vector.shli %qh_high_bits, %four : vector<2xi32>
  %low_q = vector.ori %low_q4, %qh_low : vector<2xi32>
  %high_q = vector.ori %high_q4, %qh_high : vector<2xi32>
  %bias_low = scalar.mulf %ds_low, %minus_32 : f32
  %bias_high = scalar.mulf %ds_high, %minus_32 : f32
  %low = func.call @ggml_kq_affine8(%low_q, %ds_low, %bias_low) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  %high = func.call @ggml_kq_affine8(%high_q, %ds_high, %bias_high) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  func.return %low, %high : vector<8xf16>, vector<8xf16>
}

template.decl @ggml.q6_k.decode32_f16(%ql_first: vector<8xi16>, %ql_second: vector<8xi16>, %qh: vector<8xi16>, %scales: vector<8xi16>, %tail: vector<8xi16>, %c: index, %p: index) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)

// The chunk index c is a constant below 4. The result order is the order of @ggml.kq.decode32_f16.
template.def<@ggml.q6_k.decode32_f16> device @ggml_q6_k_decode32_f16(%ql_first: vector<8xi16>, %ql_second: vector<8xi16>, %qh: vector<8xi16>, %scales: vector<8xi16>, %tail: vector<8xi16>, %c: index, %p: index) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %h = index.div %c, %c2 : index
  %c_odd = index.rem %c, %c2 : index
  %q0 = index.mul %c_odd, %c2 : index
  %h8 = index.mul %h, %c8 : index
  %q0x2 = index.mul %q0, %c2 : index
  %sc_low_index = index.add %h8, %q0x2 : index
  %sc_low_index1 = index.add %sc_low_index, %c1 : index
  %sc_high_index = index.add %sc_low_index, %c2 : index
  %sc_high_index1 = index.add %sc_high_index, %c1 : index
  %sc_bytes = vector.bitcast %scales : vector<8xi16> to vector<16xi8>
  %sc_low_even = vector.extract %sc_bytes[%sc_low_index] : vector<16xi8> -> i8
  %sc_low_odd = vector.extract %sc_bytes[%sc_low_index1] : vector<16xi8> -> i8
  %sc_high_even = vector.extract %sc_bytes[%sc_high_index] : vector<16xi8> -> i8
  %sc_high_odd = vector.extract %sc_bytes[%sc_high_index1] : vector<16xi8> -> i8
  %odd = index.cmp ne, %p, %c0 : index
  %sc_low_i8 = scf.select %odd, %sc_low_odd, %sc_low_even : i8
  %sc_high_i8 = scf.select %odd, %sc_high_odd, %sc_high_even : i8
  %sc_low = scalar.sitofp %sc_low_i8 : i8 to f32
  %sc_high = scalar.sitofp %sc_high_i8 : i8 to f32
  %tail_halves = vector.bitcast %tail : vector<8xi16> to vector<8xf16>
  %d_half = vector.extract %tail_halves[7] : vector<8xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %ds_low = scalar.mulf %d, %sc_low : f32
  %ds_high = scalar.mulf %d, %sc_high : f32
  %ql_low0 = vector.slice %ql_first[0] : vector<8xi16> -> vector<4xi16>
  %ql_low1 = vector.slice %ql_first[4] : vector<8xi16> -> vector<4xi16>
  %ql_high0 = vector.slice %ql_second[0] : vector<8xi16> -> vector<4xi16>
  %ql_high1 = vector.slice %ql_second[4] : vector<8xi16> -> vector<4xi16>
  %qh0 = vector.slice %qh[0] : vector<8xi16> -> vector<4xi16>
  %qh1 = vector.slice %qh[4] : vector<8xi16> -> vector<4xi16>
  %p0_low, %p0_high = func.call @ggml_q6_k_decode16(%ql_low0, %ql_high0, %qh0, %q0, %ds_low, %ds_high) : (vector<4xi16>, vector<4xi16>, vector<4xi16>, index, f32, f32) -> (vector<8xf16>, vector<8xf16>)
  %p1_low, %p1_high = func.call @ggml_q6_k_decode16(%ql_low1, %ql_high1, %qh1, %q0, %ds_low, %ds_high) : (vector<4xi16>, vector<4xi16>, vector<4xi16>, index, f32, f32) -> (vector<8xf16>, vector<8xf16>)
  template.return %p0_low, %p0_high, %p1_low, %p1_high : vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>
}
