// Plain ggml block_q4_K and block_q5_K layouts. The two formats share the packing of the scales and mins.
// Providers of @ggml.weight.* select on the weight type (see matmul/lib/mm_core.loom).

template.decl @ggml.mem.word(%weight: buffer, %span: index, %index: index) -> (i32)

template.decl @ggml.mem.words4_clamped(%weight: buffer, %w_span: index, %index: index) -> (vector<4xi32>)

template.decl @ggml.u8.affine4(%word: i32, %scale: f32, %bias: f32) -> (vector<4xf32>)

template.decl @ggml.weight.block(%wtype: index) -> (index, index)

template.def<@ggml.weight.block> device @ggml_q4_k_block_shape(%wtype: index) -> (index, index) where [eq(%wtype, 2)] {
  %values = index.constant 256 : index
  %units = index.constant 36 : index
  template.return %values, %units : index, index
}

template.def<@ggml.weight.block> device @ggml_q5_k_block_shape(%wtype: index) -> (index, index) where [eq(%wtype, 5)] {
  %values = index.constant 256 : index
  %units = index.constant 44 : index
  template.return %values, %units : index, index
}

template.decl @ggml.weight.values4(%wtype: index, %weight: buffer, %w_span: index, %block_base: index, %j: index) -> (vector<4xf32>)

// j is a multiple of 4 and below 256.
template.def<@ggml.weight.values4> device @ggml_q4_k_values4(%wtype: index, %weight: buffer, %w_span: index, %block_base: index, %j: index) -> (vector<4xf32>) where [eq(%wtype, 2)] {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %q4_mask = vector.splati 252645135 : vector<1xi32>
  %group = index.div %j, %c32 : index
  %j_in_group = index.rem %j, %c32 : index
  %packet = index.div %j_in_group, %c4 : index
  %d_scale, %negative_minimum_scale = template.apply<@ggml.kq.group_affine>(%weight, %w_span, %block_base, %group) : (buffer, index, index, index) -> (f32, f32)
  %q_page0 = index.div %group, %c2 : index
  %q_page = index.mul %q_page0, %c8 : index
  %q_word_local0 = index.add %q_page, %packet : index
  %q_word_local = index.add %q_word_local0, %c4 : index
  %q_word_index = index.add %block_base, %q_word_local : index
  %q_word_scalar = template.apply<@ggml.mem.word>(%weight, %w_span, %q_word_index) : (buffer, index, index) -> (i32)
  %q_word = vector.from_elements %q_word_scalar : vector<1xi32>
  %q_half = index.rem %group, %c2 : index
  %q_shift_index = index.mul %q_half, %c4 : index
  %q_shift_i32 = index.cast %q_shift_index : index to i32
  %q_shift = vector.splat %q_shift_i32 : vector<1xi32>
  %shifted_q = vector.shrui %q_word, %q_shift : vector<1xi32>
  %masked_q = vector.andi %shifted_q, %q4_mask : vector<1xi32>
  %q_i8 = vector.bitcast %masked_q : vector<1xi32> to vector<4xi8>
  %q_f32 = vector.uitofp %q_i8 : vector<4xi8> to vector<4xf32>
  %d_scale_vector = vector.splat %d_scale : vector<4xf32>
  %minimum_vector = vector.splat %negative_minimum_scale : vector<4xf32>
  %result = vector.fmaf %q_f32, %d_scale_vector, %minimum_vector : vector<4xf32>
  template.return %result : vector<4xf32>
}

// j is a multiple of 4 and below 256.
template.def<@ggml.weight.values4> device @ggml_q5_k_values4(%wtype: index, %weight: buffer, %w_span: index, %block_base: index, %j: index) -> (vector<4xf32>) where [eq(%wtype, 5)] {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c32 = index.constant 32 : index
  %c4_i32 = scalar.constant 4 : i32
  %low_mask = vector.splati 252645135 : vector<1xi32>
  %bit_mask = vector.splati 16843009 : vector<1xi32>
  %group = index.div %j, %c32 : index
  %j_in_group = index.rem %j, %c32 : index
  %packet = index.div %j_in_group, %c4 : index
  %d_scale, %negative_minimum_scale = template.apply<@ggml.kq.group_affine>(%weight, %w_span, %block_base, %group) : (buffer, index, index, index) -> (f32, f32)
  %q_page0 = index.div %group, %c2 : index
  %q_page = index.mul %q_page0, %c8 : index
  %q_word_local0 = index.add %q_page, %packet : index
  %q_word_local = index.add %q_word_local0, %c12 : index
  %q_word_index = index.add %block_base, %q_word_local : index
  %q_word_scalar = template.apply<@ggml.mem.word>(%weight, %w_span, %q_word_index) : (buffer, index, index) -> (i32)
  %q_word = vector.from_elements %q_word_scalar : vector<1xi32>
  %q_half = index.rem %group, %c2 : index
  %q_shift_index = index.mul %q_half, %c4 : index
  %q_shift_i32 = index.cast %q_shift_index : index to i32
  %q_shift = vector.splat %q_shift_i32 : vector<1xi32>
  %shifted_q = vector.shrui %q_word, %q_shift : vector<1xi32>
  %low_q = vector.andi %shifted_q, %low_mask : vector<1xi32>
  %h_word_local = index.add %packet, %c4 : index
  %h_word_index = index.add %block_base, %h_word_local : index
  %h_word_scalar = template.apply<@ggml.mem.word>(%weight, %w_span, %h_word_index) : (buffer, index, index) -> (i32)
  %h_word = vector.from_elements %h_word_scalar : vector<1xi32>
  %h_shift_i32 = index.cast %group : index to i32
  %h_shift = vector.splat %h_shift_i32 : vector<1xi32>
  %shifted_h = vector.shrui %h_word, %h_shift : vector<1xi32>
  %h_bits = vector.andi %shifted_h, %bit_mask : vector<1xi32>
  %four = vector.splat %c4_i32 : vector<1xi32>
  %high_q = vector.shli %h_bits, %four : vector<1xi32>
  %q_word_full = vector.ori %low_q, %high_q : vector<1xi32>
  %q_i8 = vector.bitcast %q_word_full : vector<1xi32> to vector<4xi8>
  %q_f32 = vector.uitofp %q_i8 : vector<4xi8> to vector<4xf32>
  %d_scale_vector = vector.splat %d_scale : vector<4xf32>
  %minimum_vector = vector.splat %negative_minimum_scale : vector<4xf32>
  %result = vector.fmaf %q_f32, %d_scale_vector, %minimum_vector : vector<4xf32>
  template.return %result : vector<4xf32>
}

template.decl @ggml.weight.superblock(%wtype: index) -> (offset, offset, index)

template.def<@ggml.weight.superblock> device @ggml_q4_k_superblock(%wtype: index) -> (offset, offset, index) where [eq(%wtype, 2)] {
  %unit = index.constant 4 : offset
  %sb = index.constant 144 : offset
  %units = index.constant 36 : index
  template.return %unit, %sb, %units : offset, offset, index
}

template.def<@ggml.weight.superblock> device @ggml_q5_k_superblock(%wtype: index) -> (offset, offset, index) where [eq(%wtype, 5)] {
  %unit = index.constant 4 : offset
  %sb = index.constant 176 : offset
  %units = index.constant 44 : index
  template.return %unit, %sb, %units : offset, offset, index
}

func.def inline @ggml_kq_part16(%is_q5k: i1, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %b16 = index.constant 16 : offset
  %b48 = index.constant 48 : offset
  %c4_i32 = scalar.constant 4 : i32
  %zero_i32 = scalar.constant 0 : i32
  %nibbles = scalar.constant 252645135 : i32
  %bits = scalar.constant 16843009 : i32
  %part_in = index.assume %part [range(%part, 0, 15)] : index
  %pair = index.div %part_in, %c4 : index
  %quarter = index.rem %part_in, %c4 : index
  %header_view = buffer.view %weight[%sb_byte] : buffer -> view<4xi32>
  %header = vector.load %header_view[%c0] : view<4xi32> -> vector<4xi32>
  %code_add = scf.select %is_q5k, %b48, %b16 : offset
  %code_byte = index.add %sb_byte, %code_add : offset
  %code_view = buffer.view %weight[%code_byte] : buffer -> view<32xi32>
  %code_index0 = index.mul %pair, %c8 : index
  %code_index1 = index.mul %quarter, %c2 : index
  %code_index = index.add %code_index0, %code_index1 : index
  %codes = vector.load %code_view[%code_index] : view<32xi32> -> vector<2xi32>
  %high_pair = scf.if %is_q5k -> (vector<2xi32>) {
    %qh_byte = index.add %sb_byte, %b16 : offset
    %qh_view = buffer.view %weight[%qh_byte] : buffer -> view<8xi32>
    %qh = vector.load %qh_view[%code_index1] : view<8xi32> -> vector<2xi32>
    scf.yield %qh : vector<2xi32>
  } else {
    %no_qh = vector.splati 0 : vector<2xi32>
    scf.yield %no_qh : vector<2xi32>
  }
  %dm_word = vector.extract %header[0] : vector<4xi32> -> i32
  %scale0 = vector.extract %header[1] : vector<4xi32> -> i32
  %scale1 = vector.extract %header[2] : vector<4xi32> -> i32
  %scale2 = vector.extract %header[3] : vector<4xi32> -> i32
  %dm_vector = vector.from_elements %dm_word : vector<1xi32>
  %dm = vector.bitcast %dm_vector : vector<1xi32> to vector<2xf16>
  %d_f16 = vector.extract %dm[0] : vector<2xf16> -> f16
  %dmin_f16 = vector.extract %dm[1] : vector<2xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %dmin = scalar.extf %dmin_f16 : f16 to f32
  %group_lo = index.mul %pair, %c2 : index
  %group_hi = index.add %group_lo, %c1 : index
  %sc_lo, %m_lo = template.apply<@ggml.kq.scale_min>(%scale0, %scale1, %scale2, %group_lo) : (i32, i32, i32, index) -> (i32, i32)
  %sc_hi, %m_hi = template.apply<@ggml.kq.scale_min>(%scale0, %scale1, %scale2, %group_hi) : (i32, i32, i32, index) -> (i32, i32)
  %sc_lo_f = scalar.uitofp %sc_lo : i32 to f32
  %m_lo_f = scalar.uitofp %m_lo : i32 to f32
  %sc_hi_f = scalar.uitofp %sc_hi : i32 to f32
  %m_hi_f = scalar.uitofp %m_hi : i32 to f32
  %dsc_lo = scalar.mulf %d, %sc_lo_f : f32
  %dsc_hi = scalar.mulf %d, %sc_hi_f : f32
  %dm_lo = scalar.mulf %dmin, %m_lo_f : f32
  %dm_hi = scalar.mulf %dmin, %m_hi_f : f32
  %neg_lo = scalar.negf %dm_lo : f32
  %neg_hi = scalar.negf %dm_hi : f32
  %c0w = vector.extract %codes[0] : vector<2xi32> -> i32
  %c1w = vector.extract %codes[1] : vector<2xi32> -> i32
  %h0w = vector.extract %high_pair[0] : vector<2xi32> -> i32
  %h1w = vector.extract %high_pair[1] : vector<2xi32> -> i32
  %shift_lo_index = index.cast %group_lo : index to i32
  %shift_hi_index = index.cast %group_hi : index to i32
  %lo0a = scalar.andi %c0w, %nibbles : i32
  %lo1a = scalar.andi %c1w, %nibbles : i32
  %hi0s = scalar.shrui %c0w, %c4_i32 : i32
  %hi1s = scalar.shrui %c1w, %c4_i32 : i32
  %hi0a = scalar.andi %hi0s, %nibbles : i32
  %hi1a = scalar.andi %hi1s, %nibbles : i32
  %h0lo_s = scalar.shrui %h0w, %shift_lo_index : i32
  %h1lo_s = scalar.shrui %h1w, %shift_lo_index : i32
  %h0hi_s = scalar.shrui %h0w, %shift_hi_index : i32
  %h1hi_s = scalar.shrui %h1w, %shift_hi_index : i32
  %h0lo_b = scalar.andi %h0lo_s, %bits : i32
  %h1lo_b = scalar.andi %h1lo_s, %bits : i32
  %h0hi_b = scalar.andi %h0hi_s, %bits : i32
  %h1hi_b = scalar.andi %h1hi_s, %bits : i32
  %h0lo = scalar.shli %h0lo_b, %c4_i32 : i32
  %h1lo = scalar.shli %h1lo_b, %c4_i32 : i32
  %h0hi = scalar.shli %h0hi_b, %c4_i32 : i32
  %h1hi = scalar.shli %h1hi_b, %c4_i32 : i32
  %lo0 = scalar.ori %lo0a, %h0lo : i32
  %lo1 = scalar.ori %lo1a, %h1lo : i32
  %hi0 = scalar.ori %hi0a, %h0hi : i32
  %hi1 = scalar.ori %hi1a, %h1hi : i32
  %w0 = template.apply<@ggml.u8.affine4>(%lo0, %dsc_lo, %neg_lo) : (i32, f32, f32) -> (vector<4xf32>)
  %w1 = template.apply<@ggml.u8.affine4>(%lo1, %dsc_lo, %neg_lo) : (i32, f32, f32) -> (vector<4xf32>)
  %w2 = template.apply<@ggml.u8.affine4>(%hi0, %dsc_hi, %neg_hi) : (i32, f32, f32) -> (vector<4xf32>)
  %w3 = template.apply<@ggml.u8.affine4>(%hi1, %dsc_hi, %neg_hi) : (i32, f32, f32) -> (vector<4xf32>)
  %o_pair = index.mul %pair, %c64 : index
  %o_quarter = index.mul %quarter, %c8 : index
  %o0 = index.add %o_pair, %o_quarter : index
  %o1 = index.add %o0, %c4 : index
  %o2 = index.add %o0, %c32 : index
  %o3 = index.add %o2, %c4 : index
  func.return %w0, %w1, %w2, %w3, %o0, %o1, %o2, %o3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index
}

template.decl @ggml.weight.part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)

template.def<@ggml.weight.part16> device @ggml_q4_k_part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index) where [eq(%wtype, 2)] {
  %is_q5k = scalar.constant false : i1
  %w0, %w1, %w2, %w3, %o0, %o1, %o2, %o3 = func.call @ggml_kq_part16(%is_q5k, %weight, %sb_byte, %part) : (i1, buffer, offset, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)
  template.return %w0, %w1, %w2, %w3, %o0, %o1, %o2, %o3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index
}

template.def<@ggml.weight.part16> device @ggml_q5_k_part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index) where [eq(%wtype, 5)] {
  %is_q5k = scalar.constant true : i1
  %w0, %w1, %w2, %w3, %o0, %o1, %o2, %o3 = func.call @ggml_kq_part16(%is_q5k, %weight, %sb_byte, %part) : (i1, buffer, offset, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)
  template.return %w0, %w1, %w2, %w3, %o0, %o1, %o2, %o3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index
}

func.def inline @ggml_kq_offsets16(%part: index) -> (index, index, index, index) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %part_in = index.assume %part [range(%part, 0, 15)] : index
  %pair = index.div %part_in, %c4 : index
  %quarter = index.rem %part_in, %c4 : index
  %o_pair = index.mul %pair, %c64 : index
  %o_quarter = index.mul %quarter, %c8 : index
  %o0 = index.add %o_pair, %o_quarter : index
  %o1 = index.add %o0, %c4 : index
  %o2 = index.add %o0, %c32 : index
  %o3 = index.add %o2, %c4 : index
  func.return %o0, %o1, %o2, %o3 : index, index, index, index
}

template.decl @ggml.weight.offsets16(%wtype: index, %part: index) -> (index, index, index, index)

template.def<@ggml.weight.offsets16> device @ggml_q4_k_offsets16(%wtype: index, %part: index) -> (index, index, index, index) where [eq(%wtype, 2)] {
  %o0, %o1, %o2, %o3 = func.call @ggml_kq_offsets16(%part) : (index) -> (index, index, index, index)
  template.return %o0, %o1, %o2, %o3 : index, index, index, index
}

template.def<@ggml.weight.offsets16> device @ggml_q5_k_offsets16(%wtype: index, %part: index) -> (index, index, index, index) where [eq(%wtype, 5)] {
  %o0, %o1, %o2, %o3 = func.call @ggml_kq_offsets16(%part) : (index) -> (index, index, index, index)
  template.return %o0, %o1, %o2, %o3 : index, index, index, index
}

template.decl @ggml.kq.affine(%header: vector<4xi32>, %group: index) -> (f32, f32)

template.def<@ggml.kq.affine> device @ggml_kq_affine(%header: vector<4xi32>, %group: index) -> (f32, f32) {
  %dm_word = vector.extract %header[0] : vector<4xi32> -> i32
  %scale0 = vector.extract %header[1] : vector<4xi32> -> i32
  %scale1 = vector.extract %header[2] : vector<4xi32> -> i32
  %scale2 = vector.extract %header[3] : vector<4xi32> -> i32
  %dm_vector = vector.from_elements %dm_word : vector<1xi32>
  %dm = vector.bitcast %dm_vector : vector<1xi32> to vector<2xf16>
  %d_f16 = vector.extract %dm[0] : vector<2xf16> -> f16
  %dmin_f16 = vector.extract %dm[1] : vector<2xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %dmin = scalar.extf %dmin_f16 : f16 to f32
  %scale, %minimum = template.apply<@ggml.kq.scale_min>(%scale0, %scale1, %scale2, %group) : (i32, i32, i32, index) -> (i32, i32)
  %scale_f32 = scalar.uitofp %scale : i32 to f32
  %minimum_f32 = scalar.uitofp %minimum : i32 to f32
  %d_scale = scalar.mulf %d, %scale_f32 : f32
  %minimum_scale = scalar.mulf %dmin, %minimum_f32 : f32
  %negative_minimum_scale = scalar.negf %minimum_scale : f32
  template.return %d_scale, %negative_minimum_scale : f32, f32
}

func.def inline @ggml_kq_affine8(%q: vector<2xi32>, %d_scale: f32, %neg_min: f32) -> (vector<8xf16>) {
  %q_i8 = vector.bitcast %q : vector<2xi32> to vector<8xi8>
  %q_f32 = vector.uitofp %q_i8 : vector<8xi8> to vector<8xf32>
  %scale_vector = vector.splat %d_scale : vector<8xf32>
  %min_vector = vector.splat %neg_min : vector<8xf32>
  %values = vector.fmaf %q_f32, %scale_vector, %min_vector : vector<8xf32>
  %values_f16 = vector.fptrunc %values : vector<8xf32> to vector<8xf16>
  func.return %values_f16 : vector<8xf16>
}

template.decl @ggml.weight.wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>)

template.def<@ggml.weight.wmma16> device @ggml_q4_k_wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>) where [eq(%wtype, 2)] {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c35 = index.constant 35 : index
  %c36 = index.constant 36 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %zero_header = vector.splati 0 : vector<4xi32>
  %zero_codes = vector.splati 0 : vector<2xi32>
  %nibble_mask = vector.splati 252645135 : vector<2xi32>
  %four = vector.splati 4 : vector<2xi32>
  %words = buffer.view %weight[%c0_offset] : buffer -> view<[%w_span]xi32>
  // k is below K, and K is below 2^31.
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %block = index.div %k_bounded, %c256 : index
  %k_in_block = index.rem %k_bounded, %c256 : index
  %pair = index.div %k_in_block, %c64 : index
  %block_offset = index.mul %block, %c36 : index
  %block_base0 = index.add %row_base, %block_offset : index
  %block_base = index.assume %block_base0 [range(%block_base0, 0, 2147483600)] : index
  %code_page = index.mul %pair, %c8 : index
  %code_part = index.mul %part, %c2 : index
  %code_local0 = index.add %code_page, %code_part : index
  %code_local = index.add %code_local0, %c4 : index
  %code_index = index.add %block_base, %code_local : index
  %block_last = index.add %block_base, %c35 : index
  %header, %codes = scf.if %row_valid -> (vector<4xi32>, vector<2xi32>) {
    %in_span = index.cmp ult, %block_last, %w_span : index
    %loaded_header, %loaded_codes = scf.if %in_span -> (vector<4xi32>, vector<2xi32>) {
      %h = vector.load %words[%block_base] : view<[%w_span]xi32> -> vector<4xi32>
      %c = vector.load %words[%code_index] : view<[%w_span]xi32> -> vector<2xi32>
      scf.yield %h, %c : vector<4xi32>, vector<2xi32>
    } else {
      scf.yield %zero_header, %zero_codes : vector<4xi32>, vector<2xi32>
    }
    scf.yield %loaded_header, %loaded_codes : vector<4xi32>, vector<2xi32>
  } else {
    scf.yield %zero_header, %zero_codes : vector<4xi32>, vector<2xi32>
  }
  %group0 = index.mul %pair, %c2 : index
  %group1 = index.add %group0, %c1 : index
  %d0, %m0 = template.apply<@ggml.kq.affine>(%header, %group0) : (vector<4xi32>, index) -> (f32, f32)
  %d1, %m1 = template.apply<@ggml.kq.affine>(%header, %group1) : (vector<4xi32>, index) -> (f32, f32)
  %low_q = vector.andi %codes, %nibble_mask : vector<2xi32>
  %high_shifted = vector.shrui %codes, %four : vector<2xi32>
  %high_q = vector.andi %high_shifted, %nibble_mask : vector<2xi32>
  %low = func.call @ggml_kq_affine8(%low_q, %d0, %m0) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  %high = func.call @ggml_kq_affine8(%high_q, %d1, %m1) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  template.return %low, %high : vector<8xf16>, vector<8xf16>
}

template.def<@ggml.weight.wmma16> device @ggml_q5_k_wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>) where [eq(%wtype, 5)] {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c43 = index.constant 43 : index
  %c44 = index.constant 44 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %zero_header = vector.splati 0 : vector<4xi32>
  %zero_codes = vector.splati 0 : vector<2xi32>
  %nibble_mask = vector.splati 252645135 : vector<2xi32>
  %bit_mask = vector.splati 16843009 : vector<2xi32>
  %four = vector.splati 4 : vector<2xi32>
  %words = buffer.view %weight[%c0_offset] : buffer -> view<[%w_span]xi32>
  // k is below K, and K is below 2^31.
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %block = index.div %k_bounded, %c256 : index
  %k_in_block = index.rem %k_bounded, %c256 : index
  %pair = index.div %k_in_block, %c64 : index
  %block_offset = index.mul %block, %c44 : index
  %block_base0 = index.add %row_base, %block_offset : index
  %block_base = index.assume %block_base0 [range(%block_base0, 0, 2147483600)] : index
  %code_page = index.mul %pair, %c8 : index
  %code_part = index.mul %part, %c2 : index
  %code_local0 = index.add %code_page, %code_part : index
  %code_local = index.add %code_local0, %c12 : index
  %code_index = index.add %block_base, %code_local : index
  %high_local = index.add %code_part, %c4 : index
  %high_index = index.add %block_base, %high_local : index
  %block_last = index.add %block_base, %c43 : index
  %header, %codes, %high_bits = scf.if %row_valid -> (vector<4xi32>, vector<2xi32>, vector<2xi32>) {
    %in_span = index.cmp ult, %block_last, %w_span : index
    %loaded_header, %loaded_codes, %loaded_high = scf.if %in_span -> (vector<4xi32>, vector<2xi32>, vector<2xi32>) {
      %h = vector.load %words[%block_base] : view<[%w_span]xi32> -> vector<4xi32>
      %c = vector.load %words[%code_index] : view<[%w_span]xi32> -> vector<2xi32>
      %b = vector.load %words[%high_index] : view<[%w_span]xi32> -> vector<2xi32>
      scf.yield %h, %c, %b : vector<4xi32>, vector<2xi32>, vector<2xi32>
    } else {
      scf.yield %zero_header, %zero_codes, %zero_codes : vector<4xi32>, vector<2xi32>, vector<2xi32>
    }
    scf.yield %loaded_header, %loaded_codes, %loaded_high : vector<4xi32>, vector<2xi32>, vector<2xi32>
  } else {
    scf.yield %zero_header, %zero_codes, %zero_codes : vector<4xi32>, vector<2xi32>, vector<2xi32>
  }
  %group0 = index.mul %pair, %c2 : index
  %group1 = index.add %group0, %c1 : index
  %d0, %m0 = template.apply<@ggml.kq.affine>(%header, %group0) : (vector<4xi32>, index) -> (f32, f32)
  %d1, %m1 = template.apply<@ggml.kq.affine>(%header, %group1) : (vector<4xi32>, index) -> (f32, f32)
  %shift0_i32 = index.cast %group0 : index to i32
  %shift1_i32 = index.cast %group1 : index to i32
  %shift0 = vector.splat %shift0_i32 : vector<2xi32>
  %shift1 = vector.splat %shift1_i32 : vector<2xi32>
  %h0_shifted = vector.shrui %high_bits, %shift0 : vector<2xi32>
  %h1_shifted = vector.shrui %high_bits, %shift1 : vector<2xi32>
  %h0_bits = vector.andi %h0_shifted, %bit_mask : vector<2xi32>
  %h1_bits = vector.andi %h1_shifted, %bit_mask : vector<2xi32>
  %h0 = vector.shli %h0_bits, %four : vector<2xi32>
  %h1 = vector.shli %h1_bits, %four : vector<2xi32>
  %low_q4 = vector.andi %codes, %nibble_mask : vector<2xi32>
  %high_shifted = vector.shrui %codes, %four : vector<2xi32>
  %high_q4 = vector.andi %high_shifted, %nibble_mask : vector<2xi32>
  %low_q = vector.ori %low_q4, %h0 : vector<2xi32>
  %high_q = vector.ori %high_q4, %h1 : vector<2xi32>
  %low = func.call @ggml_kq_affine8(%low_q, %d0, %m0) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  %high = func.call @ggml_kq_affine8(%high_q, %d1, %m1) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  template.return %low, %high : vector<8xf16>, vector<8xf16>
}

func.def inline @ggml_kq_affine_dot16(%codes: vector<4xi32>, %x: vector<16xf32>, %scale: f32, %bias: f32) -> (f32) {
  %zero = scalar.constant 0.0 : f32
  %q_i8 = vector.bitcast %codes : vector<4xi32> to vector<16xi8>
  %q = vector.uitofp %q_i8 : vector<16xi8> to vector<16xf32>
  %products = vector.mulf %q, %x : vector<16xf32>
  %dot = vector.reduce<addf> %products, %zero : vector<16xf32>, f32
  %sum = vector.reduce<addf> %x, %zero : vector<16xf32>, f32
  %scaled_sum = scalar.mulf %bias, %sum : f32
  %result = scalar.fmaf %scale, %dot, %scaled_sum : f32
  func.return %result : f32
}

func.def inline @ggml_kq_dot(%is_q5k: i1, %header: vector<4xi32>, %codes: vector<4xi32>, %qh: vector<4xi32>, %p: index, %x_lo: vector<16xf32>, %x_hi: vector<16xf32>) -> (f32) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %low_mask = vector.splati 252645135 : vector<4xi32>
  %bit_mask = vector.splati 16843009 : vector<4xi32>
  %four = vector.splati 4 : vector<4xi32>
  %pair = index.div %p, %c2 : index
  %group_lo = index.mul %pair, %c2 : index
  %group_hi = index.add %group_lo, %c1 : index
  %codes_hi_shifted = vector.shrui %codes, %four : vector<4xi32>
  %q4_lo = vector.andi %codes, %low_mask : vector<4xi32>
  %q4_hi = vector.andi %codes_hi_shifted, %low_mask : vector<4xi32>
  %q_lo, %q_hi = scf.if %is_q5k -> (vector<4xi32>, vector<4xi32>) {
    %shift_lo_i32 = index.cast %group_lo : index to i32
    %shift_hi_i32 = index.cast %group_hi : index to i32
    %shift_lo = vector.splat %shift_lo_i32 : vector<4xi32>
    %shift_hi = vector.splat %shift_hi_i32 : vector<4xi32>
    %qh_lo_shifted = vector.shrui %qh, %shift_lo : vector<4xi32>
    %qh_hi_shifted = vector.shrui %qh, %shift_hi : vector<4xi32>
    %qh_lo_bits = vector.andi %qh_lo_shifted, %bit_mask : vector<4xi32>
    %qh_hi_bits = vector.andi %qh_hi_shifted, %bit_mask : vector<4xi32>
    %qh_lo = vector.shli %qh_lo_bits, %four : vector<4xi32>
    %qh_hi = vector.shli %qh_hi_bits, %four : vector<4xi32>
    %q5_lo = vector.ori %q4_lo, %qh_lo : vector<4xi32>
    %q5_hi = vector.ori %q4_hi, %qh_hi : vector<4xi32>
    scf.yield %q5_lo, %q5_hi : vector<4xi32>, vector<4xi32>
  } else {
    scf.yield %q4_lo, %q4_hi : vector<4xi32>, vector<4xi32>
  }
  %scale_lo, %bias_lo = template.apply<@ggml.kq.affine>(%header, %group_lo) : (vector<4xi32>, index) -> (f32, f32)
  %scale_hi, %bias_hi = template.apply<@ggml.kq.affine>(%header, %group_hi) : (vector<4xi32>, index) -> (f32, f32)
  %dot_lo = func.call @ggml_kq_affine_dot16(%q_lo, %x_lo, %scale_lo, %bias_lo) : (vector<4xi32>, vector<16xf32>, f32, f32) -> (f32)
  %dot_hi = func.call @ggml_kq_affine_dot16(%q_hi, %x_hi, %scale_hi, %bias_hi) : (vector<4xi32>, vector<16xf32>, f32, f32) -> (f32)
  %dot = scalar.addf %dot_lo, %dot_hi : f32
  func.return %dot : f32
}

// Returns zero when a block is outside its span. All loads of the packet issue before the first use.
func.def inline @ggml_kq_block_dot(%is_q5k: i1, %weight: buffer, %n_wb: index, %wb: index, %input: buffer, %n_xb: index, %xb: index, %p: index) -> (f32) {
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %zero4 = vector.splati 0 : vector<4xi32>
  %pair = index.div %p, %c2 : index
  %half = index.rem %p, %c2 : index
  %x_group = index.mul %pair, %c64 : index
  %x_half = index.mul %half, %c16 : index
  %x_lo_raw = index.add %x_group, %x_half : index
  %x_lo_off = index.assume %x_lo_raw [range(%x_lo_raw, 0, 208)] : index
  %x_hi_raw = index.add %x_lo_off, %c32 : index
  %x_hi_off = index.assume %x_hi_raw [range(%x_hi_raw, 32, 240)] : index
  %q_page = index.mul %pair, %c8 : index
  %q_half = index.mul %half, %c4 : index
  %q_local = index.add %q_page, %q_half : index
  %x_view = buffer.view %input[%c0_offset] : buffer -> view<[%n_xb]x256xf32>
  %xb_ok = index.cmp ult, %xb, %n_xb : index
  %wb_ok = index.cmp ult, %wb, %n_wb : index
  %dot = scf.if %wb_ok -> (f32) {
    %x_dot = scf.if %xb_ok -> (f32) {
      %block_dot = scf.if %is_q5k -> (f32) {
        %w5 = buffer.view %weight[%c0_offset] : buffer -> view<[%n_wb]x44xi32>
        %h_raw = index.add %q_half, %c4 : index
        %h_off = index.assume %h_raw [range(%h_raw, 4, 8)] : index
        %q5_raw = index.add %q_local, %c12 : index
        %q5_off = index.assume %q5_raw [range(%q5_raw, 12, 40)] : index
        %header5 = vector.load %w5[%wb, %c0] : view<[%n_wb]x44xi32> -> vector<4xi32>
        %qh = vector.load %w5[%wb, %h_off] : view<[%n_wb]x44xi32> -> vector<4xi32>
        %codes5 = vector.load %w5[%wb, %q5_off] : view<[%n_wb]x44xi32> -> vector<4xi32>
        %x_lo5 = vector.load %x_view[%xb, %x_lo_off] : view<[%n_xb]x256xf32> -> vector<16xf32>
        %x_hi5 = vector.load %x_view[%xb, %x_hi_off] : view<[%n_xb]x256xf32> -> vector<16xf32>
        %dot5 = func.call @ggml_kq_dot(%is_q5k, %header5, %codes5, %qh, %p, %x_lo5, %x_hi5) : (i1, vector<4xi32>, vector<4xi32>, vector<4xi32>, index, vector<16xf32>, vector<16xf32>) -> (f32)
        scf.yield %dot5 : f32
      } else {
        %w4 = buffer.view %weight[%c0_offset] : buffer -> view<[%n_wb]x36xi32>
        %q4_raw = index.add %q_local, %c4 : index
        %q4_off = index.assume %q4_raw [range(%q4_raw, 4, 32)] : index
        %header4 = vector.load %w4[%wb, %c0] : view<[%n_wb]x36xi32> -> vector<4xi32>
        %codes4 = vector.load %w4[%wb, %q4_off] : view<[%n_wb]x36xi32> -> vector<4xi32>
        %x_lo4 = vector.load %x_view[%xb, %x_lo_off] : view<[%n_xb]x256xf32> -> vector<16xf32>
        %x_hi4 = vector.load %x_view[%xb, %x_hi_off] : view<[%n_xb]x256xf32> -> vector<16xf32>
        %dot4 = func.call @ggml_kq_dot(%is_q5k, %header4, %codes4, %zero4, %p, %x_lo4, %x_hi4) : (i1, vector<4xi32>, vector<4xi32>, vector<4xi32>, index, vector<16xf32>, vector<16xf32>) -> (f32)
        scf.yield %dot4 : f32
      }
      scf.yield %block_dot : f32
    } else {
      scf.yield %zero : f32
    }
    scf.yield %x_dot : f32
  } else {
    scf.yield %zero : f32
  }
  func.return %dot : f32
}

template.decl @ggml.weight.block_dot(%wtype: index, %weight: buffer, %n_wb: index, %wb: index, %input: buffer, %n_xb: index, %xb: index, %p: index) -> (f32)

template.def<@ggml.weight.block_dot> device @ggml_q4_k_block_dot(%wtype: index, %weight: buffer, %n_wb: index, %wb: index, %input: buffer, %n_xb: index, %xb: index, %p: index) -> (f32) where [eq(%wtype, 2)] {
  %is_q5k = scalar.constant false : i1
  %dot = func.call @ggml_kq_block_dot(%is_q5k, %weight, %n_wb, %wb, %input, %n_xb, %xb, %p) : (i1, buffer, index, index, buffer, index, index, index) -> (f32)
  template.return %dot : f32
}

template.def<@ggml.weight.block_dot> device @ggml_q5_k_block_dot(%wtype: index, %weight: buffer, %n_wb: index, %wb: index, %input: buffer, %n_xb: index, %xb: index, %p: index) -> (f32) where [eq(%wtype, 5)] {
  %is_q5k = scalar.constant true : i1
  %dot = func.call @ggml_kq_block_dot(%is_q5k, %weight, %n_wb, %wb, %input, %n_xb, %xb, %p) : (i1, buffer, index, index, buffer, index, index, index) -> (f32)
  template.return %dot : f32
}

template.decl @ggml.kq.scale_min(%scale0: i32, %scale1: i32, %scale2: i32, %group: index) -> (i32, i32)

// Same packing as get_scale_min_k4 in ggml-quants.c.
template.def<@ggml.kq.scale_min> device @ggml_kq_scale_min(%scale0: i32, %scale1: i32, %scale2: i32, %group: index) -> (i32, i32) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c15_i32 = scalar.constant 15 : i32
  %c48_i32 = scalar.constant 48 : i32
  %is_low_group = index.cmp ult, %group, %c4 : index
  %scale_lane = index.rem %group, %c4 : index
  %scale_shift_index = index.mul %scale_lane, %c8 : index
  %scale_shift = index.cast %scale_shift_index : index to i32
  %high_shift = scalar.addi %scale_shift, %c2_i32 : i32
  %minimum_shift = scalar.addi %scale_shift, %c4_i32 : i32
  %selected_scale_source = scf.select %is_low_group, %scale0, %scale2 : i32
  %selected_minimum_source = scf.select %is_low_group, %scale1, %scale2 : i32
  %selected_scale_high_shift = scf.select %is_low_group, %scale_shift, %high_shift : i32
  %selected_minimum_low_shift = scf.select %is_low_group, %scale_shift, %minimum_shift : i32
  %scale_low0 = scalar.shrui %selected_scale_source, %scale_shift : i32
  %scale_low = scalar.andi %scale_low0, %c15_i32 : i32
  %scale_high0 = scalar.shrui %scale0, %selected_scale_high_shift : i32
  %scale_high = scalar.andi %scale_high0, %c48_i32 : i32
  %scale = scalar.ori %scale_low, %scale_high : i32
  %minimum_low0 = scalar.shrui %selected_minimum_source, %selected_minimum_low_shift : i32
  %minimum_low = scalar.andi %minimum_low0, %c15_i32 : i32
  %minimum_high0 = scalar.shrui %scale1, %selected_scale_high_shift : i32
  %minimum_high = scalar.andi %minimum_high0, %c48_i32 : i32
  %minimum = scalar.ori %minimum_low, %minimum_high : i32
  template.return %scale, %minimum : i32, i32
}

template.decl @ggml.kq.group_affine(%weight: buffer, %w_span: index, %block_base: index, %group: index) -> (f32, f32)

template.def<@ggml.kq.group_affine> device @ggml_kq_group_affine(%weight: buffer, %w_span: index, %block_base: index, %group: index) -> (f32, f32) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %dm_word = template.apply<@ggml.mem.word>(%weight, %w_span, %block_base) : (buffer, index, index) -> (i32)
  %scale_index0 = index.add %block_base, %c1 : index
  %scale_index1 = index.add %block_base, %c2 : index
  %scale_index2 = index.add %block_base, %c3 : index
  %scale0 = template.apply<@ggml.mem.word>(%weight, %w_span, %scale_index0) : (buffer, index, index) -> (i32)
  %scale1 = template.apply<@ggml.mem.word>(%weight, %w_span, %scale_index1) : (buffer, index, index) -> (i32)
  %scale2 = template.apply<@ggml.mem.word>(%weight, %w_span, %scale_index2) : (buffer, index, index) -> (i32)
  %dm_vector = vector.from_elements %dm_word : vector<1xi32>
  %dm = vector.bitcast %dm_vector : vector<1xi32> to vector<2xf16>
  %d_f16 = vector.extract %dm[0] : vector<2xf16> -> f16
  %dmin_f16 = vector.extract %dm[1] : vector<2xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %dmin = scalar.extf %dmin_f16 : f16 to f32
  %scale, %minimum = template.apply<@ggml.kq.scale_min>(%scale0, %scale1, %scale2, %group) : (i32, i32, i32, index) -> (i32, i32)
  %scale_f32 = scalar.uitofp %scale : i32 to f32
  %minimum_f32 = scalar.uitofp %minimum : i32 to f32
  %d_scale = scalar.mulf %d, %scale_f32 : f32
  %minimum_scale = scalar.mulf %dmin, %minimum_f32 : f32
  %negative_minimum_scale = scalar.negf %minimum_scale : f32
  template.return %d_scale, %negative_minimum_scale : f32, f32
}

func.def inline @ggml_kq_decode16(%is_q5k: i1, %header: vector<4xi32>, %codes: vector<2xi32>, %high_bits: vector<2xi32>, %k: index) -> (vector<8xf16>, vector<8xf16>) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %nibble_mask = vector.splati 252645135 : vector<2xi32>
  %bit_mask = vector.splati 16843009 : vector<2xi32>
  %four = vector.splati 4 : vector<2xi32>
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %k_in_block = index.rem %k_bounded, %c256 : index
  %pair = index.div %k_in_block, %c64 : index
  %group0 = index.mul %pair, %c2 : index
  %group1 = index.add %group0, %c1 : index
  %d0, %m0 = template.apply<@ggml.kq.affine>(%header, %group0) : (vector<4xi32>, index) -> (f32, f32)
  %d1, %m1 = template.apply<@ggml.kq.affine>(%header, %group1) : (vector<4xi32>, index) -> (f32, f32)
  %low_q4 = vector.andi %codes, %nibble_mask : vector<2xi32>
  %high_shifted = vector.shrui %codes, %four : vector<2xi32>
  %high_q4 = vector.andi %high_shifted, %nibble_mask : vector<2xi32>
  %low_q, %high_q = scf.if %is_q5k -> (vector<2xi32>, vector<2xi32>) {
    %shift0_i32 = index.cast %group0 : index to i32
    %shift1_i32 = index.cast %group1 : index to i32
    %shift0 = vector.splat %shift0_i32 : vector<2xi32>
    %shift1 = vector.splat %shift1_i32 : vector<2xi32>
    %h0_shifted = vector.shrui %high_bits, %shift0 : vector<2xi32>
    %h1_shifted = vector.shrui %high_bits, %shift1 : vector<2xi32>
    %h0_bits = vector.andi %h0_shifted, %bit_mask : vector<2xi32>
    %h1_bits = vector.andi %h1_shifted, %bit_mask : vector<2xi32>
    %h0 = vector.shli %h0_bits, %four : vector<2xi32>
    %h1 = vector.shli %h1_bits, %four : vector<2xi32>
    %low5 = vector.ori %low_q4, %h0 : vector<2xi32>
    %high5 = vector.ori %high_q4, %h1 : vector<2xi32>
    scf.yield %low5, %high5 : vector<2xi32>, vector<2xi32>
  } else {
    scf.yield %low_q4, %high_q4 : vector<2xi32>, vector<2xi32>
  }
  %low = func.call @ggml_kq_affine8(%low_q, %d0, %m0) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  %high = func.call @ggml_kq_affine8(%high_q, %d1, %m1) : (vector<2xi32>, f32, f32) -> (vector<8xf16>)
  func.return %low, %high : vector<8xf16>, vector<8xf16>
}

// Load and decode are separate steps. A K loop can then load the next block during the current block.
template.decl @ggml.kq.block(%is_q5k: i1, %weight: buffer, %w_span: index, %row_base: index, %k: index, %h: index) -> (vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>)

// The 2 workitems of a row read the whole block. This touches few cache lines for each row.
template.def<@ggml.kq.block> device @ggml_kq_block(%is_q5k: i1, %weight: buffer, %w_span: index, %row_base: index, %k: index, %h: index) -> (vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c36 = index.constant 36 : index
  %c44 = index.constant 44 : index
  %c256 = index.constant 256 : index
  %zero4 = vector.splati 0 : vector<4xi32>
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %block = index.div %k_bounded, %c256 : index
  %block_words = scf.select %is_q5k, %c44, %c36 : index
  %code_skip = scf.select %is_q5k, %c12, %c4 : index
  %block_offset = index.mul %block, %block_words : index
  %block_base0 = index.add %row_base, %block_offset : index
  %block_base = index.assume %block_base0 [range(%block_base0, 0, 2147483600)] : index
  %half_words = index.mul %h, %c4 : index
  %high_local = index.add %half_words, %c4 : index
  %high_index = index.add %block_base, %high_local : index
  %code_local = index.add %half_words, %code_skip : index
  %code_index0 = index.add %block_base, %code_local : index
  %code_index1 = index.add %code_index0, %c8 : index
  %code_index2 = index.add %code_index1, %c8 : index
  %code_index3 = index.add %code_index2, %c8 : index
  %header = template.apply<@ggml.mem.words4_clamped>(%weight, %w_span, %block_base) : (buffer, index, index) -> (vector<4xi32>)
  %high_bits = scf.if %is_q5k -> (vector<4xi32>) {
    %bq = template.apply<@ggml.mem.words4_clamped>(%weight, %w_span, %high_index) : (buffer, index, index) -> (vector<4xi32>)
    scf.yield %bq : vector<4xi32>
  } else {
    scf.yield %zero4 : vector<4xi32>
  }
  %codes0 = template.apply<@ggml.mem.words4_clamped>(%weight, %w_span, %code_index0) : (buffer, index, index) -> (vector<4xi32>)
  %codes1 = template.apply<@ggml.mem.words4_clamped>(%weight, %w_span, %code_index1) : (buffer, index, index) -> (vector<4xi32>)
  %codes2 = template.apply<@ggml.mem.words4_clamped>(%weight, %w_span, %code_index2) : (buffer, index, index) -> (vector<4xi32>)
  %codes3 = template.apply<@ggml.mem.words4_clamped>(%weight, %w_span, %code_index3) : (buffer, index, index) -> (vector<4xi32>)
  template.return %header, %high_bits, %codes0, %codes1, %codes2, %codes3 : vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
}

template.decl @ggml.kq.decode32_f16(%is_q5k: i1, %header: vector<4xi32>, %high_bits: vector<4xi32>, %codes: vector<4xi32>, %k: index) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)

template.def<@ggml.kq.decode32_f16> device @ggml_kq_decode32_f16(%is_q5k: i1, %header: vector<4xi32>, %high_bits: vector<4xi32>, %codes: vector<4xi32>, %k: index) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>) {
  %codes0 = vector.slice %codes[0] : vector<4xi32> -> vector<2xi32>
  %codes1 = vector.slice %codes[2] : vector<4xi32> -> vector<2xi32>
  %high0 = vector.slice %high_bits[0] : vector<4xi32> -> vector<2xi32>
  %high1 = vector.slice %high_bits[2] : vector<4xi32> -> vector<2xi32>
  %p0_low, %p0_high = func.call @ggml_kq_decode16(%is_q5k, %header, %codes0, %high0, %k) : (i1, vector<4xi32>, vector<2xi32>, vector<2xi32>, index) -> (vector<8xf16>, vector<8xf16>)
  %p1_low, %p1_high = func.call @ggml_kq_decode16(%is_q5k, %header, %codes1, %high1, %k) : (i1, vector<4xi32>, vector<2xi32>, vector<2xi32>, index) -> (vector<8xf16>, vector<8xf16>)
  template.return %p0_low, %p0_high, %p1_low, %p1_high : vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>
}
