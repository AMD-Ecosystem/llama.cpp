config.decl @ggml.norm.wg_size : %value: index where [range(%value, 64, 1024), multiple_of(%value, 64)]

target.decl @ggml_wave64

kernel.def target(@ggml_wave64) export("ggml_l2_norm_f32") @ggml_l2_norm_f32(%rows: index) {
  %one = index.constant 1 : index
  %wg_size = config.get @ggml.norm.wg_size : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%rows_in: index, %ne0_in: index, %ne1_in: index, %ne2_in: index, %s1_in: index, %s2_in: index, %s3_in: index, %src_span_in: index, %d1_in: index, %d2_in: index, %d3_in: index, %dst_span_in: index, %eps_bits: index, %s0_in: index, %d0_in: index, %src: buffer, %dst: buffer) {
  // supports_l2_norm checks these ranges.
  %rows = index.assume %rows_in [range(%rows_in, 1, 2147483647)] : index
  %ne0 = index.assume %ne0_in [range(%ne0_in, 1, 2147483647)] : index
  %ne1 = index.assume %ne1_in [range(%ne1_in, 1, 2147483647)] : index
  %ne2 = index.assume %ne2_in [range(%ne2_in, 1, 2147483647)] : index
  %s0 = index.assume %s0_in [range(%s0_in, 0, 2147483647)] : index
  %s1 = index.assume %s1_in [range(%s1_in, 0, 2147483647)] : index
  %s2 = index.assume %s2_in [range(%s2_in, 0, 2147483647)] : index
  %s3 = index.assume %s3_in [range(%s3_in, 0, 2147483647)] : index
  %src_span = index.assume %src_span_in [range(%src_span_in, 1, 2147483647)] : index
  %d0 = index.assume %d0_in [range(%d0_in, 0, 2147483647)] : index
  %d1 = index.assume %d1_in [range(%d1_in, 0, 2147483647)] : index
  %d2 = index.assume %d2_in [range(%d2_in, 0, 2147483647)] : index
  %d3 = index.assume %d3_in [range(%d3_in, 0, 2147483647)] : index
  %dst_span = index.assume %dst_span_in [range(%dst_span_in, 1, 2147483647)] : index
  %wg_size = config.get @ggml.norm.wg_size : index
  %row = kernel.workgroup.id<x> : index
  %item = kernel.workitem.id<x> : index
  %zero = index.constant 0 : offset
  %src_view = buffer.view %src[%zero] : buffer -> view<[%src_span]xf32>
  %dst_view = buffer.view %dst[%zero] : buffer -> view<[%dst_span]xf32>

  %i1 = index.rem %row, %ne1 : index
  %t0 = index.div %row, %ne1 : index
  %i2 = index.rem %t0, %ne2 : index
  %i3 = index.div %t0, %ne2 : index
  %so1 = index.mul %i1, %s1 : index
  %so2 = index.mul %i2, %s2 : index
  %so3 = index.mul %i3, %s3 : index
  %so12 = index.add %so1, %so2 : index
  %src_base = index.add %so12, %so3 : index
  %do1 = index.mul %i1, %d1 : index
  %do2 = index.mul %i2, %d2 : index
  %do3 = index.mul %i3, %d3 : index
  %do12 = index.add %do1, %do2 : index
  %dst_base = index.add %do12, %do3 : index

  %c0_f32 = scalar.constant 0.0 : f32
  %partial = scf.for %c = [%item to %ne0 step %wg_size](%acc = %c0_f32 : f32) -> (f32) {
    %src_col = index.mul %c, %s0 : index
    %src_idx = index.add %src_base, %src_col : index
    %src_off = index.assume %src_idx [range(%src_idx, 0, 2147483646)] : index
    %src_ok = index.cmp ult, %src_off, %src_span : index
    %next = scf.if %src_ok -> (f32) {
      %x = view.load %src_view[%src_off] : view<[%src_span]xf32> -> f32
      %xx = scalar.mulf %x, %x : f32
      %sum = scalar.addf %acc, %xx : f32
      scf.yield %sum : f32
    } else {
      scf.yield %acc : f32
    }
    scf.yield %next : f32
  }
  %sum = kernel.workgroup.reduce<addf> %partial : f32

  %eps_i32 = index.cast %eps_bits : index to i32
  %eps_vec = vector.from_elements %eps_i32 : vector<1xi32>
  %eps_fvec = vector.bitcast %eps_vec : vector<1xi32> to vector<1xf32>
  %eps = vector.extract %eps_fvec[0] : vector<1xf32> -> f32

  %c1_f32 = scalar.constant 1.0 : f32
  %root = scalar.sqrtf %sum : f32
  %denom = scalar.maxnumf %root, %eps : f32
  %scale = scalar.divf %c1_f32, %denom : f32

  // Each work item writes only the elements that it read. Thus dst can alias src.
  scf.for %c = [%item to %ne0 step %wg_size] {
    %src_col = index.mul %c, %s0 : index
    %src_idx = index.add %src_base, %src_col : index
    %src_off = index.assume %src_idx [range(%src_idx, 0, 2147483646)] : index
    %dst_col = index.mul %c, %d0 : index
    %dst_idx = index.add %dst_base, %dst_col : index
    %dst_off = index.assume %dst_idx [range(%dst_idx, 0, 2147483646)] : index
    %src_ok = index.cmp ult, %src_off, %src_span : index
    scf.if %src_ok {
      %dst_ok = index.cmp ult, %dst_off, %dst_span : index
      scf.if %dst_ok {
        %x = view.load %src_view[%src_off] : view<[%src_span]xf32> -> f32
        %y = scalar.mulf %x, %scale : f32
        view.store %y, %dst_view[%dst_off] : f32, view<[%dst_span]xf32>
      }
    }
  }
  kernel.return
}
