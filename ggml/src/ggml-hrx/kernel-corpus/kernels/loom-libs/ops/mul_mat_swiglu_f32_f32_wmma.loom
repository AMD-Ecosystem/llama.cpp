  %valid_token1 = index.cmp ult, %token1, %bounded_token_count : index
  %valid_channel0 = index.cmp ult, %channel0, %bounded_output_size : index
  %valid_channel1 = index.cmp ult, %channel1, %bounded_output_size : index
  %writes00 = scalar.andi %valid_token0, %valid_channel0 : i1
  %writes01 = scalar.andi %valid_token1, %valid_channel0 : i1
  %writes10 = scalar.andi %valid_token0, %valid_channel1 : i1
  %writes11 = scalar.andi %valid_token1, %valid_channel1 : i1
