  vector.fragment.store<result> %up_result00, %up_result_fragment_view[%c0, %c0] shape [%m, %n] : vector<8xf16>, view<16x16xf16, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
