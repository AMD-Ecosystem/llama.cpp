          %decoded = func.call @ggml_dequant_f16_vector4(%gate_weight_format, %gate_weight_noalias, %row_byte_base, %bounded_input_size, %quant_block, %quant_group, %load_packet, %weight_k) : (index, buffer, offset, index, index, index, index, index) -> (vector<4xf16>)
          scf.yield %decoded : vector<4xf16>
        } else {
          scf.yield %c0_f16x4 : vector<4xf16>
        }
        %up_weight_values = scf.if %valid_channel -> (vector<4xf16>) {
