  %init01 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<8xf16>
  %init10 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<8xf16>
  %init11 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<8xf16>
  %gate_result00, %gate_result01, %gate_result10, %gate_result11, %up_result00, %up_result01, %up_result10, %up_result11 = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%gate_block_acc00 = %init00 : vector<8xf16>, %gate_block_acc01 = %init01 : vector<8xf16>, %gate_block_acc10 = %init10 : vector<8xf16>, %gate_block_acc11 = %init11 : vector<8xf16>, %up_block_acc00 = %init00 : vector<8xf16>, %up_block_acc01 = %init01 : vector<8xf16>, %up_block_acc10 = %init10 : vector<8xf16>, %up_block_acc11 = %init11 : vector<8xf16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>) {
    %gate_block_result00, %gate_block_result01, %gate_block_result10, %gate_block_result11, %up_block_result00, %up_block_result01, %up_block_result10, %up_block_result11 = scf.for %quant_group = [%c0 to %c8 step %c1](%gate_acc00 = %gate_block_acc00 : vector<8xf16>, %gate_acc01 = %gate_block_acc01 : vector<8xf16>, %gate_acc10 = %gate_block_acc10 : vector<8xf16>, %gate_acc11 = %gate_block_acc11 : vector<8xf16>, %up_acc00 = %up_block_acc00 : vector<8xf16>, %up_acc01 = %up_block_acc01 : vector<8xf16>, %up_acc10 = %up_block_acc10 : vector<8xf16>, %up_acc11 = %up_block_acc11 : vector<8xf16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>) {
      %block_k_base = index.mul %quant_block, %c256 : index
      %group_k_add = index.mul %quant_group, %c32 : index
      %k_origin = index.add %block_k_base, %group_k_add : index
      scf.for %row_offset = [%c0 to %c64 step %c16] unroll {
        %local_row0 = index.add %load_row, %row_offset : index
        %local_row = index.assume %local_row0 [range(%local_row0, 0, 63)] : index
        %channel = index.add %channel_tile_base, %local_row : index
        %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
        %gate_weight_values = scf.if %valid_channel -> (vector<4xf16>) {
          %row_byte_base = index.scale %channel, %gate_weight_row_bytes : index, offset -> offset
