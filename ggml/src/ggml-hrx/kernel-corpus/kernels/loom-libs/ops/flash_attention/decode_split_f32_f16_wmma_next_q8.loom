check.benchmark<@ggml_flash_attention_decode_split_f32_f16_wmma_benchmark_case> @ggml_flash_attention_decode_split_f32_f16_wmma_decode_513 {key_value_token_count = 513}

check.benchmark<@ggml_flash_attention_decode_split_f32_f16_wmma_benchmark_case> @ggml_flash_attention_decode_split_f32_f16_wmma_decode_768 {key_value_token_count = 768}

check.benchmark<@ggml_flash_attention_decode_split_f32_f16_wmma_benchmark_case> @ggml_flash_attention_decode_split_f32_f16_wmma_decode_1024 {key_value_token_count = 1024}

