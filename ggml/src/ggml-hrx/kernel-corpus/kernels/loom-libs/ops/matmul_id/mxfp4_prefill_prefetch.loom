    %subgroup_channel1 = index.add %subgroup_channel_add, %c16 : index
    %zero_integer = vector.splati 0 : vector<8xi32>
    %i8_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
    %zero_accumulator = vector.splatf 0.0 : vector<8xf32>
    %quant_block_count = index.div %input_size, %c256 : index
    %weight_row_bytes = index.scale %quant_block_count, %c136_bytes : index, offset -> offset
    %weight_expert_bytes = index.scale %bounded_output_size, %weight_row_bytes : index, offset -> offset
    %weight_stage_view = buffer.view %weight_stage[%c0_offset] : buffer -> view<64x80xi8>
    %activation_stage_physical_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<32x80xi8>
