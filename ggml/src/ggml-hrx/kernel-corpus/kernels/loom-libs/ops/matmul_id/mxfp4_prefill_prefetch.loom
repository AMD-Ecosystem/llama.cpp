// MXFP4 routed prefill owns panel lookahead and per-K32 scaling.
//
// The kernel consumes a precomputed expert table. Each table row stores compact
// assignment indices encoded as token * route_count + route. Input can either
// be broadcast across all routes or contain one input row per route.
template.decl @ggml.matmul_id.mxfp4_prefetch.core(%token_count: index, %input_size: index, %output_size: index, %route_count: index, %input_route_count: index, %expert_count: index, %channel_tile: index, %partition_ordinal: index, %input: buffer, %expert_table: buffer, %partition_table: buffer, %weight: buffer, %output: buffer)

func.decl @ggml_moe_stage_partition(%descriptor_ordinal: index, %maximum_partition_count: index, %bounded_expert_count: index, %bounded_token_count: index, %workitem: index, %partition_table_noalias: buffer, %expert_table_noalias: buffer, %route_stage: buffer) -> (index, index, index)

func.decl @ggml_moe_tiled_output_coordinates(%lane: index, %packets: index, %packet_width: index, %route_stage: buffer, %assignment_count: index, %bounded_route_count: index, %channel_tile_base: index, %subgroup_channel_add: index, %bounded_output_size: index) -> (index, index, index, index, index, index, index, index, i1, i1, i1, i1, index, index)

func.decl @ggml_mxfp4_prefetch_panel(%weight_noalias: buffer, %input_noalias: buffer, %route_stage: buffer, %expert_byte_base: offset, %weight_row_bytes: offset, %channel_tile_base: index, %bounded_output_size: index, %quant_groups: index, %load_row: index, %load_k: index, %weight_klo: index, %bounded_route_count: index, %bounded_input_route_count: index, %block_base: index) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32)

func.decl @ggml_mxfp4_preloaded_i8_packet(%p: vector<4xi8>, %scale_byte: i8) -> (vector<4xi8>, vector<4xi8>, f32)

func.def inline @ggml_mul_mat_id_mxfp4_prefetch_publish_vector8(%publish_word: i1, %assignment: index, %token: index, %route: index, %channel: index, %token_count0: index, %route_count0: index, %output_size0: index, %values: vector<8xf32>, %output: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %route_count = index.assume %route_count0 [range(%route_count0, 1, 32)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 262144)] : index
  %c0_offset = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %output_row_count = index.mul %token_count, %route_count : index
  %output_noalias = buffer.assume.noalias %output : buffer
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%output_row_count]x[%output_size]xf32>
  scf.if %publish_word {
    %bounded_assignment, %assignment_count = index.assume %assignment, %output_row_count [lt(%assignment, %output_row_count)] : index, index
    %mask = vector.mask.range [%channel to %output_size step %c1] : index -> vector<8xi1>
    vector.store.mask %values, %output_view[%bounded_assignment, %channel], %mask : vector<8xf32>, view<[%output_row_count]x[%output_size]xf32>, vector<8xi1>
  }
  func.return
}

