kernel.def target(@ggml_q5_plane_dense_gfx11_wave32) @ggml_mul_mat_q5_k_q8_plane_wmmai8_token256(%token_count: index) {
  %unit = index.constant 1 : index
  %tile_rows = index.constant 64 : index
  %tile_tokens = index.constant 256 : index
  %workgroup_size = index.constant 256 : index
  %output_size = config.get @ggml.mul_mat_q5_k_q8_plane.output_size : index
  %token_capacity = config.get @ggml.mul_mat_q5_k_q8_plane.token_capacity : index
