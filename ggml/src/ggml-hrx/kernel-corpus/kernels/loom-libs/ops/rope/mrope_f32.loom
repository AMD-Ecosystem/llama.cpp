template.decl @ggml.mrope_f32.body(%token_count: index, %input_span: index, %positions: buffer, %input: buffer, %theta: buffer, %freq_factors: buffer, %selectors: buffer, %output: buffer)
func.decl @ggml_mrope_f32_pair_packet(%positions: vector<2xf32>, %theta: vector<2xf32>, %freq_factors: vector<2xf32>, %x_values: vector<2xf32>, %y_values: vector<2xf32>) -> (vector<2xf32>, vector<2xf32>)

amdgpu.target<gfx11-generic> @ggml_mrope_f32_gfx11_wave32 {subgroup_size = 32}

config.decl @ggml.mrope_f32.head_size : %value: index where [range(%value, 4, 1024), multiple_of(%value, 4)]
config.decl @ggml.mrope_f32.n_dims : %value: index where [range(%value, 4, 1024), multiple_of(%value, 4)]
config.decl @ggml.mrope_f32.head_count : %value: index where [range(%value, 1, 64)]
config.decl @ggml.mrope_f32.token_capacity : %value: index where [range(%value, 1, 2048)]
config.decl @ggml.mrope_f32.input_stride1 : %value: index where [range(%value, 4, 1073741824)]
config.decl @ggml.mrope_f32.input_stride2 : %value: index where [range(%value, 4, 1073741824)]
config.decl @ggml.mrope_f32.mscale : f32

kernel.def target(@ggml_mrope_f32_gfx11_wave32) @ggml_mrope_f32(%token_count: index, %input_span: index) {
  %token_capacity = config.get @ggml.mrope_f32.token_capacity : index
  %head_count = config.get @ggml.mrope_f32.head_count : index
  %head_size = config.get @ggml.mrope_f32.head_size : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %packet_count = index.div %head_size, %c4 : index
  kernel.launch.config workgroups(%head_count, %token_capacity, %c1) workgroup_size(%packet_count, %c1, %c1) : index
} launch(%token_count: index, %input_span: index, %positions: buffer, %input: buffer, %theta: buffer, %freq_factors: buffer, %selectors: buffer, %output: buffer) where [range(%token_count, 1, 2048), range(%input_span, 1, 1073741824)] {
  template.apply<@ggml.mrope_f32.body>(%token_count, %input_span, %positions, %input, %theta, %freq_factors, %selectors, %output) : (index, index, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

template.def<@ggml.mrope_f32.body> device @ggml_mrope_f32_body(%token_count: index, %input_span: index, %positions: buffer, %input: buffer, %theta: buffer, %freq_factors: buffer, %selectors: buffer, %output: buffer) {
  %token_capacity = config.get @ggml.mrope_f32.token_capacity : index
  %head_count0 = config.get @ggml.mrope_f32.head_count : index
  %head_size0 = config.get @ggml.mrope_f32.head_size : index
  %n_dims0 = config.get @ggml.mrope_f32.n_dims : index
  %input_stride1 = config.get @ggml.mrope_f32.input_stride1 : index
  %input_stride2 = config.get @ggml.mrope_f32.input_stride2 : index
  %mscale = config.get @ggml.mrope_f32.mscale : f32
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %bounded_input_span = index.assume %input_span [range(%input_span, 1, 1073741824)] : index
  %head_count, %head_size, %n_dims = index.assume %head_count0, %head_size0, %n_dims0 [range(%head_count0, 1, 64), range(%head_size0, 4, 1024), range(%n_dims0, 4, 1024), multiple_of(%head_size0, 4), multiple_of(%n_dims0, 4), le(%n_dims0, %head_size0)] : index, index, index
  %head = kernel.workgroup.id<x> : index
  %token = kernel.workgroup.id<y> : index
  %packet = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c0_offset = index.constant 0 : offset
  %half_n_dims = index.div %n_dims, %c2 : index
  %packet_count = index.div %head_size, %c4 : index
  %rotary_packet_count = index.div %n_dims, %c4 : index
  %valid_token = index.cmp ult, %token, %bounded_token_count : index
  %active_packet = index.cmp ult, %packet, %packet_count : index
  %rotary_packet = index.cmp ult, %packet, %rotary_packet_count : index
  %valid_packet = scalar.andi %valid_token, %active_packet : i1
  %rotate = scalar.andi %valid_packet, %rotary_packet : i1
  %copy_packet = index.cmp uge, %packet, %rotary_packet_count : index
  %copy = scalar.andi %valid_packet, %copy_packet : i1
  %positions_noalias, %input_noalias, %theta_noalias, %factors_noalias, %selectors_noalias, %output_noalias = buffer.assume.noalias %positions, %input, %theta, %freq_factors, %selectors, %output : buffer, buffer, buffer, buffer, buffer, buffer
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%head_count]x[%head_size]xf32>
  %token_base = index.mul %token, %input_stride2 : index
  %head_offset = index.mul %head, %input_stride1 : index
  %input_base = index.add %token_base, %head_offset : index
  scf.if %rotate {
    %pair = index.mul %packet, %c2 : index
    %pair_next = index.add %pair, %c1 : index
    %pair_high = index.add %pair, %half_n_dims : index
    %low_index = index.add %input_base, %pair : index
    %high_index = index.add %input_base, %pair_high : index
    %low_end0 = index.add %low_index, %c2 : index
    %high_end0 = index.add %high_index, %c2 : index
    %bounded_low_index, %low_end = index.assume %low_index, %low_end0 [le(%low_end0, %bounded_input_span)] : index, index
    %bounded_high_index, %high_end = index.assume %high_index, %high_end0 [le(%high_end0, %bounded_input_span)] : index, index
    %low_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%low_end]xf32>
    %high_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%high_end]xf32>
    %low_values = vector.load %low_view[%bounded_low_index] : view<[%low_end]xf32> -> vector<2xf32>
    %high_values = vector.load %high_view[%bounded_high_index] : view<[%high_end]xf32> -> vector<2xf32>
    %theta_view = buffer.view %theta_noalias[%c0_offset] : buffer -> view<[%half_n_dims]xf32>
    %factors_view = buffer.view %factors_noalias[%c0_offset] : buffer -> view<[%half_n_dims]xf32>
    %selectors_view = buffer.view %selectors_noalias[%c0_offset] : buffer -> view<[%half_n_dims]xi32>
    %theta_packet = vector.load %theta_view[%pair] : view<[%half_n_dims]xf32> -> vector<2xf32>
    %factors_packet = vector.load %factors_view[%pair] : view<[%half_n_dims]xf32> -> vector<2xf32>
    %selector0 = view.load %selectors_view[%pair] : view<[%half_n_dims]xi32> -> i32
    %selector1 = view.load %selectors_view[%pair_next] : view<[%half_n_dims]xi32> -> i32
    %plane0_0 = index.cast %selector0 : i32 to index
    %plane1_0 = index.cast %selector1 : i32 to index
    %plane0, %plane1 = index.assume %plane0_0, %plane1_0 [range(%plane0_0, 0, 3), range(%plane1_0, 0, 3)] : index, index
    %plane_offset0 = index.mul %plane0, %bounded_token_count : index
    %plane_offset1 = index.mul %plane1, %bounded_token_count : index
    %position_index0 = index.add %token, %plane_offset0 : index
    %position_index1 = index.add %token, %plane_offset1 : index
    %position_count = index.mul %bounded_token_count, %c4 : index
    %position_end0 = index.add %position_index0, %c1 : index
    %position_end1 = index.add %position_index1, %c1 : index
    %bounded_position_index0, %bounded_position_end0 = index.assume %position_index0, %position_end0 [le(%position_end0, %position_count)] : index, index
    %bounded_position_index1, %bounded_position_end1 = index.assume %position_index1, %position_end1 [le(%position_end1, %position_count)] : index, index
    %positions_view0 = buffer.view %positions_noalias[%c0_offset] : buffer -> view<[%bounded_position_end0]xi32>
    %positions_view1 = buffer.view %positions_noalias[%c0_offset] : buffer -> view<[%bounded_position_end1]xi32>
    %position_i32_0 = view.load %positions_view0[%bounded_position_index0] : view<[%bounded_position_end0]xi32> -> i32
    %position_i32_1 = view.load %positions_view1[%bounded_position_index1] : view<[%bounded_position_end1]xi32> -> i32
    %position0 = scalar.sitofp %position_i32_0 : i32 to f32
    %position1 = scalar.sitofp %position_i32_1 : i32 to f32
    %position_packet = vector.from_elements %position0, %position1 : vector<2xf32>
    %rotated_low, %rotated_high = func.call @ggml_mrope_f32_pair_packet(%position_packet, %theta_packet, %factors_packet, %low_values, %high_values) : (vector<2xf32>, vector<2xf32>, vector<2xf32>, vector<2xf32>, vector<2xf32>) -> (vector<2xf32>, vector<2xf32>)
    %mscale_packet = vector.splat %mscale : vector<2xf32>
    %scaled_low = vector.mulf<reassoc|nnan|ninf|nsz|contract> %rotated_low, %mscale_packet : vector<2xf32>
    %scaled_high = vector.mulf<reassoc|nnan|ninf|nsz|contract> %rotated_high, %mscale_packet : vector<2xf32>
    vector.store %scaled_low, %output_view[%token, %head, %pair] : vector<2xf32>, view<[%bounded_token_count]x[%head_count]x[%head_size]xf32>
    vector.store %scaled_high, %output_view[%token, %head, %pair_high] : vector<2xf32>, view<[%bounded_token_count]x[%head_count]x[%head_size]xf32>
  }
  scf.if %copy {
    %channel = index.mul %packet, %c4 : index
    %input_index = index.add %input_base, %channel : index
    %input_end0 = index.add %input_index, %c4 : index
    %bounded_input_index, %input_end = index.assume %input_index, %input_end0 [le(%input_end0, %bounded_input_span)] : index, index
    %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%input_end]xf32>
    %values = vector.load %input_view[%bounded_input_index] : view<[%input_end]xf32> -> vector<4xf32>
    vector.store %values, %output_view[%token, %head, %channel] : vector<4xf32>, view<[%bounded_token_count]x[%head_count]x[%head_size]xf32>
  }
  template.return
}
