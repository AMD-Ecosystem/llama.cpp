template.decl @ggml.copy.strided_source.f16_body(%element_count: index, %source_span: index, %source: buffer, %output: buffer)

amdgpu.target<gfx11-generic> @ggml_copy_f16_gfx11_wave64 {subgroup_size = 64}

config.decl @ggml.copy_strided_source_f16.ne0 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.copy_strided_source_f16.ne1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.copy_strided_source_f16.ne2 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.copy_strided_source_f16.stride0 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.copy_strided_source_f16.stride1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.copy_strided_source_f16.stride2 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.copy_strided_source_f16.stride3 : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@ggml_copy_f16_gfx11_wave64) export("ggml_copy_strided_source_f16") @ggml_copy_strided_source_f16(%element_count: index, %source_span: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %twofiftysix : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%element_count: index, %source_span: index, %source: buffer, %output: buffer) {
  template.apply<@ggml.copy.strided_source.f16_body>(%element_count, %source_span, %source, %output) : (index, index, buffer, buffer)
  kernel.return
}

check.case public @ggml_copy_strided_source_f16_small_case {
  %six = check.literal value(6) : index
  %eight = check.literal value(8) : index
  %source = check.generate.iota offset(0.0) step(1.0) period(5) : tensor<10xf16>
  %output = check.generate.fill value(-1.0) : tensor<6xf16>
  %expected = check.generate.iota offset(0.0) step(1.0) period(3) : tensor<6xf16>
  kernel.launch @ggml_copy_strided_source_f16[%six, %eight](%six, %eight, %source, %output) : [index, index](index, index, tensor<10xf16>, tensor<6xf16>)
  check.expect.approximate actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<6xf16>, tensor<6xf16>
  check.return
}

check.benchmark<@ggml_copy_strided_source_f16_small_case> @ggml_copy_strided_source_f16_small
