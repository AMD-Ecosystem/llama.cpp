template.decl @ggml.copy.convert_f32_i32.body(%element_count: index, %source: buffer, %output: buffer)

amdgpu.target<gfx11-generic> @ggml_copy_f32_i32_gfx11_wave64 {subgroup_size = 64}

kernel.def target(@ggml_copy_f32_i32_gfx11_wave64) export("ggml_copy_f32_i32") @ggml_copy_f32_i32(%element_count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroup_count = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%workgroup_count, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%element_count: index, %source: buffer, %output: buffer) {
  template.apply<@ggml.copy.convert_f32_i32.body>(%element_count, %source, %output) : (index, buffer, buffer)
  kernel.return
}
