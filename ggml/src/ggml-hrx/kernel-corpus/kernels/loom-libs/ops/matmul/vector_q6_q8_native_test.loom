// Q6 bytes 0xaa decode to (42 - 32) * (-86) * f16(0xaaaa).
// Q8 bytes 0x01 decode to 1 * f16(0x0101); the oracle is K times their product.
check.case public @ggml_mul_mat_vector_q6_q8_wave32_k768_tail {
  %token_count = check.literal value(1) : index
  %input = check.generate.fill value(1) : tensor<1x864xi8>
  %weight = check.generate.fill value(-86) : tensor<9x3x210xi8>
  %output = check.generate.fill value(-1.0) : tensor<1x9xf32>
  %expected = check.generate.fill value(0.52674690261483192) : tensor<1x9xf32>
  kernel.launch @ggml_mul_mat_vector_q6_q8_f32_wave32[%token_count](%token_count, %input, %weight, %output, %output) : [index](index, tensor<1x864xi8>, tensor<9x3x210xi8>, tensor<1x9xf32>, tensor<1x9xf32>)
  check.expect.approximate actual(%output) expected(%expected) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<1x9xf32>, tensor<1x9xf32>
  check.return
}

