// Nonzero native Q6/Q8 checks call both production entries with the shared ABI.
// K=768 covers the wave64 four-block tail; nine rows cross the wave32 row tile.

target.decl @ggml_matmul_vector_gfx11_wave32

kernel.decl target(@ggml_matmul_vector_gfx11_wave32) @ggml_mul_mat_vector_q6_q8_f32_wave32(%token_count$0: index) launch(%token_count$1: index, %input: buffer, %weight: buffer, %output: buffer, %next_output: buffer)

