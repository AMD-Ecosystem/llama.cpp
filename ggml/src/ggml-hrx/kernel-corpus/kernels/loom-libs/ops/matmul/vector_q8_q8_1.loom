// One wave per output row. Shared Q8_1_x4 activations are produced once
// and reused across rows/projections; raw Q8_0 weights stay resident.
amdgpu.target<gfx11-generic> @ggml_q8_dot_wave32 {subgroup_size = 32}

config.decl @ggml.matmul.vector.input_size : %v: index where [range(%v, 256, 32768), multiple_of(%v, 256)]

config.decl @ggml.matmul.vector.output_size : %v: index where [range(%v, 1, 524288)]

config.def @ggml.matmul.vector.batch_count = 1 : index

kernel.def target(@ggml_q8_dot_wave32) @ggml_mul_mat_vector_q8_q8_1(%token_count: index) {
  %m = config.get @ggml.matmul.vector.output_size : index
  %batches = config.get @ggml.matmul.vector.batch_count : index
  %one = index.constant 1 : index
  %wave = index.constant 32 : index
  kernel.launch.config workgroups(%m, %batches, %one) workgroup_size(%wave, %one, %one) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %output: buffer, %next_output: buffer) {
  %k = config.get @ggml.matmul.vector.input_size : index
  %m = config.get @ggml.matmul.vector.output_size : index
  %batch_count = config.get @ggml.matmul.vector.batch_count : index
  %batches = index.assume %batch_count [range(%batch_count, 1, 512)] : index
  %batch0 = kernel.workgroup.id<y> : index
  %batch = index.assume %batch0 [lt(%batch0, %batches)] : index
  %row0 = kernel.workgroup.id<x> : index
  %row, %rows = index.assume %row0, %m [lt(%row0, %m)] : index, index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %c16 = index.constant 16 : index
  %c128 = index.constant 128 : index
  %c32 = index.constant 32 : index
  %c512 = index.constant 512 : index
  %zero_offset = index.constant 0 : offset
  %two_bytes = index.constant 2 : offset
  %block_bytes = index.constant 34 : offset
  %activation_group_bytes = index.constant 144 : offset
  %activation_header_bytes = index.constant 16 : offset
  %integer_zero = vector.constant 0 : vector<4xi32>
  %scalar_zero = scalar.constant 0 : i32
  %zero_float = scalar.constant 0.0 : f32
  %weight_blocks = index.div %k, %c32 : index
  %row_bytes = index.scale %weight_blocks, %block_bytes : index, offset -> offset
  %flat_row = index.madd %batch, %rows, %row : index
  %flat_rows = index.mul %batches, %rows : index
  %row_base = index.scale %flat_row, %row_bytes : index, offset -> offset
  %activation_groups = index.div %k, %c128 : index
  %activation_row_bytes = index.scale %activation_groups, %activation_group_bytes : index, offset -> offset
  %activation_row_base = index.scale %batch, %activation_row_bytes : index, offset -> offset
  %lane_k = index.mul %lane, %c16 : index
  %packet = index.rem %lane_k, %c32 : index
  %lane_sum = scf.for %base = [%c0 to %k step %c512](%acc = %zero_float : f32) -> (f32) {
    %ki0 = index.add %base, %lane_k : index
    %active = index.cmp ult, %ki0, %k : index
    %next = scf.if %active -> (f32) {
      %ki = index.assume %ki0 [lt(%ki0, %k), multiple_of(%ki0, 16)] : index
      %block = index.div %ki, %c32 : index
      %block_offset = index.scale %block, %block_bytes : index, offset -> offset
      %scale_offset = index.add %row_base, %block_offset : offset
      %payload_offset = index.add %scale_offset, %two_bytes : offset
      %sv = buffer.view %weight[%scale_offset] : buffer -> view<1xf16>
      %wv = buffer.view %weight[%payload_offset] : buffer -> view<32xi8>
      %half_scale = view.load %sv[%c0] : view<1xf16> -> f16
      %scale = scalar.extf %half_scale : f16 to f32
      %packed = vector.load %wv[%packet] : view<32xi8> -> vector<16xi8>
      %activation_group = index.div %ki, %c128 : index
      %activation_group_base = index.scale %activation_group, %activation_group_bytes : index, offset -> offset
      %activation_base = index.add %activation_row_base, %activation_group_base : offset
      %activation_payload = index.add %activation_base, %activation_header_bytes : offset
      %activation_index = index.rem %ki, %c128 : index
      %activation_block = index.rem %block, %c4 : index
      %ds_index = index.mul %activation_block, %c2 : index
      %xv = buffer.view %input[%activation_payload] : buffer -> view<128xi8>
      %ds = buffer.view %input[%activation_base] : buffer -> view<8xf16>
      %a = vector.load %xv[%activation_index] : view<128xi8> -> vector<16xi8>
      %input_half_scale = view.load %ds[%ds_index] : view<8xf16> -> f16
      %input_scale = scalar.extf %input_half_scale : f16 to f32
      %dot_pair = vector.dot4i<s8s8> %packed, %a, %integer_zero : vector<16xi8>, vector<16xi8>, vector<4xi32>
      %dot_integer = vector.reduce<addi> %dot_pair, %scalar_zero : vector<4xi32>, i32
      %dot = scalar.sitofp %dot_integer : i32 to f32
      %product_scale = scalar.mulf %scale, %input_scale : f32
      %value = scalar.fmaf %product_scale, %dot, %acc : f32
      scf.yield %value : f32
    } else {
      scf.yield %acc : f32
    }
    scf.yield %next : f32
  }
  %total = kernel.subgroup.reduce<addf> %lane_sum : f32
  %leader = index.cmp eq, %lane, %c0 : index
  scf.if %leader {
    %y = buffer.view %output[%zero_offset] : buffer -> view<[%flat_rows]xf32>
    view.store %total, %y[%flat_row] : f32, view<[%flat_rows]xf32>
  }
  kernel.return
}
