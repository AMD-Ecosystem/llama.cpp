  %ow = config.get @ggml.im2col.output_width : index
  %oh = config.get @ggml.im2col.output_height : index
  %iw = config.get @ggml.im2col.input_width : index
  %ih = config.get @ggml.im2col.input_height : index
  %cs = config.get @ggml.im2col.channel_stride : index
  %bs = config.get @ggml.im2col.batch_stride : index
  %sx = config.get @ggml.im2col.stride_x : index
  %sy = config.get @ggml.im2col.stride_y : index
  %px = config.get @ggml.im2col.pad_x : index
  %py = config.get @ggml.im2col.pad_y : index
  %dx = config.get @ggml.im2col.dilation_x : index
  %dy = config.get @ggml.im2col.dilation_y : index
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %threads = index.constant 256 : index
  %linear = index.madd %group, %threads, %thread : index
  %valid = index.cmp ult, %linear, %count : index
  %zero = index.constant 0 : offset
  %source_noalias, %output_noalias = buffer.assume.noalias %source, %output : buffer, buffer
  %output_view = buffer.view %output_noalias[%zero] : buffer -> view<[%count]xf32>
  scf.if %valid {
    %value = func.call @ggml_im2col_gather_f32(%linear, %kw, %kh, %channels, %ow, %oh, %iw, %ih, %cs, %bs, %sx, %sy, %px, %py, %dx, %dy, %span, %source_noalias) : (index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, index, buffer) -> (f32)
    view.store %value, %output_view[%linear] : f32, view<[%count]xf32>
  }
  kernel.return
}

check.case public @ggml_im2col_f32_f16_small_case {
  %count = check.literal value(4) : index
  %source = check.generate.iota offset(1.0) step(1.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf16>
  %expected = check.generate.iota offset(1.0) step(1.0) : tensor<4xf16>
  kernel.launch @ggml_im2col_f32_f16[%count, %count](%count, %count, %source, %output) : [index, index](index, index, tensor<4xf32>, tensor<4xf16>)
  check.expect.approximate actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf16>, tensor<4xf16>
  check.return
}

check.benchmark<@ggml_im2col_f32_f16_small_case> @ggml_im2col_f32_f16_small

check.case public @ggml_im2col_f32_f32_small_case {
  %count = check.literal value(4) : index
  %source = check.generate.iota offset(1.0) step(1.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.iota offset(1.0) step(1.0) : tensor<4xf32>
  kernel.launch @ggml_im2col_f32_f32[%count, %count](%count, %count, %source, %output) : [index, index](index, index, tensor<4xf32>, tensor<4xf32>)
  check.expect.approximate actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>, tensor<4xf32>
  check.return
