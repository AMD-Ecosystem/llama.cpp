// Accumulate one K32 group into a 16x16 F32 result fragment. Callers own
// decoding, memory transfers and scheduling. LHS is signed i8; RHS carries
// its i8/u8 fragment schema. Scales, sums and corrections use result-fragment
// lane order. Affine weights are scale * code + correction; signed formats
// omit that correction. Return the fragment so consumers can fuse before store.
template.decl @ggml.matmul.integer_k32.accumulate_f32(%signed_rhs: i1, %lhs0: vector<4xi32>, %lhs1: vector<4xi32>, %rhs0: vector<4xi32>, %rhs1: vector<4xi32>, %zero: vector<8xi32>, %activation_scale: vector<8xf32>, %weight_scale: vector<8xf32>, %activation_sum: vector<8xf32>, %weight_correction: vector<8xf32>, %accumulator: vector<8xf32>) -> (vector<8xf32>)

template.def<@ggml.matmul.integer_k32.accumulate_f32> device @ggml_matmul_integer_k32_accumulate_f32(%signed_rhs: i1, %lhs0: vector<4xi32>, %lhs1: vector<4xi32>, %rhs0: vector<4xi32>, %rhs1: vector<4xi32>, %zero: vector<8xi32>, %activation_scale: vector<8xf32>, %weight_scale: vector<8xf32>, %activation_sum: vector<8xf32>, %weight_correction: vector<8xf32>, %accumulator: vector<8xf32>) -> (vector<8xf32>) {
  %dot0 = vector.mma %lhs0, %rhs0, %zero : vector<4xi32>, vector<4xi32>, vector<8xi32>
  %dot = vector.mma %lhs1, %rhs1, %dot0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
  %dot_f32 = vector.sitofp %dot : vector<8xi32> to vector<8xf32>
  %product_scale = vector.mulf %activation_scale, %weight_scale : vector<8xf32>
  %affine_base = vector.fmaf %activation_sum, %weight_correction, %accumulator : vector<8xf32>
  %base = scf.select %signed_rhs, %accumulator, %affine_base : vector<8xf32>
  %result = vector.fmaf %dot_f32, %product_scale, %base : vector<8xf32>
  template.return %result : vector<8xf32>
}
