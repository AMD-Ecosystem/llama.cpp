// Register-only paired consumers. Gate and up fragments must describe the
// same output coordinates, after the complete K reduction. GEGLU uses tanh GELU.

template.decl @ggml.matmul.swiglu.apply_vector8(%gate: vector<8xf32>, %up: vector<8xf32>) -> (vector<8xf32>)

template.def<@ggml.matmul.swiglu.apply_vector8> device @ggml_matmul_swiglu_apply_vector8(%gate: vector<8xf32>, %up: vector<8xf32>) -> (vector<8xf32>) {
  %activated = vector.siluf %gate : vector<8xf32>
  %result = vector.mulf %activated, %up : vector<8xf32>
  template.return %result : vector<8xf32>
}

template.decl @ggml.matmul.geglu.apply_vector8(%gate: vector<8xf32>, %up: vector<8xf32>) -> (vector<8xf32>)

template.def<@ggml.matmul.geglu.apply_vector8> device @ggml_matmul_geglu_apply_vector8(%gate: vector<8xf32>, %up: vector<8xf32>) -> (vector<8xf32>) {
  %activated = vector.geluf<tanh, afn> %gate : vector<8xf32>
  %result = vector.mulf %activated, %up : vector<8xf32>
  template.return %result : vector<8xf32>
}
