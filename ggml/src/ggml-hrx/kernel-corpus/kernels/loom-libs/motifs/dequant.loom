  %q1 = vector.extract %q_bytes[1] : vector<4xi8> -> i8
  %q2 = vector.extract %q_bytes[2] : vector<4xi8> -> i8
  %q3 = vector.extract %q_bytes[3] : vector<4xi8> -> i8
  %hm0 = vector.extract %hmask_bytes[0] : vector<4xi8> -> i8
  %hm1 = vector.extract %hmask_bytes[1] : vector<4xi8> -> i8
  %hm2 = vector.extract %hmask_bytes[2] : vector<4xi8> -> i8
