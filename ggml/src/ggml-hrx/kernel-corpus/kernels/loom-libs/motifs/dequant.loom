  %c8 = index.constant 8 : index
  %c20 = index.constant 20 : index
  %c21 = index.constant 21 : index
  %c22 = index.constant 22 : index
  %c23 = index.constant 23 : index
  %c16 = index.constant 16 : index
  %bf16_format = index.constant 30 : index
  %c32 = index.constant 32 : index
  %q4_0_format = index.constant 40 : index
  %q4_1_format = index.constant 41 : index
  %q5_0_format = index.constant 50 : index
  %q5_1_format = index.constant 51 : index
  %q8_0_format = index.constant 80 : index
  %q8_1_format = index.constant 81 : index
