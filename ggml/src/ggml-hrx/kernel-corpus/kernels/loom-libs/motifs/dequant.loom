func.def inline @ggml_q5_1_f32_vector4(%weight: buffer, %row_byte_base: offset, %k: index) -> (vector<4xf32>) {
  %c0 = index.constant 0 : index
  %c1_i32 = scalar.constant 1 : i32
  %c2 = index.constant 2 : index
  %c2_i32 = scalar.constant 2 : i32
  %c4 = index.constant 4 : index
  %c16_i32 = scalar.constant 16 : i32
  %c32 = index.constant 32 : index
  %c0_i32 = scalar.constant 0 : i32
  %c4_i32 = scalar.constant 4 : i32
  %block_bytes = index.constant 24 : offset
  %qh_offset = index.constant 4 : offset
  %code_offset = index.constant 8 : offset
  %q4_mask = vector.constant 252645135 : vector<1xi32>
