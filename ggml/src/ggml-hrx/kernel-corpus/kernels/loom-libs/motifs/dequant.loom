func.def inline @ggml_q3k_value_f32(%q_byte: i8, %hmask_byte: i8, %q_shift: i32, %hmask_bit: i32, %combined_scale: f32) -> (f32) {
  %c0_i32 = scalar.constant 0 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c4_i32 = scalar.constant 4 : i32
  %q_i32 = scalar.extui %q_byte : i8 to i32
  %q_shifted = scalar.shrui %q_i32, %q_shift : i32
  %q_low = scalar.andi %q_shifted, %c3_i32 : i32
  %hmask_i32 = scalar.extui %hmask_byte : i8 to i32
  %hmask_masked = scalar.andi %hmask_i32, %hmask_bit : i32
  %has_high_bit = scalar.cmpi ne, %hmask_masked, %c0_i32 : i32
  %subtrahend = scf.select %has_high_bit, %c0_i32, %c4_i32 : i32
  %q = scalar.subi %q_low, %subtrahend : i32
  %q_f32 = scalar.sitofp %q : i32 to f32
  %value = scalar.mulf %q_f32, %combined_scale : f32
  func.return %value : f32
}

func.def inline @ggml_q3k_f32_vector4(%weight: buffer, %row_byte_base: offset, %q3_block: index, %q3_group: index, %packet: index) -> (vector<4xf32>) {
