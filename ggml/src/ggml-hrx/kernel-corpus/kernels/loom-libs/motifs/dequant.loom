  %q4_values = scf.if %is_q4 -> (vector<4xf32>) {
    %values = func.call @ggml_q4k_f32_vector4(%weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf32>)
    scf.yield %values : vector<4xf32>
  } else {
    scf.yield %zero : vector<4xf32>
  }
  %q6_values = scf.if %is_q6 -> (vector<4xf32>) {
    %values = func.call @ggml_q6k_f32_vector4(%weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf32>)
