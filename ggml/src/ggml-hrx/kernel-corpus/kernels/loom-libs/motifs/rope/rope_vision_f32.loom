func.def inline @ggml_rope_f32_pair_positions_packet(%positions: vector<2xf32>, %theta: vector<2xf32>, %freq_factors: vector<2xf32>, %x_values: vector<2xf32>, %y_values: vector<2xf32>) -> (vector<2xf32>, vector<2xf32>) {
  %inverse_two_pi = scalar.constant 0.15915494309189535 : f32
  %inverse_two_pi_vector = vector.splat %inverse_two_pi : vector<2xf32>
  %scaled_theta = vector.divf<reassoc|nnan|ninf|nsz|arcp> %theta, %freq_factors : vector<2xf32>
  %angles = vector.mulf<reassoc|nnan|ninf|nsz|contract> %positions, %scaled_theta : vector<2xf32>
  %turns = vector.mulf<reassoc|nnan|ninf|nsz|contract> %angles, %inverse_two_pi_vector : vector<2xf32>
  %cosines = vector.costurnsf<afn> %turns : vector<2xf32>
  %sines = vector.sinturnsf<afn> %turns : vector<2xf32>
  %x_cosines = vector.mulf<reassoc|nnan|ninf|nsz|contract> %x_values, %cosines : vector<2xf32>
  %y_sines = vector.mulf<reassoc|nnan|ninf|nsz|contract> %y_values, %sines : vector<2xf32>
  %x_sines = vector.mulf<reassoc|nnan|ninf|nsz|contract> %x_values, %sines : vector<2xf32>
  %y_cosines = vector.mulf<reassoc|nnan|ninf|nsz|contract> %y_values, %cosines : vector<2xf32>
  %rotated_x = vector.subf<reassoc|nnan|ninf|nsz> %x_cosines, %y_sines : vector<2xf32>
  %rotated_y = vector.addf<reassoc|nnan|ninf|nsz> %x_sines, %y_cosines : vector<2xf32>
  func.return %rotated_x, %rotated_y : vector<2xf32>, vector<2xf32>
}

func.def inline @ggml_rope_section_position_f32(%token: index, %pair: index, %token_count: index, %section0: index, %section1: index, %section2: index, %section3: index, %positions: buffer) -> (f32) {
  %section01 = index.add %section0, %section1 : index
  %section012 = index.add %section01, %section2 : index
  %section_total = index.add %section012, %section3 : index
  %sector = index.rem %pair, %section_total : index
  %in_first = index.cmp ult, %sector, %section0 : index
  %in_second = index.cmp ult, %sector, %section01 : index
  %in_third = index.cmp ult, %sector, %section012 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %position_stream2 = scf.select %in_third, %c2, %c3 : index
  %position_stream1 = scf.select %in_second, %c1, %position_stream2 : index
  %position_stream = scf.select %in_first, %c0, %position_stream1 : index
  %stream_offset = index.mul %position_stream, %token_count : index
  %position_index = index.add %stream_offset, %token : index
  %position_count = index.mul %token_count, %c3 : index
  %position_count4 = index.add %position_count, %token_count : index
  %bounded_position_index = index.assume %position_index [lt(%position_index, %position_count4)] : index
  %c0_offset = index.constant 0 : offset
  %positions_view = buffer.view %positions[%c0_offset] : buffer -> view<[%position_count4]xi32>
  %position_i32 = view.load %positions_view[%bounded_position_index] : view<[%position_count4]xi32> -> i32
  %position = scalar.sitofp %position_i32 : i32 to f32
  func.return %position : f32
}

template.decl @ggml.rope_vision_f32.body(%token_count: index, %input_span: index, %positions: buffer, %input: buffer, %theta: buffer, %freq_factors: buffer, %output: buffer)

config.decl @ggml.rope_vision_f32.head_size : %value: index where [range(%value, 4, 1024), multiple_of(%value, 4)]
config.decl @ggml.rope_vision_f32.head_count : %value: index where [range(%value, 1, 64)]
config.decl @ggml.rope_vision_f32.token_capacity : %value: index where [range(%value, 1, 16384)]
config.decl @ggml.rope_vision_f32.input_stride1 : %value: index where [range(%value, 4, 1073741824)]
config.decl @ggml.rope_vision_f32.input_stride2 : %value: index where [range(%value, 4, 1073741824)]
config.decl @ggml.rope_vision_f32.mscale : f32
config.decl @ggml.rope_vision_f32.section0 : %value: index where [range(%value, 0, 1024)]
config.decl @ggml.rope_vision_f32.section1 : %value: index where [range(%value, 0, 1024)]
config.decl @ggml.rope_vision_f32.section2 : %value: index where [range(%value, 0, 1024)]
config.decl @ggml.rope_vision_f32.section3 : %value: index where [range(%value, 0, 1024)]

template.def<@ggml.rope_vision_f32.body> device @ggml_rope_vision_f32_body(%token_count: index, %input_span: index, %positions: buffer, %input: buffer, %theta: buffer, %freq_factors: buffer, %output: buffer) {
  %token_capacity = config.get @ggml.rope_vision_f32.token_capacity : index
  %head_size = config.get @ggml.rope_vision_f32.head_size : index
  %head_count = config.get @ggml.rope_vision_f32.head_count : index
  %input_stride1 = config.get @ggml.rope_vision_f32.input_stride1 : index
  %input_stride2 = config.get @ggml.rope_vision_f32.input_stride2 : index
  %mscale = config.get @ggml.rope_vision_f32.mscale : f32
  %section0 = config.get @ggml.rope_vision_f32.section0 : index
  %section1 = config.get @ggml.rope_vision_f32.section1 : index
  %section2 = config.get @ggml.rope_vision_f32.section2 : index
  %section3 = config.get @ggml.rope_vision_f32.section3 : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 16384), le(%token_count, %token_capacity)] : index
  %bounded_input_span = index.assume %input_span [range(%input_span, 1, 1073741824)] : index
  %head = kernel.workgroup.id<x> : index
  %token = kernel.workgroup.id<y> : index
  %packet = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c0_offset = index.constant 0 : offset
  %packet_count = index.div %head_size, %c4 : index
  %pair_count = index.div %head_size, %c2 : index
  %active_token = index.cmp ult, %token, %bounded_token_count : index
  %active_packet = index.cmp ult, %packet, %packet_count : index
  %publish = scalar.andi %active_token, %active_packet : i1
  scf.if %publish {
    %pair0 = index.mul %packet, %c2 : index
    %pair1 = index.add %pair0, %c1 : index
    %position0 = func.call @ggml_rope_section_position_f32(%token, %pair0, %bounded_token_count, %section0, %section1, %section2, %section3, %positions) : (index, index, index, index, index, index, index, buffer) -> (f32)
    %position1 = func.call @ggml_rope_section_position_f32(%token, %pair1, %bounded_token_count, %section0, %section1, %section2, %section3, %positions) : (index, index, index, index, index, index, index, buffer) -> (f32)
    %position_packet = vector.from_elements %position0, %position1 : vector<2xf32>
    %theta_view = buffer.view %theta[%c0_offset] : buffer -> view<[%pair_count]xf32>
    %freq_factors_view = buffer.view %freq_factors[%c0_offset] : buffer -> view<[%pair_count]xf32>
    %theta_packet = vector.load %theta_view[%pair0] : view<[%pair_count]xf32> -> vector<2xf32>
    %freq_factors_packet = vector.load %freq_factors_view[%pair0] : view<[%pair_count]xf32> -> vector<2xf32>
    %token_offset = index.mul %token, %input_stride2 : index
    %head_offset = index.mul %head, %input_stride1 : index
    %input_base = index.add %token_offset, %head_offset : index
    %low_index0 = index.add %input_base, %pair0 : index
    %high_channel = index.add %pair0, %pair_count : index
    %high_index0 = index.add %input_base, %high_channel : index
    %low_end0 = index.add %low_index0, %c2 : index
    %high_end0 = index.add %high_index0, %c2 : index
    %low_index, %low_end = index.assume %low_index0, %low_end0 [le(%low_end0, %bounded_input_span)] : index, index
    %high_index, %high_end = index.assume %high_index0, %high_end0 [le(%high_end0, %bounded_input_span)] : index, index
    %low_view = buffer.view %input[%c0_offset] : buffer -> view<[%low_end]xf32>
    %high_view = buffer.view %input[%c0_offset] : buffer -> view<[%high_end]xf32>
    %low_values = vector.load %low_view[%low_index] : view<[%low_end]xf32> -> vector<2xf32>
    %high_values = vector.load %high_view[%high_index] : view<[%high_end]xf32> -> vector<2xf32>
    %rotated_low, %rotated_high = func.call @ggml_rope_f32_pair_positions_packet(%position_packet, %theta_packet, %freq_factors_packet, %low_values, %high_values) : (vector<2xf32>, vector<2xf32>, vector<2xf32>, vector<2xf32>, vector<2xf32>) -> (vector<2xf32>, vector<2xf32>)
    %mscale_packet = vector.splat %mscale : vector<2xf32>
    %scaled_low = vector.mulf<reassoc|nnan|ninf|nsz|contract> %rotated_low, %mscale_packet : vector<2xf32>
    %scaled_high = vector.mulf<reassoc|nnan|ninf|nsz|contract> %rotated_high, %mscale_packet : vector<2xf32>
    %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%bounded_token_count]x[%head_count]x[%head_size]xf32>
    vector.store %scaled_low, %output_view[%token, %head, %pair0] : vector<2xf32>, view<[%bounded_token_count]x[%head_count]x[%head_size]xf32>
    vector.store %scaled_high, %output_view[%token, %head, %high_channel] : vector<2xf32>, view<[%bounded_token_count]x[%head_count]x[%head_size]xf32>
  }
  template.return
}
