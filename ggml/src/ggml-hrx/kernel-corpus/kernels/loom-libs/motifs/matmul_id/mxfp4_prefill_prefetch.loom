  %ret_we02 = vector.extract %out_we[%c0, %c2] : vector<2x4xi32> -> i32
  %ret_we03 = vector.extract %out_we[%c0, %c3] : vector<2x4xi32> -> i32
  %ret_we10 = vector.extract %out_we[%c1, %c0] : vector<2x4xi32> -> i32
  %ret_we11 = vector.extract %out_we[%c1, %c1] : vector<2x4xi32> -> i32
  %ret_we12 = vector.extract %out_we[%c1, %c2] : vector<2x4xi32> -> i32
  %ret_we13 = vector.extract %out_we[%c1, %c3] : vector<2x4xi32> -> i32
