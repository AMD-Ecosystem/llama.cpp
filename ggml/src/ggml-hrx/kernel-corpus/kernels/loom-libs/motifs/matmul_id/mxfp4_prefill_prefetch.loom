func.def inline @ggml_mxfp4_decode_packet(%p: vector<4xi8>, %scale_byte: i8) -> (vector<4xi8>, vector<4xi8>, f32) {
  %exp = scalar.extui %scale_byte : i8 to i32
  %shift23 = scalar.constant 23 : i32
  %iz = scalar.constant 0 : i32
  %sub = scalar.constant 4194304 : i32
  %nan_exp = scalar.constant 255 : i32
  %nan_bits = scalar.constant 2143289344 : i32
  %bits = scalar.shli %exp, %shift23 : i32
  %is_zero = scalar.cmpi eq, %exp, %iz : i32
  %is_nan = scalar.cmpi eq, %exp, %nan_exp : i32
  %finite = scf.select %is_zero, %sub, %bits : i32
  %scale_bits = scf.select %is_nan, %nan_bits, %finite : i32
  %scale_raw = scalar.bitcast %scale_bits : i32 to f32
  %half = scalar.constant 0.5 : f32
  %scale = scalar.mulf %scale_raw, %half : f32
  %pw = vector.bitcast %p : vector<4xi8> to vector<1xi32>
  %s4 = vector.splati 4 : vector<1xi32>
  %mask = vector.splati 15 : vector<4xi8>
  %hiw = vector.shrui %pw, %s4 : vector<1xi32>
  %hib = vector.bitcast %hiw : vector<1xi32> to vector<4xi8>
  %li = vector.andi %p, %mask : vector<4xi8>
  %hi = vector.andi %hib, %mask : vector<4xi8>
  %c0 = scalar.constant 0 : i8
  %c1 = scalar.constant 1 : i8
  %c2 = scalar.constant 2 : i8
  %c3 = scalar.constant 3 : i8
  %c4 = scalar.constant 4 : i8
  %c5 = scalar.constant 6 : i8
  %c6 = scalar.constant 8 : i8
  %c7 = scalar.constant 12 : i8
  %c8 = scalar.constant 0 : i8
  %c9 = scalar.constant -1 : i8
  %c10 = scalar.constant -2 : i8
  %c11 = scalar.constant -3 : i8
  %c12 = scalar.constant -4 : i8
  %c13 = scalar.constant -6 : i8
  %c14 = scalar.constant -8 : i8
  %c15 = scalar.constant -12 : i8
  %table = vector.from_elements %c0, %c1, %c2, %c3, %c4, %c5, %c6, %c7, %c8, %c9, %c10, %c11, %c12, %c13, %c14, %c15 : vector<16xi8>
  %lv = vector.table.lookup %table[%li] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  %hv = vector.table.lookup %table[%hi] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  func.return %lv, %hv, %scale : vector<4xi8>, vector<4xi8>, f32
}

