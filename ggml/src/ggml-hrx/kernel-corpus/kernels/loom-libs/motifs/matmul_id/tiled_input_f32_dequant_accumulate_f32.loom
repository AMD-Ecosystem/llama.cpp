  %assignment_route0 = index.rem %bounded_assignment0, %bounded_route_count : index
  %assignment_token1 = index.div %bounded_assignment1, %bounded_route_count : index
  %assignment_route1 = index.rem %bounded_assignment1, %bounded_route_count : index
