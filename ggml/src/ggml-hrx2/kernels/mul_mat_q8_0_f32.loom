amdgpu.target<gfx1100> @gfx1100

func.template<hrx2.q8_0_f32.product> target(@gfx1100) priority(20) @q8_0_f32_product_gfx1100(%q: i8, %d_f16: f16, %rhs: f32) -> (f32) {
  %q_f32 = scalar.sitofp %q : i8 to f32
  %d = scalar.extf %d_f16 : f16 to f32
  %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %q_f32, %d : f32
  %product = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled, %rhs : f32
  func.return %product : f32
}

func.template<hrx2.q8_0_f32.product> priority(1) @q8_0_f32_product_fallback(%q: i8, %d_f16: f16, %rhs: f32) -> (f32) {
  %q_f32 = scalar.sitofp %q : i8 to f32
  %d = scalar.extf %d_f16 : f16 to f32
  %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %q_f32, %d : f32
  %product = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled, %rhs : f32
  func.return %product : f32
}

kernel.def target(@gfx1100) @hrx2_mul_mat_q8_0_f32(%k: index, %rows: index, %cols: index) {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %cols, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%k: index, %rows: index, %cols: index, %src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %qk = index.constant 32 : index
  %block_bytes = index.constant 34 : index
  %block_f16s = index.constant 17 : index
  %qs_offset = index.constant 2 : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %k_bounded = index.assume %k [range(%k, 32, 8192)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 8192)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 512)] : index
  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 8191)] : index
  %col0 = kernel.workgroup.id<y> : index
  %col = index.assume %col0 [range(%col0, 0, 511)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %blocks_per_row = index.div %k_bounded, %qk : index
  %total_blocks = index.mul %rows_bounded, %blocks_per_row : index
  %src0_i8_count = index.mul %total_blocks, %block_bytes : index
  %src0_f16_count = index.mul %total_blocks, %block_f16s : index
  %src1_count = index.mul %cols_bounded, %k_bounded : index
  %dst_count = index.mul %cols_bounded, %rows_bounded : index

  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src0_noalias, %src1_noalias, %dst_noalias = buffer.assume.noalias %src0_global, %src1_global, %dst_global : buffer, buffer, buffer
  %src0_i8_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_i8_count]xi8, #dense>
  %src0_f16_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_f16_count]xf16, #dense>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32, #dense>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32, #dense>

  %row_block_base = index.mul %row, %blocks_per_row : index
  %src1_col_base = index.mul %col, %k_bounded : index
  %sum = scf.for %i = [%lane to %k_bounded step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    %block = index.div %i, %qk : index
    %in_block = index.rem %i, %qk : index
    %linear_block = index.add %row_block_base, %block : index
    %block_byte_base = index.mul %linear_block, %block_bytes : index
    %q_byte_base = index.add %block_byte_base, %qs_offset : index
    %q_byte = index.add %q_byte_base, %in_block : index
    %block_f16_base = index.mul %linear_block, %block_f16s : index
    %src1_index = index.add %src1_col_base, %i : index
    %q = view.load %src0_i8_view[%q_byte] : view<[%src0_i8_count]xi8, #dense> -> i8
    %d_f16 = view.load %src0_f16_view[%block_f16_base] : view<[%src0_f16_count]xf16, #dense> -> f16
    %rhs = view.load %src1_view[%src1_index] : view<[%src1_count]xf32, #dense> -> f32
    %product = func.apply<hrx2.q8_0_f32.product>(%q, %d_f16, %rhs) : (i8, f16, f32) -> (f32)
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
    scf.yield %next : f32
  }

  %dot = kernel.workgroup.reduce<addf> %sum : f32
  %dst_col_base = index.mul %col, %rows_bounded : index
  %dst_index = index.add %dst_col_base, %row : index
  %lane_i32 = index.cast %lane : index to i32
  %zero_i32 = scalar.constant 0 : i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot, %dst_view[%dst_index] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}

check.case @hrx2_mul_mat_q8_0_f32_zero_case {
  %k = check.param.choice values([256, 512]) name("k") : index
  %rows = check.param.choice values([16, 64]) name("rows") : index
  %cols = check.param.choice values([1, 8]) name("cols") : index
  %qk = index.constant 32 : index
  %block_bytes = index.constant 34 : index
  %blocks_per_row = index.div %k, %qk : index
  %total_blocks = index.mul %rows, %blocks_per_row : index
  %src0_bytes = index.mul %total_blocks, %block_bytes : index
  %src1_count = index.mul %cols, %k : index
  %dst_count = index.mul %cols, %rows : index
  %src0 = check.generate.fill value(0) : tensor<[%src0_bytes]xi8>
  %src1 = check.generate.iota offset(-1.0) step(0.00390625) : tensor<[%src1_count]xf32>
  %dst = check.generate.fill value(1.0) : tensor<[%dst_count]xf32>
  %expected = check.generate.fill value(0.0) : tensor<[%dst_count]xf32>
  func.call @hrx2_mul_mat_q8_0_f32(%k, %rows, %cols, %src0, %src1, %dst) : (index, index, index, tensor<[%src0_bytes]xi8>, tensor<[%src1_count]xf32>, tensor<[%dst_count]xf32>)
  check.expect.close actual(%dst) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%dst_count]xf32>
  check.return
}

check.benchmark<@hrx2_mul_mat_q8_0_f32_zero_case>
check.benchmark<@hrx2_mul_mat_q8_0_f32_zero_case> @hrx2_mul_mat_q8_0_f32_decode {k = 512, rows = 64, cols = 1}
check.benchmark<@hrx2_mul_mat_q8_0_f32_zero_case> @hrx2_mul_mat_q8_0_f32_small_prefill {k = 512, rows = 64, cols = 8}
