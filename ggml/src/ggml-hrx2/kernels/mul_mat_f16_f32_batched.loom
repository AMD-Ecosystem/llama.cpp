    view.store %dot15, %dst_view[%dst1_5] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot16, %dst_view[%dst1_6] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot17, %dst_view[%dst1_7] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}

kernel.def export("hrx2_mul_mat_f16_f32_batched_cols8_contiguous") @hrx2_mul_mat_f16_f32_batched_cols8_contiguous() {
  %unit = index.constant 1 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %rows = config.get @hrx2.shape.mul_mat_f16.rows : index
  %cols = config.get @hrx2.shape.mul_mat_f16.cols : index
  %dst_ne2 = config.get @hrx2.shape.mul_mat_f16.dst_ne2 : index
  %dst_ne3 = config.get @hrx2.shape.mul_mat_f16.dst_ne3 : index
  %workgroup_size = config.get @hrx2.tuning.mul_mat_f16.workgroup_size : index
  %col_groups_round = index.add %cols, %seven : index
  %col_groups = index.div %col_groups_round, %eight : index
  %outer0 = index.mul %col_groups, %dst_ne2 : index
  %outer = index.mul %outer0, %dst_ne3 : index
  kernel.launch.config workgroups(%rows, %outer, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index

  %k = config.get @hrx2.shape.mul_mat_f16.k : index
  %rows = config.get @hrx2.shape.mul_mat_f16.rows : index
  %cols = config.get @hrx2.shape.mul_mat_f16.cols : index
  %dst_ne2 = config.get @hrx2.shape.mul_mat_f16.dst_ne2 : index
  %dst_ne3 = config.get @hrx2.shape.mul_mat_f16.dst_ne3 : index
  %src0_ne2 = config.get @hrx2.shape.mul_mat_f16.src0_ne2 : index
  %src0_ne3 = config.get @hrx2.shape.mul_mat_f16.src0_ne3 : index
  %src0_stride_row = config.get @hrx2.shape.mul_mat_f16.src0_stride_row : index
  %src0_stride_ne2 = config.get @hrx2.shape.mul_mat_f16.src0_stride_ne2 : index
  %src0_stride_ne3 = config.get @hrx2.shape.mul_mat_f16.src0_stride_ne3 : index
  %src1_stride_col = config.get @hrx2.shape.mul_mat_f16.src1_stride_col : index
  %src1_stride_ne2 = config.get @hrx2.shape.mul_mat_f16.src1_stride_ne2 : index
  %src1_stride_ne3 = config.get @hrx2.shape.mul_mat_f16.src1_stride_ne3 : index
  %workgroup_size = config.get @hrx2.tuning.mul_mat_f16.workgroup_size : index

  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 8191)] : index
  %outer0 = kernel.workgroup.id<y> : index
  %outer = index.assume %outer0 [range(%outer0, 0, 1048575)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index

  %col_groups_round = index.add %cols, %seven : index
  %col_groups = index.div %col_groups_round, %eight : index
  %col_group = index.rem %outer, %col_groups : index
  %i11 = index.mul %col_group, %eight : index
  %outer1 = index.div %outer, %col_groups : index
  %i12 = index.rem %outer1, %dst_ne2 : index
  %i13 = index.div %outer1, %dst_ne2 : index

  %src0_group_scale2 = index.div %dst_ne2, %src0_ne2 : index
  %src0_i02 = index.div %i12, %src0_group_scale2 : index
  %src0_group_scale3 = index.div %dst_ne3, %src0_ne3 : index
  %src0_i03 = index.div %i13, %src0_group_scale3 : index

  %src0_last_row_off = index.mul %rows, %src0_stride_row : index
  %src0_last_ne3 = index.sub %src0_ne3, %unit : index
  %src0_last_ne3_off = index.mul %src0_last_ne3, %src0_stride_ne3 : index
  %src0_count_base = index.add %src0_last_row_off, %src0_last_ne3_off : index
  %src0_count = index.div %src0_count_base, %two : index
  %src1_ne2_total = index.mul %dst_ne2, %src1_stride_ne2 : index
  %src1_ne3_total = index.mul %dst_ne3, %src1_stride_ne3 : index
  %src1_count_base0 = index.add %src1_ne2_total, %src1_ne3_total : index
  %src1_count_base = index.add %src1_count_base0, %k : index
  %src1_count = index.div %src1_count_base, %four : index
  %dst_rows = index.mul %rows, %dst_ne2 : index
  %dst_cols = index.mul %dst_rows, %cols : index
  %dst_count = index.mul %dst_cols, %dst_ne3 : index

  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %src0_noalias, %src1_noalias, %dst_noalias = buffer.assume.noalias %src0_global, %src1_global, %dst_global : buffer, buffer, buffer
  %src0_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_count]xf16, #dense>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32, #dense>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32, #dense>

  %src0_row_byte0 = index.mul %row, %src0_stride_row : index
  %src0_i02_byte = index.mul %src0_i02, %src0_stride_ne2 : index
  %src0_i03_byte = index.mul %src0_i03, %src0_stride_ne3 : index
  %src0_row_byte1 = index.add %src0_row_byte0, %src0_i02_byte : index
  %src0_row_byte = index.add %src0_row_byte1, %src0_i03_byte : index
  %src0_row_elem = index.div %src0_row_byte, %two : index
  %src1_col_byte0 = index.mul %i11, %src1_stride_col : index
  %src1_i12_byte = index.mul %i12, %src1_stride_ne2 : index
  %src1_i13_byte = index.mul %i13, %src1_stride_ne3 : index
  %src1_col_byte1 = index.add %src1_col_byte0, %src1_i12_byte : index
  %src1_col_byte = index.add %src1_col_byte1, %src1_i13_byte : index
  %src1_col_elem = index.div %src1_col_byte, %four : index
  %src1_stride_col_elem = index.div %src1_stride_col, %four : index

  %sum0, %sum1, %sum2, %sum3, %sum4, %sum5, %sum6, %sum7 =
    scf.for %i = [%lane to %k step %workgroup_size](
        %acc0 = %zero_f32, %acc1 = %zero_f32, %acc2 = %zero_f32, %acc3 = %zero_f32,
        %acc4 = %zero_f32, %acc5 = %zero_f32, %acc6 = %zero_f32, %acc7 = %zero_f32 :
        f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
    %src0_index = index.add %src0_row_elem, %i : index
    %a_f16 = view.load %src0_view[%src0_index] : view<[%src0_count]xf16, #dense> -> f16
    %a = scalar.extf %a_f16 : f16 to f32
    %rhs0 = index.add %src1_col_elem, %i : index
    %rhs1_col = index.add %src1_col_elem, %src1_stride_col_elem : index
    %rhs1 = index.add %rhs1_col, %i : index
    %src1_stride_col2 = index.mul %src1_stride_col_elem, %two : index
    %rhs2_col = index.add %src1_col_elem, %src1_stride_col2 : index
    %rhs2 = index.add %rhs2_col, %i : index
    %src1_stride_col3 = index.add %src1_stride_col2, %src1_stride_col_elem : index
    %rhs3_col = index.add %src1_col_elem, %src1_stride_col3 : index
    %rhs3 = index.add %rhs3_col, %i : index
    %src1_stride_col4 = index.mul %src1_stride_col_elem, %four : index
    %rhs4_col = index.add %src1_col_elem, %src1_stride_col4 : index
    %rhs4 = index.add %rhs4_col, %i : index
    %src1_stride_col5 = index.add %src1_stride_col4, %src1_stride_col_elem : index
    %rhs5_col = index.add %src1_col_elem, %src1_stride_col5 : index
    %rhs5 = index.add %rhs5_col, %i : index
    %src1_stride_col6 = index.add %src1_stride_col4, %src1_stride_col2 : index
    %rhs6_col = index.add %src1_col_elem, %src1_stride_col6 : index
    %rhs6 = index.add %rhs6_col, %i : index
    %src1_stride_col7 = index.add %src1_stride_col6, %src1_stride_col_elem : index
    %rhs7_col = index.add %src1_col_elem, %src1_stride_col7 : index
    %rhs7 = index.add %rhs7_col, %i : index

    %b0 = view.load %src1_view[%rhs0] : view<[%src1_count]xf32, #dense> -> f32
    %b1 = view.load %src1_view[%rhs1] : view<[%src1_count]xf32, #dense> -> f32
    %b2 = view.load %src1_view[%rhs2] : view<[%src1_count]xf32, #dense> -> f32
    %b3 = view.load %src1_view[%rhs3] : view<[%src1_count]xf32, #dense> -> f32
    %b4 = view.load %src1_view[%rhs4] : view<[%src1_count]xf32, #dense> -> f32
    %b5 = view.load %src1_view[%rhs5] : view<[%src1_count]xf32, #dense> -> f32
    %b6 = view.load %src1_view[%rhs6] : view<[%src1_count]xf32, #dense> -> f32
    %b7 = view.load %src1_view[%rhs7] : view<[%src1_count]xf32, #dense> -> f32
    %p0 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b0 : f32
    %p1 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b1 : f32
    %p2 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b2 : f32
    %p3 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b3 : f32
    %p4 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b4 : f32
    %p5 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b5 : f32
    %p6 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b6 : f32
    %p7 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b7 : f32
    %next0 = scalar.addf<reassoc|nnan|ninf|nsz> %acc0, %p0 : f32
    %next1 = scalar.addf<reassoc|nnan|ninf|nsz> %acc1, %p1 : f32
    %next2 = scalar.addf<reassoc|nnan|ninf|nsz> %acc2, %p2 : f32
    %next3 = scalar.addf<reassoc|nnan|ninf|nsz> %acc3, %p3 : f32
    %next4 = scalar.addf<reassoc|nnan|ninf|nsz> %acc4, %p4 : f32
    %next5 = scalar.addf<reassoc|nnan|ninf|nsz> %acc5, %p5 : f32
    %next6 = scalar.addf<reassoc|nnan|ninf|nsz> %acc6, %p6 : f32
    %next7 = scalar.addf<reassoc|nnan|ninf|nsz> %acc7, %p7 : f32
    scf.yield %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7 :
        f32, f32, f32, f32, f32, f32, f32, f32
  }
  %dot0 = kernel.workgroup.reduce<addf> %sum0 : f32
  %dot1 = kernel.workgroup.reduce<addf> %sum1 : f32
  %dot2 = kernel.workgroup.reduce<addf> %sum2 : f32
  %dot3 = kernel.workgroup.reduce<addf> %sum3 : f32
  %dot4 = kernel.workgroup.reduce<addf> %sum4 : f32
  %dot5 = kernel.workgroup.reduce<addf> %sum5 : f32
  %dot6 = kernel.workgroup.reduce<addf> %sum6 : f32
  %dot7 = kernel.workgroup.reduce<addf> %sum7 : f32

  %head_row_base = index.mul %i12, %rows : index
  %dst_row = index.add %head_row_base, %row : index
  %dst_col_base = index.mul %i11, %dst_rows : index
  %dst_ne3_stride = index.mul %dst_rows, %cols : index
  %dst_ne3_base = index.mul %i13, %dst_ne3_stride : index
  %dst_base0 = index.add %dst_ne3_base, %dst_col_base : index
  %dst_index = index.add %dst_base0, %dst_row : index
  %dst1 = index.add %dst_index, %dst_rows : index
  %dst_stride_col2 = index.mul %dst_rows, %two : index
  %dst2 = index.add %dst_index, %dst_stride_col2 : index
  %dst_stride_col3 = index.add %dst_stride_col2, %dst_rows : index
  %dst3 = index.add %dst_index, %dst_stride_col3 : index
  %dst_stride_col4 = index.mul %dst_rows, %four : index
  %dst4 = index.add %dst_index, %dst_stride_col4 : index
  %dst_stride_col5 = index.add %dst_stride_col4, %dst_rows : index
  %dst5 = index.add %dst_index, %dst_stride_col5 : index
  %dst_stride_col6 = index.add %dst_stride_col4, %dst_stride_col2 : index
  %dst6 = index.add %dst_index, %dst_stride_col6 : index
  %dst_stride_col7 = index.add %dst_stride_col6, %dst_rows : index
  %dst7 = index.add %dst_index, %dst_stride_col7 : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot0, %dst_view[%dst_index] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot1, %dst_view[%dst1] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot2, %dst_view[%dst2] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot3, %dst_view[%dst3] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot4, %dst_view[%dst4] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot5, %dst_view[%dst5] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot6, %dst_view[%dst6] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot7, %dst_view[%dst7] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}
