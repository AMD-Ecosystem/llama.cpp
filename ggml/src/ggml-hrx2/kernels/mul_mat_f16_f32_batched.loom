  %src1_i12_byte = index.mul %i12, %src1_stride_ne2 : index
  %src1_i13_byte = index.mul %i13, %src1_stride_ne3 : index
  %src1_col_byte1 = index.add %src1_col_byte0, %src1_i12_byte : index
  %src1_col_byte = index.add %src1_col_byte1, %src1_i13_byte : index
  %src1_col_elem = index.div %src1_col_byte, %four : index
  %sum = scf.for %i = [%lane to %k step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
