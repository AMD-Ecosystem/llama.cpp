    %min = scalar.mulf<reassoc|nnan|ninf|nsz> %dmin0, %min_f32 : f32
    %next0, %next1, %next2, %next3 = scf.for %j = [%zero_index to %four step %one](%inner0 = %acc0 : f32, %inner1 = %acc1 : f32, %inner2 = %acc2 : f32, %inner3 = %acc3 : f32) -> (f32, f32, f32, f32) {
      %q_index = index.add %qs_base, %j : index
      %src_offset = index.add %src_base, %j : index
      %src1_index0 = index.add %src1_col_base0, %src_offset : index
      %src1_index1 = index.add %src1_col_base1, %src_offset : index
      %src1_index2 = index.add %src1_col_base2, %src_offset : index
      %src1_index3 = index.add %src1_col_base3, %src_offset : index
