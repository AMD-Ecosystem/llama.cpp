    %q1_byte = vector.extract %q1_byte_vec[0] : vector<1xi32> -> i32
    %q2_byte = vector.extract %q2_byte_vec[0] : vector<1xi32> -> i32
    %q3_byte = vector.extract %q3_byte_vec[0] : vector<1xi32> -> i32
    %q0_i32, %q1_i32, %q2_i32, %q3_i32 = scf.if %is_high_group -> (i32, i32, i32, i32) {
      %hi0 = scalar.shrui %q0_byte, %four_i32 : i32
      %hi1 = scalar.shrui %q1_byte, %four_i32 : i32
      %hi2 = scalar.shrui %q2_byte, %four_i32 : i32
      %hi3 = scalar.shrui %q3_byte, %four_i32 : i32
      scf.yield %hi0, %hi1, %hi2, %hi3 : i32, i32, i32, i32
    } else {
      %lo0 = scalar.andi %q0_byte, %mask_0f : i32
      %lo1 = scalar.andi %q1_byte, %mask_0f : i32
      %lo2 = scalar.andi %q2_byte, %mask_0f : i32
      %lo3 = scalar.andi %q3_byte, %mask_0f : i32
      scf.yield %lo0, %lo1, %lo2, %lo3 : i32, i32, i32, i32
    }
    %q0_i8 = scalar.trunci %q0_i32 : i32 to i8
    %q1_i8 = scalar.trunci %q1_i32 : i32 to i8
    %q2_i8 = scalar.trunci %q2_i32 : i32 to i8
    %q3_i8 = scalar.trunci %q3_i32 : i32 to i8
    %q4_vec = vector.from_elements %q0_i8, %q1_i8, %q2_i8, %q3_i8 : vector<4xi8>

    %q8_block_in_col0 = index.mul %block_idx, %eight : index
    %q8_block_in_col = index.add %q8_block_in_col0, %group : index
    %q8_linear_block = index.add %src1_col_base, %q8_block_in_col : index
    %q8_byte_base = index.mul %q8_linear_block, %q8_block_bytes : index
    %q8_f16_base = index.mul %q8_linear_block, %q8_block_f16s : index
    %q8_s_index = index.add %q8_f16_base, %one : index
    %q8_qs_payload = index.add %q8_byte_base, %q8_payload : index
    %q8_qs_index = index.add %q8_qs_payload, %lane_q : index
    %q8_vec = vector.load %src1_i8_view[%q8_qs_index] : view<[%src1_i8_count]xi8, #dense> -> vector<4xi8>
    %q8_d_f16 = view.load %src1_f16_view[%q8_f16_base] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_s_f16 = view.load %src1_f16_view[%q8_s_index] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_d = scalar.extf %q8_d_f16 : f16 to f32
    %q8_sum = scalar.extf %q8_s_f16 : f16 to f32
    %dot_vec = vector.dot4i<s8s8> %q4_vec, %q8_vec, %zero_i32v : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %dot_i32 = vector.extract %dot_vec[0] : vector<1xi32> -> i32
    %dot_f32 = scalar.sitofp %dot_i32 : i32 to f32
    %scaled0 = scalar.mulf<reassoc|nnan|ninf|nsz> %dot_f32, %d : f32
    %scaled1 = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled0, %q8_d : f32
    %lane_q_i32 = index.cast %lane_q : index to i32
    %lane_q_zero = scalar.cmpi eq, %lane_q_i32, %zero_i32 : i32
    %corrected = scf.if %lane_q_zero -> (f32) {
      %min_sum = scalar.mulf<reassoc|nnan|ninf|nsz> %min, %q8_sum : f32
      %value = scalar.subf<reassoc|nnan|ninf|nsz> %scaled1, %min_sum : f32
      scf.yield %value : f32
    } else {
      scf.yield %scaled1 : f32
    }
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %corrected : f32
    scf.yield %next : f32
  }

  %dot = kernel.workgroup.reduce<addf> %sum : f32
  %dst_col_base = index.mul %col, %rows_bounded : index
  %dst_index = index.add %dst_col_base, %row : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot, %dst_view[%dst_index] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}

