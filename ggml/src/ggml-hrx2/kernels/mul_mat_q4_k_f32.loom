      %q_f32 = scalar.uitofp %q_i32 : i32 to f32
      %rhs0 = view.load %src1_view[%src1_index0] : view<[%src1_count]xf32, #dense> -> f32
      %rhs1 = scf.if %col1_in_bounds -> (f32) {
        %value = view.load %src1_view[%src1_index1] : view<[%src1_count]xf32, #dense> -> f32
        scf.yield %value : f32
      } else {
        scf.yield %zero_f32 : f32
      }
      %rhs2 = scf.if %col2_in_bounds -> (f32) {
        %value = view.load %src1_view[%src1_index2] : view<[%src1_count]xf32, #dense> -> f32
