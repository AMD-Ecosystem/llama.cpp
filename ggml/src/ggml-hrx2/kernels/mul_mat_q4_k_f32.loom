    view.store %dot0, %dst_view[%dst_index0] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot1, %dst_view[%dst_index1] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot2, %dst_view[%dst_index2] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot3, %dst_view[%dst_index3] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot4, %dst_view[%dst_index4] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot5, %dst_view[%dst_index5] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot6, %dst_view[%dst_index6] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot7, %dst_view[%dst_index7] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}
