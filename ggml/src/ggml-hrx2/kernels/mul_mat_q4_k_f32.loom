      %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %d, %q_f32 : f32
      %dequant = scalar.subf<reassoc|nnan|ninf|nsz> %scaled, %min : f32
      %product0 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs0 : f32
      %product1 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs1 : f32
      %product2 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs2 : f32
      %product3 = scalar.mulf<reassoc|nnan|ninf|nsz> %dequant, %rhs3 : f32
      %acc_next0 = scalar.addf<reassoc|nnan|ninf|nsz> %inner0, %product0 : f32
      %acc_next1 = scalar.addf<reassoc|nnan|ninf|nsz> %inner1, %product1 : f32
