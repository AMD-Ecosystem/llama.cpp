    %q2_word_view = buffer.view %src0_noalias[%q2_offset] : buffer -> view<1xi32, #dense>
    %q3_word_view = buffer.view %src0_noalias[%q3_offset] : buffer -> view<1xi32, #dense>
    %q0_word = vector.load %q0_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %q1_word = vector.load %q1_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %q2_word = vector.load %q2_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %q3_word = vector.load %q3_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %q0_byte_vec = vector.bitfield.extractu %q0_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
    %q1_byte_vec = vector.bitfield.extractu %q1_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
    %q2_byte_vec = vector.bitfield.extractu %q2_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
    %q3_byte_vec = vector.bitfield.extractu %q3_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
