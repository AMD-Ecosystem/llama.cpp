    %q2_byte = vector.extract %q2_byte_vec[0] : vector<1xi32> -> i32
    %q3_byte = vector.extract %q3_byte_vec[0] : vector<1xi32> -> i32
    %q0_low, %q1_low, %q2_low, %q3_low = scf.if %is_high_group -> (i32, i32, i32, i32) {
      %hi0 = scalar.shrui %q0_byte, %four_i32 : i32
      %hi1 = scalar.shrui %q1_byte, %four_i32 : i32
      %hi2 = scalar.shrui %q2_byte, %four_i32 : i32
      %hi3 = scalar.shrui %q3_byte, %four_i32 : i32
      %lo0 = scalar.andi %hi0, %mask_0f : i32
      %lo1 = scalar.andi %hi1, %mask_0f : i32
      %lo2 = scalar.andi %hi2, %mask_0f : i32
      %lo3 = scalar.andi %hi3, %mask_0f : i32
      scf.yield %lo0, %lo1, %lo2, %lo3 : i32, i32, i32, i32
    } else {
      %lo0 = scalar.andi %q0_byte, %mask_0f : i32
      %lo1 = scalar.andi %q1_byte, %mask_0f : i32
      %lo2 = scalar.andi %q2_byte, %mask_0f : i32
      %lo3 = scalar.andi %q3_byte, %mask_0f : i32
      scf.yield %lo0, %lo1, %lo2, %lo3 : i32, i32, i32, i32
    }
    %qh_payload = index.add %block_byte_base, %qh_offset : index
    %qh0_index = index.add %qh_payload, %lane_q : index
    %qh1_index = index.add %qh0_index, %one : index
    %qh2_index = index.add %qh0_index, %two : index
    %qh3_index = index.add %qh0_index, %three : index
    %qh0_offset = index.cast %qh0_index : index to offset
    %qh1_offset = index.cast %qh1_index : index to offset
    %qh2_offset = index.cast %qh2_index : index to offset
    %qh3_offset = index.cast %qh3_index : index to offset
    %qh0_word_view = buffer.view %src0_noalias[%qh0_offset] : buffer -> view<1xi32, #dense>
    %qh1_word_view = buffer.view %src0_noalias[%qh1_offset] : buffer -> view<1xi32, #dense>
    %qh2_word_view = buffer.view %src0_noalias[%qh2_offset] : buffer -> view<1xi32, #dense>
    %qh3_word_view = buffer.view %src0_noalias[%qh3_offset] : buffer -> view<1xi32, #dense>
    %qh0_word = vector.load %qh0_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %qh1_word = vector.load %qh1_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %qh2_word = vector.load %qh2_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %qh3_word = vector.load %qh3_word_view[%zero_index] : view<1xi32, #dense> -> vector<1xi32>
    %qh0_byte_vec = vector.bitfield.extractu %qh0_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
    %qh1_byte_vec = vector.bitfield.extractu %qh1_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
    %qh2_byte_vec = vector.bitfield.extractu %qh2_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
    %qh3_byte_vec = vector.bitfield.extractu %qh3_word {offset = 0, width = 8} : vector<1xi32> -> vector<1xi32>
    %qh0_byte = vector.extract %qh0_byte_vec[0] : vector<1xi32> -> i32
    %qh1_byte = vector.extract %qh1_byte_vec[0] : vector<1xi32> -> i32
    %qh2_byte = vector.extract %qh2_byte_vec[0] : vector<1xi32> -> i32
    %qh3_byte = vector.extract %qh3_byte_vec[0] : vector<1xi32> -> i32
    %group_i32 = index.cast %group : index to i32
    %qh0_shifted = scalar.shrui %qh0_byte, %group_i32 : i32
    %qh1_shifted = scalar.shrui %qh1_byte, %group_i32 : i32
    %qh2_shifted = scalar.shrui %qh2_byte, %group_i32 : i32
    %qh3_shifted = scalar.shrui %qh3_byte, %group_i32 : i32
    %qh0_bit = scalar.andi %qh0_shifted, %one_i32 : i32
    %qh1_bit = scalar.andi %qh1_shifted, %one_i32 : i32
    %qh2_bit = scalar.andi %qh2_shifted, %one_i32 : i32
    %qh3_bit = scalar.andi %qh3_shifted, %one_i32 : i32
    %q0_high = scalar.shli %qh0_bit, %four_i32 : i32
    %q1_high = scalar.shli %qh1_bit, %four_i32 : i32
    %q2_high = scalar.shli %qh2_bit, %four_i32 : i32
    %q3_high = scalar.shli %qh3_bit, %four_i32 : i32
    %q0_i32 = scalar.ori %q0_low, %q0_high : i32
    %q1_i32 = scalar.ori %q1_low, %q1_high : i32
    %q2_i32 = scalar.ori %q2_low, %q2_high : i32
    %q3_i32 = scalar.ori %q3_low, %q3_high : i32
    %q0_i8 = scalar.trunci %q0_i32 : i32 to i8
    %q1_i8 = scalar.trunci %q1_i32 : i32 to i8
    %q2_i8 = scalar.trunci %q2_i32 : i32 to i8
    %q3_i8 = scalar.trunci %q3_i32 : i32 to i8
    %q4_vec = vector.from_elements %q0_i8, %q1_i8, %q2_i8, %q3_i8 : vector<4xi8>

    %q8_block_in_col0 = index.mul %block_idx, %eight : index
    %q8_block_in_col = index.add %q8_block_in_col0, %group : index
    %q8_linear_block0 = index.add %src1_col_base0, %q8_block_in_col : index
    %q8_linear_block1 = index.add %src1_col_base1, %q8_block_in_col : index
    %q8_linear_block2 = index.add %src1_col_base2, %q8_block_in_col : index
    %q8_linear_block3 = index.add %src1_col_base3, %q8_block_in_col : index
    %q8_x4_block0 = index.div %q8_linear_block0, %four : index
    %q8_x4_block1 = index.div %q8_linear_block1, %four : index
    %q8_x4_block2 = index.div %q8_linear_block2, %four : index
    %q8_x4_block3 = index.div %q8_linear_block3, %four : index
    %q8_inner0 = index.rem %q8_linear_block0, %four : index
    %q8_inner1 = index.rem %q8_linear_block1, %four : index
    %q8_inner2 = index.rem %q8_linear_block2, %four : index
    %q8_inner3 = index.rem %q8_linear_block3, %four : index
    %q8_byte_base0 = index.mul %q8_x4_block0, %q8_block_bytes : index
    %q8_byte_base1 = index.mul %q8_x4_block1, %q8_block_bytes : index
    %q8_byte_base2 = index.mul %q8_x4_block2, %q8_block_bytes : index
    %q8_byte_base3 = index.mul %q8_x4_block3, %q8_block_bytes : index
    %q8_f16_group_base0 = index.mul %q8_x4_block0, %q8_block_f16s : index
    %q8_f16_group_base1 = index.mul %q8_x4_block1, %q8_block_f16s : index
    %q8_f16_group_base2 = index.mul %q8_x4_block2, %q8_block_f16s : index
    %q8_f16_group_base3 = index.mul %q8_x4_block3, %q8_block_f16s : index
    %q8_inner_f16_offset0 = index.mul %q8_inner0, %two : index
    %q8_inner_f16_offset1 = index.mul %q8_inner1, %two : index
    %q8_inner_f16_offset2 = index.mul %q8_inner2, %two : index
    %q8_inner_f16_offset3 = index.mul %q8_inner3, %two : index
    %q8_f16_base0 = index.add %q8_f16_group_base0, %q8_inner_f16_offset0 : index
    %q8_f16_base1 = index.add %q8_f16_group_base1, %q8_inner_f16_offset1 : index
    %q8_f16_base2 = index.add %q8_f16_group_base2, %q8_inner_f16_offset2 : index
    %q8_f16_base3 = index.add %q8_f16_group_base3, %q8_inner_f16_offset3 : index
    %q8_s_index0 = index.add %q8_f16_base0, %one : index
    %q8_s_index1 = index.add %q8_f16_base1, %one : index
    %q8_s_index2 = index.add %q8_f16_base2, %one : index
    %q8_s_index3 = index.add %q8_f16_base3, %one : index
    %q8_qs_base0 = index.add %q8_byte_base0, %q8_payload : index
    %q8_qs_base1 = index.add %q8_byte_base1, %q8_payload : index
    %q8_qs_base2 = index.add %q8_byte_base2, %q8_payload : index
    %q8_qs_base3 = index.add %q8_byte_base3, %q8_payload : index
    %q8_inner_qs_offset0 = index.mul %q8_inner0, %thirtytwo : index
    %q8_inner_qs_offset1 = index.mul %q8_inner1, %thirtytwo : index
    %q8_inner_qs_offset2 = index.mul %q8_inner2, %thirtytwo : index
    %q8_inner_qs_offset3 = index.mul %q8_inner3, %thirtytwo : index
    %q8_qs_payload0 = index.add %q8_qs_base0, %q8_inner_qs_offset0 : index
    %q8_qs_payload1 = index.add %q8_qs_base1, %q8_inner_qs_offset1 : index
    %q8_qs_payload2 = index.add %q8_qs_base2, %q8_inner_qs_offset2 : index
    %q8_qs_payload3 = index.add %q8_qs_base3, %q8_inner_qs_offset3 : index
    %q8_qs_index0 = index.add %q8_qs_payload0, %lane_q : index
    %q8_qs_index1 = index.add %q8_qs_payload1, %lane_q : index
    %q8_qs_index2 = index.add %q8_qs_payload2, %lane_q : index
    %q8_qs_index3 = index.add %q8_qs_payload3, %lane_q : index
    %q8_vec0 = vector.load %src1_i8_view[%q8_qs_index0] : view<[%src1_i8_count]xi8, #dense> -> vector<4xi8>
    %q8_vec1 = vector.load %src1_i8_view[%q8_qs_index1] : view<[%src1_i8_count]xi8, #dense> -> vector<4xi8>
    %q8_vec2 = vector.load %src1_i8_view[%q8_qs_index2] : view<[%src1_i8_count]xi8, #dense> -> vector<4xi8>
    %q8_vec3 = vector.load %src1_i8_view[%q8_qs_index3] : view<[%src1_i8_count]xi8, #dense> -> vector<4xi8>
    %q8_d_f16_0 = view.load %src1_f16_view[%q8_f16_base0] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_d_f16_1 = view.load %src1_f16_view[%q8_f16_base1] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_d_f16_2 = view.load %src1_f16_view[%q8_f16_base2] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_d_f16_3 = view.load %src1_f16_view[%q8_f16_base3] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_s_f16_0 = view.load %src1_f16_view[%q8_s_index0] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_s_f16_1 = view.load %src1_f16_view[%q8_s_index1] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_s_f16_2 = view.load %src1_f16_view[%q8_s_index2] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_s_f16_3 = view.load %src1_f16_view[%q8_s_index3] : view<[%src1_f16_count]xf16, #dense> -> f16
    %q8_d0 = scalar.extf %q8_d_f16_0 : f16 to f32
    %q8_d1 = scalar.extf %q8_d_f16_1 : f16 to f32
    %q8_d2 = scalar.extf %q8_d_f16_2 : f16 to f32
    %q8_d3 = scalar.extf %q8_d_f16_3 : f16 to f32
    %q8_sum0 = scalar.extf %q8_s_f16_0 : f16 to f32
    %q8_sum1 = scalar.extf %q8_s_f16_1 : f16 to f32
    %q8_sum2 = scalar.extf %q8_s_f16_2 : f16 to f32
    %q8_sum3 = scalar.extf %q8_s_f16_3 : f16 to f32
    %dot_vec0 = vector.dot4i<u8s8> %q4_vec, %q8_vec0, %zero_i32v : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %dot_vec1 = vector.dot4i<u8s8> %q4_vec, %q8_vec1, %zero_i32v : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %dot_vec2 = vector.dot4i<u8s8> %q4_vec, %q8_vec2, %zero_i32v : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %dot_vec3 = vector.dot4i<u8s8> %q4_vec, %q8_vec3, %zero_i32v : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %dot_i32_0 = vector.extract %dot_vec0[0] : vector<1xi32> -> i32
    %dot_i32_1 = vector.extract %dot_vec1[0] : vector<1xi32> -> i32
    %dot_i32_2 = vector.extract %dot_vec2[0] : vector<1xi32> -> i32
    %dot_i32_3 = vector.extract %dot_vec3[0] : vector<1xi32> -> i32
    %dot_f32_0 = scalar.sitofp %dot_i32_0 : i32 to f32
    %dot_f32_1 = scalar.sitofp %dot_i32_1 : i32 to f32
    %dot_f32_2 = scalar.sitofp %dot_i32_2 : i32 to f32
    %dot_f32_3 = scalar.sitofp %dot_i32_3 : i32 to f32
    %scaled0a = scalar.mulf<reassoc|nnan|ninf|nsz> %dot_f32_0, %d : f32
    %scaled1a = scalar.mulf<reassoc|nnan|ninf|nsz> %dot_f32_1, %d : f32
    %scaled2a = scalar.mulf<reassoc|nnan|ninf|nsz> %dot_f32_2, %d : f32
    %scaled3a = scalar.mulf<reassoc|nnan|ninf|nsz> %dot_f32_3, %d : f32
    %scaled0b = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled0a, %q8_d0 : f32
    %scaled1b = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled1a, %q8_d1 : f32
    %scaled2b = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled2a, %q8_d2 : f32
    %scaled3b = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled3a, %q8_d3 : f32
    %lane_q_i32 = index.cast %lane_q : index to i32
    %lane_q_zero = scalar.cmpi eq, %lane_q_i32, %zero_i32 : i32
    %corr0, %corr1, %corr2, %corr3 = scf.if %lane_q_zero -> (f32, f32, f32, f32) {
      %min_sum0 = scalar.mulf<reassoc|nnan|ninf|nsz> %min, %q8_sum0 : f32
      %min_sum1 = scalar.mulf<reassoc|nnan|ninf|nsz> %min, %q8_sum1 : f32
      %min_sum2 = scalar.mulf<reassoc|nnan|ninf|nsz> %min, %q8_sum2 : f32
      %min_sum3 = scalar.mulf<reassoc|nnan|ninf|nsz> %min, %q8_sum3 : f32
      %value0 = scalar.subf<reassoc|nnan|ninf|nsz> %scaled0b, %min_sum0 : f32
      %value1 = scalar.subf<reassoc|nnan|ninf|nsz> %scaled1b, %min_sum1 : f32
      %value2 = scalar.subf<reassoc|nnan|ninf|nsz> %scaled2b, %min_sum2 : f32
      %value3 = scalar.subf<reassoc|nnan|ninf|nsz> %scaled3b, %min_sum3 : f32
      scf.yield %value0, %value1, %value2, %value3 : f32, f32, f32, f32
    } else {
      scf.yield %scaled0b, %scaled1b, %scaled2b, %scaled3b : f32, f32, f32, f32
    }
    %next0 = scalar.addf<reassoc|nnan|ninf|nsz> %acc0, %corr0 : f32
    %next1 = scalar.addf<reassoc|nnan|ninf|nsz> %acc1, %corr1 : f32
    %next2 = scalar.addf<reassoc|nnan|ninf|nsz> %acc2, %corr2 : f32
    %next3 = scalar.addf<reassoc|nnan|ninf|nsz> %acc3, %corr3 : f32
    scf.yield %next0, %next1, %next2, %next3 : f32, f32, f32, f32
  }

  %dot0 = kernel.workgroup.reduce<addf> %sum0 : f32
  %dot1 = kernel.workgroup.reduce<addf> %sum1 : f32
  %dot2 = kernel.workgroup.reduce<addf> %sum2 : f32
  %dot3 = kernel.workgroup.reduce<addf> %sum3 : f32
  %dst_col_base0 = index.mul %col0, %rows_bounded : index
  %dst_col_base1 = index.mul %col1, %rows_bounded : index
  %dst_col_base2 = index.mul %col2, %rows_bounded : index
  %dst_col_base3 = index.mul %col3, %rows_bounded : index
  %dst_index0 = index.add %dst_col_base0, %row : index
  %dst_index1 = index.add %dst_col_base1, %row : index
  %dst_index2 = index.add %dst_col_base2, %row : index
  %dst_index3 = index.add %dst_col_base3, %row : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot0, %dst_view[%dst_index0] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot1, %dst_view[%dst_index1] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot2, %dst_view[%dst_index2] : f32, view<[%dst_count]xf32, #dense>
    view.store %dot3, %dst_view[%dst_index3] : f32, view<[%dst_count]xf32, #dense>
  }
  kernel.return
}
